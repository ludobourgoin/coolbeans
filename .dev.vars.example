# Secrets du portail client, en local uniquement.
#
# Copier en `.dev.vars` (ignoré par git) et remplir. `wrangler dev` les injecte
# dans env ; `astro dev` continue de lire `.env` pour les clés Clerk/Resend.
#
# En staging et en production, ces valeurs sont posées comme secrets du Worker
# (`npx wrangler secret put <NOM>`, avec `--env staging` pour l'autre
# environnement). Elles ne doivent jamais apparaître dans le repo ni dans
# wrangler.jsonc.
#
# Clé API Linear personnelle (workspace coolbeans-hq, Settings > Security &
# access > Personal API keys) : /api/support crée les tickets avec (COO-30).
LINEAR_API_KEY=

# Secret de signature du webhook Linear (Settings > API > Webhooks) :
# vérification HMAC-SHA256 dans /api/linear-webhook.
LINEAR_WEBHOOK_SECRET=

# Clé API Resend (send.coolbeans.cc) : envoi des emails transactionnels de la
# messagerie (accusés, notifications à Ludo, réponses publiées) via publier.ts,
# nouveau.ts et reponse.ts.
RESEND_API_KEY=

# Secret de signature de Better Auth : sessions et jetons (liens magiques,
# invitations, réinitialisation). Générer une valeur AU HASARD, différente par
# environnement — partager la même rendrait une session de staging valable en
# production :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
