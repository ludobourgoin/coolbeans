// Config Worker du site Coolbeans (adapter @astrojs/cloudflare, cible WORKERS).
// Déploiement : Cloudflare Workers Builds (Git) — main -> production,
// staging -> environnement `staging`. Voir docs/superpowers/specs/2026-08-04-deploy-workers-migration-design.md
// `nodejs_compat` est requis par @clerk/astro (node:async_hooks, node:fs).
{
  "name": "coolbeans",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  // Point d'entrée custom : réécriture par hostname (portail sur my.*) avant
  // le handler Astro — voir src/worker.ts.
  "main": "./src/worker.ts",
  // Sans run_worker_first, la couche assets sert les pages prérendues avant
  // même d'invoquer le Worker : sur my.coolbeans.cc, `/` renverrait la home
  // marketing au lieu du portail. On force le Worker en premier pour les
  // pages, mais pas pour les fichiers statiques (fingerprintés ou de public/).
  "assets": {
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/img/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/apple-touch-icon.png"
    ]
  },
  "routes": [
    { "pattern": "coolbeans.cc", "custom_domain": true },
    { "pattern": "www.coolbeans.cc", "custom_domain": true },
    { "pattern": "my.coolbeans.cc", "custom_domain": true }
  ],
  // Sync horaire du portail : 1 cron sur les 5 du plan gratuit.
  // `triggers` est une clé héritable — l'environnement staging reprend donc
  // ce cron, et alimente son propre PORTAL_KV. Voir le handler `scheduled`
  // dans src/worker.ts et le budget dans
  // docs/superpowers/specs/2026-08-11-portail-cpu-scheduled.md.
  "triggers": { "crons": ["0 * * * *"] },
  "kv_namespaces": [{ "binding": "PORTAL_KV", "id": "f720076d62fc4fd28422209c16326776" }],
  // GID du workspace Asana : public, pas un secret. Les secrets du portail
  // (ASANA_PAT, ADMIN_SYNC_SECRET) se posent par `wrangler secret put`, jamais ici.
  // `vars` et `kv_namespaces` ne sont PAS hérités par les environnements nommés
  // (contrairement à `triggers`, `assets` et `routes`) : d'où la duplication.
  "vars": { "ASANA_WORKSPACE_GID": "1201457508335146" },
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.coolbeans.cc", "custom_domain": true },
        { "pattern": "my-staging.coolbeans.cc", "custom_domain": true }
      ],
      "kv_namespaces": [{ "binding": "PORTAL_KV", "id": "684d2093bab2413bb840bdc6443f6f50" }],
      "vars": { "ASANA_WORKSPACE_GID": "1201457508335146" }
    }
  }
}
