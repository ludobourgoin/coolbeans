// Config Worker du site Coolbeans (adapter @astrojs/cloudflare, cible WORKERS).
// Déploiement : Cloudflare Workers Builds (Git) — main -> production,
// staging -> environnement `staging`. Voir docs/superpowers/specs/2026-08-04-deploy-workers-migration-design.md
// `nodejs_compat` est requis par @clerk/astro (node:async_hooks, node:fs).
{
  "name": "coolbeans",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  // Point d'entrée custom : réécriture par hostname (portail sur my.*) avant
  // le handler Astro — voir src/worker.ts.
  "main": "./src/worker.ts",
  // Sans run_worker_first, la couche assets sert les pages prérendues avant
  // même d'invoquer le Worker : sur my.coolbeans.cc, `/` renverrait la home
  // marketing au lieu du portail. On force le Worker en premier pour les
  // pages, mais pas pour les fichiers statiques (fingerprintés ou de public/).
  "assets": {
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/img/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/apple-touch-icon.png",
      // Sans ces deux exclusions, le manifest et ses icônes passeraient par le
      // Worker, qui les réécrirait en /espace/... sur my.* — donc 404, et une
      // installation A2HS sans icône. Ce sont des fichiers publics : les
      // laisser à la couche assets est aussi ce qui les garde hors de Clerk,
      // le manifest étant récupéré sans cookie de session.
      "!/manifest.webmanifest",
      "!/icons/*"
    ]
  },
  "routes": [
    { "pattern": "coolbeans.cc", "custom_domain": true },
    { "pattern": "www.coolbeans.cc", "custom_domain": true },
    { "pattern": "my.coolbeans.cc", "custom_domain": true }
  ],
  // Cron du portail, toutes les 5 minutes. Le sync qu'il déclenchait (Asana,
  // sprint S1) a été retiré : le handler `scheduled` de src/worker.ts est
  // redevenu un no-op qui trace son passage, en attendant le sync Linear.
  //
  // Le trigger est conservé plutôt que supprimé : c'est le point d'accroche du
  // futur sync, et un no-op toutes les 5 minutes ne coûte rien. La cadence sera
  // à réévaluer quand le sync réel reviendra — les écritures KV, elles, ont un
  // plafond de 1 000/jour sur le plan gratuit.
  //
  // `triggers` est une clé héritable : l'environnement staging reprend ce cron.
  // Un seul trigger, donc 1 sur les 5 par COMPTE du plan gratuit (prod +
  // staging en consomment déjà 2).
  "triggers": { "crons": ["*/5 * * * *"] },
  // `kv_namespaces` n'est PAS hérité par les environnements nommés
  // (contrairement à `triggers`, `assets` et `routes`) : d'où la duplication.
  // PORTAL_KV sert aussi au module chiffrage/devis — ne pas retirer ce binding.
  "kv_namespaces": [{ "binding": "PORTAL_KV", "id": "f720076d62fc4fd28422209c16326776" }],
  // Messagerie du portail : D1 pour les tickets + le journal publié (spec
  // 2026-08-15-messagerie-portail-design.md §4). Le bucket R2 des pièces
  // jointes viendra dans une tâche ultérieure, une fois R2 activé sur le
  // compte. Comme kv_namespaces, cette clé n'est PAS héritée par les
  // environnements nommés : duplication obligatoire dans env.staging.
  "d1_databases": [
    { "binding": "PORTAL_DB", "database_name": "coolbeans-portal", "database_id": "5c5a4d6a-2174-404f-a5e0-2137c40fa45b" }
  ],
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.coolbeans.cc", "custom_domain": true },
        { "pattern": "my-staging.coolbeans.cc", "custom_domain": true }
      ],
      "kv_namespaces": [{ "binding": "PORTAL_KV", "id": "684d2093bab2413bb840bdc6443f6f50" }],
      "d1_databases": [
        { "binding": "PORTAL_DB", "database_name": "coolbeans-portal-staging", "database_id": "4d66b69a-effd-46eb-ba10-c0416b065618" }
      ]
    }
  }
}
