// Config Worker du site Coolbeans (adapter @astrojs/cloudflare, cible WORKERS).
// Déploiement : Cloudflare Workers Builds (Git) — main -> production,
// staging -> environnement `staging`. Voir docs/superpowers/specs/2026-08-04-deploy-workers-migration-design.md
// `nodejs_compat` est requis par @clerk/astro (node:async_hooks, node:fs).
{
  "name": "coolbeans",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  // Point d'entrée custom : réécriture par hostname (portail sur my.*) avant
  // le handler Astro — voir src/worker.ts.
  "main": "./src/worker.ts",
  // Sans run_worker_first, la couche assets sert les pages prérendues avant
  // même d'invoquer le Worker : sur my.coolbeans.cc, `/` renverrait la home
  // marketing au lieu du portail. On force le Worker en premier pour les
  // pages, mais pas pour les fichiers statiques (fingerprintés ou de public/).
  "assets": {
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/img/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/apple-touch-icon.png",
      // Sans ces deux exclusions, le manifest et ses icônes passeraient par le
      // Worker, qui les réécrirait en /espace/... sur my.* — donc 404, et une
      // installation A2HS sans icône. Ce sont des fichiers publics : les
      // laisser à la couche assets est aussi ce qui les garde hors de Clerk,
      // le manifest étant récupéré sans cookie de session.
      "!/manifest.webmanifest",
      "!/icons/*"
    ]
  },
  "routes": [
    { "pattern": "coolbeans.cc", "custom_domain": true },
    { "pattern": "www.coolbeans.cc", "custom_domain": true },
    { "pattern": "my.coolbeans.cc", "custom_domain": true }
  ],
  // Sync du portail toutes les 5 minutes : au pire 5 minutes de retard côté
  // client, pour 288 invocations par jour — négligeable devant les 10 M de
  // requêtes incluses au plan payant.
  //
  // Balayage complet à chaque passage, sans découpage : c'est plus simple et
  // plus frais qu'un roulement, et ça tient jusqu'à ~37 clients. Au-delà, la
  // contrainte n'est plus Cloudflare mais le débit de l'API Asana (150 req/min
  // en plan gratuit) : on passera alors à une tranche tournante, sans toucher
  // à cette cadence.
  //
  // `triggers` est une clé héritable : l'environnement staging reprend ce cron
  // et alimente son propre PORTAL_KV. Un seul trigger, donc 1 sur les 5 par
  // COMPTE du plan gratuit (prod + staging en consomment déjà 2).
  //
  // Précondition avant le sync réel de S1 : bascule sur le plan Workers Paid.
  // À cette cadence, le plan gratuit mettrait les 288 écritures quotidiennes de
  // meta:last_sync face à un plafond de 1 000/jour. Aujourd'hui le handler est
  // un no-op, donc sans risque. Voir
  // docs/superpowers/specs/2026-08-12-portail-sync-par-team.md.
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "PORTAL_KV", "id": "f720076d62fc4fd28422209c16326776" }],
  // GID du workspace Asana : public, pas un secret. Les secrets du portail
  // (ASANA_PAT, ADMIN_SYNC_SECRET) se posent par `wrangler secret put`, jamais ici.
  // `vars` et `kv_namespaces` ne sont PAS hérités par les environnements nommés
  // (contrairement à `triggers`, `assets` et `routes`) : d'où la duplication.
  "vars": { "ASANA_WORKSPACE_GID": "1201457508335146" },
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.coolbeans.cc", "custom_domain": true },
        { "pattern": "my-staging.coolbeans.cc", "custom_domain": true }
      ],
      "kv_namespaces": [{ "binding": "PORTAL_KV", "id": "684d2093bab2413bb840bdc6443f6f50" }],
      "vars": { "ASANA_WORKSPACE_GID": "1201457508335146" }
    }
  }
}
