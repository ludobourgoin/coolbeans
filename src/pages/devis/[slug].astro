---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import GridBackdrop from "../../components/GridBackdrop.astro";
import Choicebox from "../../components/ui/Choicebox.astro";
import DevisCorps from "../../components/devis/DevisCorps.astro";
import { dateLongue } from "../../lib/devis";

export async function getStaticPaths() {
  const entries = await getCollection("devis");
  const bySlug = new Map(entries.map((e) => [e.id, e]));
  return entries.map((entry) => {
    const versions = entry.data.versions
      ?.map((v) => bySlug.get(v.slug))
      .filter((e): e is CollectionEntry<"devis"> => e !== undefined);
    return {
      params: { slug: entry.id },
      props: { entry, versions: versions?.length ? versions : [entry] },
    };
  });
}

const { entry, versions } = Astro.props;
const d = entry.data;

const tabs = versions.map((v) => {
  const numero = d.versions?.find((meta) => meta.slug === v.id)?.numero;
  return {
    id: v.id,
    label: numero ? `${dateLongue(v.data.date)} (${numero})` : v.data.titre,
    active: v.id === entry.id,
  };
});
---

<BaseLayout
  title={`Devis ${d.titre} — Coolbeans`}
  description={`Proposition commerciale : ${d.objet}`}
  noindex
>
  <Nav />

  <!-- EN-TÊTE -->
  <header class="relative overflow-hidden bg-surface-subtle">
    <GridBackdrop />
    <div class="container-site relative pt-24x pb-16x text-center">
      <p class="label">Proposition commerciale</p>
      <h1 class="mx-auto mt-5 max-w-[18ch]">{d.titre}</h1>
      <p class="mx-auto mt-6 max-w-[46ch] text-xl leading-[1.45] font-medium">{d.objet}</p>
    </div>
  </header>

  <!-- CORPS DU DEVIS (une paire par version, une seule visible à la fois ; les
       onglets de version vivent dans le bloc sticky de chaque DevisCorps). -->
  <div class="container-site">
    {
      versions.map((v) => (
        <div data-version-pane={v.id} hidden={v.id !== entry.id}>
          <DevisCorps d={v.data} anchorPrefix={v.id} tabs={tabs} />
        </div>
      ))
    }
  </div>

  <!-- RÉPONSE -->
  <section class="border-t border-line bg-surface-subtle">
    <div class="container-site py-24x">
      <div class="mx-auto max-w-[640px]">
        <h2 class="text-center">Répondre à cette proposition</h2>
        <p class="mx-auto mt-4 max-w-[44ch] text-center leading-[1.6] text-mute">
          Validez la proposition ou posez vos questions, je reviens vers vous rapidement.
        </p>
        <form id="devis-form" class="card mt-10 grid gap-6" data-slug={entry.id}>
          <Choicebox
            name="reponse"
            options={[
              {
                value: "validation",
                title: "Je valide cette proposition",
                hint: "Le projet démarre à réception de l'acompte.",
                checked: true,
              },
              {
                value: "question",
                title: "J'ai une question ou une remarque",
                hint: "Précisez-la dans le message ci-dessous.",
              },
            ]}
          />
          <div class="grid grid-cols-2 gap-4 max-[640px]:grid-cols-1">
            <div class="grid gap-2">
              <label class="label" for="devis-nom">Nom</label>
              <input
                class="field"
                type="text"
                id="devis-nom"
                name="nom"
                autocomplete="name"
                placeholder="Votre nom"
              />
            </div>
            <div class="grid gap-2">
              <label class="label" for="devis-email">Email</label>
              <input
                class="field"
                type="email"
                id="devis-email"
                name="email"
                autocomplete="email"
                placeholder="vous@entreprise.com"
              />
            </div>
          </div>
          <div class="grid gap-2">
            <label class="label" for="devis-message">Message</label>
            <textarea
              class="field h-auto min-h-[120px] py-3"
              id="devis-message"
              name="message"
              placeholder="Une question, une remarque, un ajustement souhaité…"></textarea>
          </div>
          <button class="btn btn-lg" type="submit">Envoyer ma réponse</button>
          <p
            data-devis-form-status
            role="status"
            class="hidden text-center text-[13px] font-medium"
          />
        </form>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-version-tab]");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.versionTab;
      tabs.forEach((t) => {
        const active = t.dataset.versionTab === target;
        t.setAttribute("aria-selected", String(active));
        t.classList.toggle("bg-ink", active);
        t.classList.toggle("text-surface", active);
        t.classList.toggle("text-mute", !active);
        t.classList.toggle("hover:text-ink", !active);
      });
      document.querySelectorAll<HTMLElement>("[data-version-pane]").forEach((pane) => {
        pane.hidden = pane.dataset.versionPane !== target;
      });
    });
  });

  const form = document.querySelector<HTMLFormElement>("#devis-form");
  const status = form?.querySelector<HTMLParagraphElement>("[data-devis-form-status]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!status || !submitBtn) return;

    const fd = new FormData(form);
    const payload = {
      slug: form.dataset.slug,
      reponse: fd.get("reponse"),
      nom: fd.get("nom"),
      email: fd.get("email"),
      message: fd.get("message"),
    };

    submitBtn.disabled = true;
    status.hidden = false;
    status.textContent = "Envoi en cours…";
    status.className = "text-center text-[13px] font-medium text-mute";

    try {
      const res = await fetch("/api/devis-reponse", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error();
      status.textContent = "Message envoyé, je reviens vers toi rapidement.";
      status.className = "text-center text-[13px] font-medium text-success";
      form.reset();
    } catch {
      status.textContent = "Envoi impossible, réessaie dans un instant ou écris-moi directement.";
      status.className = "text-center text-[13px] font-medium text-error";
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
