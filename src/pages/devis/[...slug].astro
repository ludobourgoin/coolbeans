---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocumentEntete from "../../components/documents/DocumentEntete.astro";
import DocumentVolet from "../../components/documents/DocumentVolet.astro";
import DevisCorps from "../../components/devis/DevisCorps.astro";
import DevisEntetePrint from "../../components/devis/DevisEntetePrint.astro";
import DevisReponse from "../../components/devis/DevisReponse.astro";
import DevisFooter from "../../components/devis/DevisFooter.astro";
import DocumentReponses from "../../components/devis/DocumentReponses.astro";
import { construitesEnProduction } from "../../lib/documents/statut";
import { chargerDocuments } from "../../lib/documents/charger";
import { frise } from "../../lib/documents/frise";
import { grouperVersions, libelleOnglet, ligneDate, titreEntete } from "../../lib/documents/entete";
import { sectionsDevis } from "../../lib/documents/sections";

/* Une proposition peut avoir plusieurs versions (révision de périmètre).
   Elles partagent l'URL de la V1, et le lien déjà envoyé au client ne bouge
   jamais. Seule la V1 génère une route ; les versions suivantes se déclarent
   par `versionDe` et n'ont pas d'URL propre, sans quoi le client pourrait
   tomber sur une révision hors de son contexte. */
export async function getStaticPaths() {
  /* Charge aussi les trois autres collections, pour la frise, et arrête le
     build si la nomenclature est incohérente. */
  const documents = await chargerDocuments();
  /* Le filtre passe AVANT le regroupement : sur une racine il fait
     disparaître la page, sur une version il fait disparaître un onglet. */
  const entries = construitesEnProduction(await getCollection("devis"), import.meta.env.DEV);
  return grouperVersions(entries).map((versions) => ({
    params: { slug: versions[0].id },
    props: {
      versions,
      pastilles: frise(documents, { collection: "devis", id: versions[0].id }, import.meta.env.DEV),
    },
  }));
}

const { versions, pastilles } = Astro.props;

/* La dernière version est celle qui engage : c'est elle qu'on ouvre. Les
   précédentes restent consultables, jamais réécrites. */
const actif = versions.length - 1;
const racine = versions[0].data;
const courante = versions[actif].data;
const plusieurs = versions.length > 1;

/* Référence du document, reprise telle quelle sur le devis Tiime qui y
   renvoie : le suffixe à quatre chiffres du slug de la V1, stable d'une
   version à l'autre puisque les suivantes n'ont pas d'URL propre. */
const reference = versions[0].id.split("-").pop();
---

<BaseLayout
  title={`Devis ${courante.titre} · Coolbeans`}
  description={`Proposition commerciale : ${courante.objet}`}
  noindex
>
  <DocumentEntete
    etape={racine.etape}
    titre={titreEntete(racine)}
    frise={pastilles}
    onglets={versions.map((v) => ({ libelle: libelleOnglet(v.data), slug: v.id }))}
    actif={actif}
  />

  {
    versions.map((v, i) => (
      <DocumentVolet
        index={i}
        actif={actif}
        total={versions.length}
        titre={v.data.titre}
        objet={v.data.objet}
        date={ligneDate(v.data, plusieurs, "Proposition")}
        sections={sectionsDevis(v.data, plusieurs ? v.data.version : undefined)}
      >
        <div class="container-site">
          <DevisEntetePrint d={v.data} reference={reference} />
          <DevisCorps
            d={v.data}
            version={plusieurs ? v.data.version : undefined}
            precedent={i > 0 ? versions[i - 1].data : undefined}
          />
        </div>
      </DocumentVolet>
    ))
  }

  <!-- Pied du tirage PDF. Masqué à l'écran, où la page porte déjà son URL
       dans la barre du navigateur ; indispensable sur un document qui
       circule détaché, en pièce jointe d'un mail. -->
  <div
    data-devis-pied
    class="container-site hidden text-center font-mono text-[9px] tracking-wide text-mute uppercase print:block"
  >
    Proposition nᵒ {reference} · Version {courante.version} · coolbeans.cc/devis/{versions[0].id}
  </div>

  <!-- Réponses déjà reçues, toutes versions confondues. Une validation de la
       version courante masque le formulaire qui suit. -->
  <DocumentReponses
    server:defer
    type="devis"
    versions={versions.map((v) => ({ slug: v.id, version: v.data.version }))}
    tutoiement={courante.tutoiement}
  />

  {
    courante.formulaire && (
      <DevisReponse
        slug={versions[actif].id}
        enAttente={courante.sections.some((s) => s.budget?.enAttente)}
        tutoiement={courante.tutoiement}
      />
    )
  }

  <DevisFooter />
</BaseLayout>

<style is:global>
  /* Feuille d'impression du devis. Le PDF part en pièce jointe d'un mail, à
     côté du devis Tiime : c'est le document qui porte le détail de l'offre,
     et il doit tenir seul, sans rien qui suppose un écran.

     Irréductible aux utilitaires : @page, print-color-adjust et les
     réécritures d'état d'un composant enfant n'existent pas en classes. */
  @media print {
    @page {
      /* Marge basse creusée pour loger le pied répété, qui se place dans
         cet espace et non dans la zone de texte. */
      margin: 14mm 12mm 20mm;
    }

    /* Un document qui circule doit se nommer sur chacune de ses feuilles, et
       pas seulement sur la dernière : une page détachée du reste ne dit plus
       de quelle proposition elle vient. Chrome répète un élément `fixed` sur
       toutes les pages imprimées, à `bottom: 0` de la zone de contenu — la
       marge basse creusée ci-dessus le sépare du texte. Un décalage négatif
       pour le pousser plus bas le fait au contraire remonter en haut de
       page, par-dessus le titre (constaté le 2026-09-02). Pas de numéro de
       page : Chrome n'implémente `counter(page)` que dans les marges @page,
       qu'il ne gère pas. */
    [data-devis-pied] {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      padding-top: 3mm;
    }

    /* Chrome n'imprime aucun aplat par défaut. Sans ça, les pastilles de
       responsable, les encarts de note et le total perdent leur fond et se
       lisent comme du texte courant. */
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Ce qui ne veut rien dire sur papier : un sommaire dont les ancres ne
       mènent nulle part, un formulaire qu'on ne remplit pas, un pied de
       site, et l'en-tête web — un hero centré sur fond quadrillé qui mange
       un tiers de la première page pour redire un titre. DevisEntetePrint
       le remplace par un bloc émetteur / destinataire / référence. */
    [data-devis-reponse],
    header,
    footer {
      display: none !important;
    }

    /* Le corps est dimensionné pour un écran : 15 à 17 px de texte courant,
       des marges verticales en 4rem. Sur A4 ça donne six pages très aérées
       pour ce qui en fait trois. `zoom` réduit l'ensemble d'un bloc, en
       gardant les proportions et sans toucher à une seule taille : c'est
       propriétaire, mais c'est Chrome qui produit le PDF. */
    body {
      zoom: 0.78;
    }

    /* La grille écran pose le libellé de section dans une colonne de 180 px
       à gauche du contenu. Sur A4 elle laisse une bande vide sur toute la
       hauteur du document et tasse le texte sur une demi-largeur. Le libellé
       repasse donc au-dessus, en titre courant, et le contenu prend toute la
       justification. */
    section,
    [data-devis-notes] {
      display: block !important;
      padding: 1.1rem 0 !important;
    }
    /* Le libellé de section était dimensionné pour une colonne latérale, où
       sa position suffisait à le désigner comme titre. Ramené dans le flux,
       il doit dominer ce qu'il annonce : à 11 px il passait sous le corps de
       texte, et une section se lisait comme la suite de la précédente. */
    section > p:first-child,
    [data-devis-notes] > p:first-child {
      margin-bottom: 0.75rem;
      font-size: 17px;
    }
    /* La colonne de contenu était bornée à 58ch pour la lecture à l'écran ;
       en une colonne, cette laisse blanche à droite n'a plus d'objet. */
    [data-devis-notes] > div:last-child {
      max-width: none;
    }

    /* Les infobulles portent de l'argumentaire (périmètre du bilingue,
       pourquoi une seule maquette…). Sur papier, le marqueur ⓘ ne mène
       nulle part : on déplie la bulle en incise au lieu de perdre le texte. */
    [data-tooltip] > button {
      display: none;
    }
    [data-tooltip] {
      position: static;
      top: 0;
    }
    [data-tooltip] [data-bulle] {
      display: inline !important;
      position: static;
      max-width: none;
      margin: 0;
      padding: 0;
      background: none;
      box-shadow: none;
      transform: none !important;
      color: inherit;
      /* 0,6 tirait vers le gris clair : lisible à l'écran rétroéclairé,
         délavé une fois imprimé. L'incise doit rester une nuance, pas une
         disparition. */
      opacity: 0.78;
      font-size: 0.88em;
    }
    [data-tooltip] [data-bulle]::before {
      content: " : ";
    }

    /* Rien ne colle en haut d'une feuille. */
    [class*="sticky"] {
      position: static !important;
    }

    /* Une ligne de budget ou un jalon coupé en deux par un saut de page
       sépare son libellé de son montant, ou sa date de son responsable.
       Les sections, elles, restent coupables : Budget dépasse la page, et
       une section insécable plus haute qu'une feuille produit une page
       blanche. */
    [data-devis-ligne],
    [data-devis-jalon],
    [data-banner],
    .card {
      break-inside: avoid;
    }
    h1,
    h2,
    h3 {
      break-after: avoid;
    }
  }
</style>
