---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GridBackdrop from "../../components/GridBackdrop.astro";
import DevisCorps from "../../components/devis/DevisCorps.astro";
import DevisReponse from "../../components/devis/DevisReponse.astro";
import DevisFooter from "../../components/devis/DevisFooter.astro";

/* Un devis peut avoir plusieurs versions (révision de périmètre). Elles
   partagent l'URL de la V1 — le lien déjà envoyé au client ne bouge jamais —
   et se choisissent par des onglets. Seule la V1 génère une route ; les
   versions suivantes se déclarent par `versionDe` et n'ont pas d'URL propre,
   sans quoi le client pourrait tomber sur une révision hors de son contexte. */
export async function getStaticPaths() {
  const entries = await getCollection("devis");
  const racines = entries.filter((e) => !e.data.versionDe);

  return racines.map((racine) => {
    const versions = [racine, ...entries.filter((e) => e.data.versionDe === racine.id)].sort(
      (a, b) => a.data.version - b.data.version,
    );
    return { params: { slug: racine.id }, props: { versions } };
  });
}

const { versions } = Astro.props;

/* La dernière version est celle qui engage : c'est elle qu'on ouvre. Les
   précédentes restent consultables, jamais réécrites. */
const actif = versions.length - 1;

const dateCourte = (d: Date) =>
  d.toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });

/* La date du devis n'était portée que par le frontmatter : le client ne la
   voyait nulle part, alors qu'elle date l'engagement commercial. */
const dateLongue = (d: Date) =>
  d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });

const courante = versions[actif].data;

/* Référence du document, reprise telle quelle sur le devis Tiime qui y
   renvoie : c'est le suffixe à quatre chiffres du slug de la V1, stable
   d'une version à l'autre puisque les suivantes n'ont pas d'URL propre. */
const reference = versions[0].id.split("-").pop();
---

<BaseLayout
  title={`Devis ${courante.titre} · Coolbeans`}
  description={`Proposition commerciale : ${courante.objet}`}
  noindex
>
  <!-- EN-TÊTE -->
  <header class="relative overflow-hidden bg-surface-subtle">
    <GridBackdrop />
    <div class="container-site relative pt-24x pb-16x text-center">
      <p class="label">Proposition commerciale</p>
      {
        versions.map((v, i) => (
          <div data-devis-entete={i} hidden={i !== actif}>
            <h1 class="mx-auto mt-5 max-w-[18ch]">{v.data.titre}</h1>
            <p class="mx-auto mt-6 max-w-[62ch] text-xl leading-[1.45] font-medium text-balance">
              {v.data.objet}
            </p>
            <p class="mt-5 font-mono text-[12px] tracking-wide text-mute uppercase">
              Proposition du {dateLongue(v.data.date)}
            </p>
          </div>
        ))
      }

      {
        versions.length > 1 && (
          <div class="mt-8 flex flex-wrap justify-center gap-2" role="tablist">
            {versions.map((v, i) => (
              <button
                type="button"
                role="tab"
                aria-pressed={i === actif}
                data-devis-onglet={i}
                data-devis-slug={v.id}
                class:list={[
                  "rounded-full px-3 py-1 text-[13px] font-semibold transition-colors duration-150 ease-in-out",
                  i === actif
                    ? "bg-ink text-surface"
                    : "text-mute hover:bg-surface-raise hover:text-ink",
                ]}
              >
                V{v.data.version} · {dateCourte(v.data.date)}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <!-- CORPS DU DEVIS -->
  <div class="container-site">
    {
      versions.map((v, i) => (
        <div data-devis-pane={i} hidden={i !== actif}>
          <DevisCorps d={v.data} version={versions.length > 1 ? v.data.version : undefined} />
        </div>
      ))
    }
  </div>

  <!-- Pied du tirage PDF. Masqué à l'écran, où la page porte déjà son URL
       dans la barre du navigateur ; indispensable sur un document qui
       circule détaché, en pièce jointe d'un mail. -->
  <div
    class="container-site hidden pt-10x pb-4x text-center font-mono text-[11px] leading-[1.8] tracking-wide text-mute uppercase print:block"
  >
    Proposition n° {reference} · Version {courante.version} du {dateLongue(courante.date)}<br />
    coolbeans.cc/devis/{versions[0].id} · Coolbeans — Ludovic Bourgoin
  </div>

  <DevisReponse
    slug={versions[actif].id}
    enAttente={courante.sections.some((s) => s.budget?.enAttente)}
  />

  <DevisFooter />
</BaseLayout>

<script>
  /* Onglets de versions. Même mécanique que le sélecteur d'options de planning
     de DevisCorps : on bascule la visibilité, on ne recharge pas. Le slug du
     formulaire de réponse suit la version affichée, sans quoi une réponse à la
     V1 arriverait étiquetée V2. */
  const onglets = document.querySelectorAll<HTMLButtonElement>("[data-devis-onglet]");
  const form = document.querySelector<HTMLFormElement>("#devis-form");

  onglets.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cible = btn.dataset.devisOnglet;

      onglets.forEach((b) => {
        const actif = b.dataset.devisOnglet === cible;
        b.setAttribute("aria-pressed", String(actif));
        b.classList.toggle("bg-ink", actif);
        b.classList.toggle("text-surface", actif);
        b.classList.toggle("text-mute", !actif);
        b.classList.toggle("hover:bg-surface-raise", !actif);
        b.classList.toggle("hover:text-ink", !actif);
      });

      document
        .querySelectorAll<HTMLElement>("[data-devis-pane], [data-devis-entete]")
        .forEach((el) => {
          el.hidden = (el.dataset.devisPane ?? el.dataset.devisEntete) !== cible;
        });

      if (form && btn.dataset.devisSlug) form.dataset.slug = btn.dataset.devisSlug;
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>

<style is:global>
  /* Feuille d'impression du devis. Le PDF part en pièce jointe d'un mail, à
     côté du devis Tiime : c'est le document qui porte le détail de l'offre,
     et il doit tenir seul, sans rien qui suppose un écran.

     Irréductible aux utilitaires : @page, print-color-adjust et les
     réécritures d'état d'un composant enfant n'existent pas en classes. */
  @media print {
    @page {
      margin: 14mm 12mm;
    }

    /* Chrome n'imprime aucun aplat par défaut. Sans ça, les pastilles de
       responsable, les encarts de note et le total perdent leur fond et se
       lisent comme du texte courant. */
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Ce qui ne veut rien dire sur papier : un sommaire dont les ancres ne
       mènent nulle part, un formulaire qu'on ne remplit pas, un pied de
       site. */
    [data-sticky-devis-nav],
    [data-devis-reponse],
    footer {
      display: none !important;
    }

    /* Les onglets de version : on ne bascule pas d'onglet sur une feuille.
       Reste la seule information qui compte, quelle version on tient entre
       les mains, en texte discret. */
    [role="tablist"] button:not([aria-pressed="true"]) {
      display: none;
    }
    [role="tablist"] button[aria-pressed="true"] {
      background: none;
      color: inherit;
      opacity: 0.55;
    }

    /* Les infobulles portent de l'argumentaire (périmètre du bilingue,
       pourquoi une seule maquette…). Sur papier, le marqueur ⓘ ne mène
       nulle part : on déplie la bulle en incise au lieu de perdre le texte. */
    [data-tooltip] > button {
      display: none;
    }
    [data-tooltip] {
      position: static;
      top: 0;
    }
    [data-tooltip] [data-bulle] {
      display: inline !important;
      position: static;
      max-width: none;
      margin: 0;
      padding: 0;
      background: none;
      box-shadow: none;
      transform: none !important;
      color: inherit;
      opacity: 0.6;
      font-size: 0.92em;
    }
    [data-tooltip] [data-bulle]::before {
      content: " — ";
    }

    /* Rien ne colle en haut d'une feuille. */
    [class*="sticky"] {
      position: static !important;
    }

    /* Une ligne de budget ou un jalon coupé en deux par un saut de page
       sépare son libellé de son montant, ou sa date de son responsable.
       Les sections, elles, restent coupables : Budget dépasse la page, et
       une section insécable plus haute qu'une feuille produit une page
       blanche. */
    [data-devis-ligne],
    [data-devis-jalon],
    [data-banner],
    .card {
      break-inside: avoid;
    }
    h1,
    h2,
    h3 {
      break-after: avoid;
    }
  }
</style>
