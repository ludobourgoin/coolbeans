---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GridBackdrop from "../../components/GridBackdrop.astro";
import DevisCorps from "../../components/devis/DevisCorps.astro";
import DevisReponse from "../../components/devis/DevisReponse.astro";
import DevisFooter from "../../components/devis/DevisFooter.astro";

export async function getStaticPaths() {
  const entries = await getCollection("devis");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;

/* La date du devis n'était portée que par le frontmatter : le client ne la
   voyait nulle part, alors qu'elle date l'engagement commercial. */
const dateDevis = d.date.toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title={`Devis ${d.titre} · Coolbeans`}
  description={`Proposition commerciale : ${d.objet}`}
  noindex
>
  <!-- EN-TÊTE -->
  <header class="relative overflow-hidden bg-surface-subtle">
    <GridBackdrop />
    <div class="container-site relative pt-24x pb-16x text-center">
      <p class="label">Proposition commerciale</p>
      <h1 class="mx-auto mt-5 max-w-[18ch]">{d.titre}</h1>
      <p
        class="mx-auto mt-6 max-w-[62ch] text-xl leading-[1.45] font-medium text-balance"
      >
        {d.objet}
      </p>
      <p class="mt-5 font-mono text-[12px] tracking-wide text-mute uppercase">
        Proposition du {dateDevis}
      </p>
    </div>
  </header>

  <!-- CORPS DU DEVIS -->
  <div class="container-site">
    <DevisCorps d={d} />
  </div>

  <DevisReponse slug={entry.id} enAttente={d.sections.some((s) => s.budget?.enAttente)} />

  <DevisFooter />
</BaseLayout>
