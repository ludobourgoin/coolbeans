---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { toolCategories } from "../data/tools";
---

<BaseLayout
  title="Tools — la boîte à outils de Coolbeans"
  description="Apps et outils que j'utilise au quotidien sur des projets réels coolbeans, et que je recommande les yeux fermés."
>
  <Nav />

  <section class="surface-brand border-b border-line">
    <div class="container-site pt-20 pb-12">
      <h1 class="lowercase">tools.</h1>
      <p class="mt-5 max-w-prose text-xl font-medium">
        apps et outils que j'utilise <em class="text-mute italic">au quotidien</em>, sur des projets
        réels coolbeans, et que je recommande les yeux fermés.
      </p>
    </div>
  </section>

  <div
    class="container-site grid grid-cols-1 items-start gap-10 pt-14 pb-28 lg:grid-cols-[220px_1fr] lg:gap-16"
  >
    <aside class="lg:sticky lg:top-24" aria-label="catégories">
      <nav class="flex flex-wrap gap-0.5 lg:flex-col lg:flex-nowrap">
        {
          toolCategories.map((cat) => (
            <a
              href={`#${cat.id}`}
              class="flex items-center justify-between gap-2 rounded-control px-3 py-2 font-display text-sm font-semibold text-ink lowercase transition-colors duration-200 ease-brand hover:bg-surface-raise"
            >
              {cat.title}
              <span class="font-mono text-xs text-mute">{cat.cards.length}</span>
            </a>
          ))
        }
      </nav>
    </aside>

    <div class="flex flex-col gap-14 lg:gap-20">
      {
        toolCategories.map((cat) => (
          <section class="scroll-mt-24" id={cat.id}>
            <div class="mb-6 flex items-center gap-4">
              <h2 class="whitespace-nowrap lowercase">{cat.title}</h2>
              <span class="h-px flex-1 bg-line" />
            </div>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-5">
              {cat.cards.map((tool) => (
                <a
                  class="card flex flex-col gap-4 transition-colors duration-200 ease-brand hover:border-ink"
                  href={tool.href || "#"}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${tool.name} — site officiel`}
                >
                  <div class="flex items-center gap-3">
                    <div class="grid size-11 shrink-0 place-items-center border border-line bg-tile">
                      <img src={tool.logo} alt="" loading="lazy" class="size-3/4 object-contain" />
                    </div>
                    <div class="font-display text-lg font-semibold lowercase">{tool.name}</div>
                  </div>
                  <p class="text-sm text-mute">{tool.desc}</p>
                  {tool.chips.length > 0 && (
                    <div class="mt-auto flex flex-wrap gap-1.5">
                      {tool.chips.map((chip) => (
                        <span class="border border-line px-2 py-1 font-mono text-xs font-semibold tracking-wide text-mute lowercase">
                          {chip}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <Footer />
</BaseLayout>
