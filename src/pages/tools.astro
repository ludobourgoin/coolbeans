---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { toolCategories } from "../data/tools";

const toolCount = toolCategories.reduce((n, cat) => n + cat.cards.length, 0);

const groups = [
  { label: "software", categories: toolCategories.filter((cat) => cat.group === "software") },
  { label: "hardware", categories: toolCategories.filter((cat) => cat.group === "hardware") },
];
---

<BaseLayout
  title="Boîte à outils — Coolbeans"
  description="Les outils qui font tourner les projets coolbeans, du framework au terminal de paiement : testés en production, recommandés les yeux fermés."
>
  <Nav />

  <section class="border-b border-line">
    <div class="container-site pt-20 pb-12 text-center">
      <h1>Boîte à outils.</h1>
      <p class="mx-auto mt-5 max-w-prose text-xl font-medium">
        Tous les outils que j'utilise au quotidien, et que je recommande les yeux fermés.
      </p>
    </div>
  </section>

  <div
    class="container-site grid grid-cols-1 items-start gap-10 pt-14 pb-28 lg:grid-cols-[220px_1fr] lg:gap-16"
  >
    <aside class="lg:sticky lg:top-24" aria-label="catégories">
      <nav class="flex flex-col gap-8">
        {
          groups.map((group) => (
            <div>
              <div class="label">{group.label}</div>
              <div class="mt-2 h-px bg-ink/60" />
              <div class="mt-1 flex flex-wrap gap-0.5 lg:flex-col lg:flex-nowrap lg:gap-0">
                {group.categories.map((cat) => (
                  <a
                    href={`#${cat.id}`}
                    class="flex items-center justify-between gap-2 rounded-control px-3 py-2.5 font-display text-sm font-semibold text-ink transition-colors duration-200 ease-brand hover:bg-surface-raise lg:not-last:border-b lg:not-last:border-line"
                  >
                    {cat.title}
                    <span class="font-mono text-xs text-mute">{cat.cards.length}</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </nav>
    </aside>

    <div class="flex flex-col gap-14 lg:gap-20">
      {
        toolCategories.map((cat) => (
          <section class="scroll-mt-24" id={cat.id}>
            <div class="mb-6 flex items-center gap-4">
              <h2 class="whitespace-nowrap">{cat.title}</h2>
              <span class="h-px flex-1 bg-line" />
            </div>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-5">
              {cat.cards.map((tool) => (
                <a
                  class="card flex flex-col gap-4 transition-colors duration-200 ease-brand hover:bg-surface-raise"
                  href={tool.href || "#"}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${tool.name} — site officiel`}
                >
                  <div class="flex items-center gap-3">
                    <div class="grid size-11 shrink-0 place-items-center border border-line bg-tile">
                      <img src={tool.logo} alt="" loading="lazy" class="size-3/4 object-contain" />
                    </div>
                    <div class="font-display text-lg font-semibold">{tool.name}</div>
                  </div>
                  {tool.chips.length > 0 && (
                    <div class="mt-auto flex flex-wrap gap-1.5">
                      {tool.chips.map((chip) => (
                        <span class="border border-line px-2 py-1 font-mono text-xs font-semibold tracking-wide text-mute">
                          {chip}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <Footer />
</BaseLayout>
