---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GridBackdrop from "../../components/GridBackdrop.astro";
import Banner from "../../components/ui/Banner.astro";
import Tooltip from "../../components/ui/Tooltip.astro";
import CadrageIntro from "../../components/cadrage/CadrageIntro.astro";
import TemoignageCasClient from "../../components/temoignage/TemoignageCasClient.astro";
import TemoignageFormulaire from "../../components/temoignage/TemoignageFormulaire.astro";
import DevisFooter from "../../components/devis/DevisFooter.astro";
import { dateLongue, riche, ancreSection } from "../../lib/devis";

/* Une page de témoignage par fichier YAML, une URL par fichier. Pas de
   versions : contrairement au livrable, ce document ne se rejoue pas. Le
   témoignage se demande une fois, et s'il faut y revenir à trois mois, c'est
   un autre document.

   L'intro se rend avec CadrageIntro : les sections ont exactement la même
   forme, et dupliquer une mise en page pour un document de plus est
   précisément ce qui fait diverger quatre pages qui devraient se ressembler. */
export async function getStaticPaths() {
  const entries = await getCollection("temoignage");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
---

<BaseLayout
  title={`${d.titre} · Coolbeans`}
  description={`Témoignage et validation : ${d.objet}`}
  noindex
>
  <!-- EN-TÊTE -->
  <header class="relative overflow-hidden bg-surface-subtle">
    <GridBackdrop />
    <div class="container-site relative pt-24x pb-16x text-center">
      <p class="label">Après la livraison</p>
      <h1 class="mx-auto mt-5 max-w-[18ch]">{d.titre}</h1>
      <p class="mx-auto mt-6 max-w-[62ch] text-xl leading-[1.45] font-medium text-balance">
        {d.objet}
      </p>
      <p class="mt-5 font-mono text-[12px] tracking-wide text-mute uppercase">
        Document du {dateLongue(d.date)}
      </p>
    </div>
  </header>

  <div class="container-site">
    <div class="mx-auto max-w-[880px] py-16x">
      <CadrageIntro sections={d.intro} />

      {
        d.casClient && (
          <TemoignageCasClient
            titre={d.casClient.titre}
            texte={d.casClient.texte}
            slug={d.casClient.slug}
            label={d.casClient.label}
            fauxTexte={d.casClient.fauxTexte}
            tutoiement={d.tutoiement}
            ancre={ancreSection(d.casClient.titre)}
          />
        )
      }

      {
        d.notes.length > 0 && (
          <div class="mt-16x grid grid-cols-[180px_1fr] gap-10 border-t border-line pt-10 max-[700px]:grid-cols-1 max-[700px]:gap-4">
            <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">
              NB
            </p>
            <div class="flex max-w-[58ch] flex-col gap-3">
              {d.notes.map((note) => (
                <Banner tone={note.tone}>
                  <Fragment set:html={riche(note.texte)} />
                  {note.tooltip && <Tooltip texte={note.tooltip} />}
                </Banner>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>

  {
    /* Formulaire coupé une fois le témoignage reçu : la page devient une
       trace, et rien n'invite à répondre deux fois. Même mécanique que le
       livrable validé. */
    d.formulaire && (
      <TemoignageFormulaire
        slug={entry.id}
        questions={d.questions}
        tutoiement={d.tutoiement}
        photo={d.photo}
      />
    )
  }

  <DevisFooter />
</BaseLayout>
