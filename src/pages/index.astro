<script is:inline>
  (function () {
    const el = document.getElementById("tw-word");
    if (!el) return;
    const words = ["agences créatives", "directeurs artistiques", "pme & scale-ups", "tpe & solopreneurs"];
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let wi = 0, ci = words[0].length, deleting = true;
    function tick() {
      const word = words[wi];
      if (deleting) {
        ci--;
        if (ci <= 0) { deleting = false; wi = (wi + 1) % words.length; }
      } else {
        ci++;
        if (ci >= words[wi].length) { deleting = true; }
      }
      el.textContent = words[wi].slice(0, ci) || word.slice(0, 1);
      const delay = deleting ? 45 : ci >= words[wi].length ? 1600 : 95;
      setTimeout(tick, delay);
    }
    setTimeout(tick, 1600);
  })();
</script>
