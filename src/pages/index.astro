---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import Flow from "../components/Flow.astro";
import Browser from "../components/Browser.astro";
import GridBackdrop from "../components/GridBackdrop.astro";
import Avatar from "../components/ui/Avatar.astro";
import { testimonials, initials } from "../data/testimonials";
import { cases } from "../data/cases";

// sections masquées temporairement (urgence post-mise en prod, 2026-08-04) :
// le contenu reste en place, juste pas rendu, à réactiver quand prêt.
const SHOW_PROJETS = false;
const SHOW_METHODE = false;
const SHOW_EN_SAVOIR_PLUS = false;

const stats = [
  { n: "40", small: "+", k: "projets livrés", h: "Depuis 2018" },
  { n: "90", small: "%", k: "des projets", h: "Viennent par recommandation" },
  { n: "48", small: "h", k: "réponse devis", h: "En cas d'urgence, week-end compris" },
  { n: "10", small: "+", k: "ans", h: "D'expérience en dev web" },
];

const steps = [
  {
    n: "01",
    title: "Brief & cadrage",
    text: "Formulaire + call 30-60 min. Scope, deadline et budget posés.",
  },
  { n: "02", title: "Devis", text: "Chiffré, daté, signé. Paiement 30 % à l'acceptation." },
  {
    n: "03",
    title: "Développement",
    text: "V1 sous 5 j. V2 finale sous 3 j. Validation par section.",
  },
  {
    n: "04",
    title: "Livraison",
    text: "Mise en prod, transfert, documentation et formation. 30 j de support inclus.",
  },
];

const columns: (typeof testimonials)[] = [[], [], []];
testimonials.forEach((t, i) => columns[i % 3].push(t));

// grille 12 colonnes des études de cas : cases.ts (Case.span) porte encore
// les jetons historiques "span-8"/"span-6"/"span-4" ; on les fait
// correspondre aux vraies utilitaires Tailwind col-span-* sans toucher à la
// donnée. "tall" n'a plus d'effet visuel : Browser fixe l'aspect-ratio à
// 16/10 quel que soit l'emplacement.
const caseColSpan = (span: string) =>
  span.startsWith("span-8")
    ? "col-span-8"
    : span.startsWith("span-6")
      ? "col-span-6"
      : "col-span-4";
---

<BaseLayout title="Coolbeans — le studio web des agences créatives">
  <Nav />

  <!-- HERO centré + flux -->
  <section
    class="relative flex flex-col gap-10 overflow-hidden border-b border-line bg-surface-subtle pt-14 pb-10"
  >
    <GridBackdrop />
    <div class="container-site relative text-center">
      <h1
        class="mx-auto max-w-[22ch] text-[clamp(40px,4.6vw,64px)] leading-[1.02] tracking-[-0.03em] text-balance"
      >
        Design et code,<br />pensés pour durer.
      </h1>
      <p
        class="mx-auto mt-6.5 max-w-[60ch] text-[19px] leading-[1.45] font-medium text-pretty text-mute"
      >
        Vitrine, e-commerce, refonte, appli web, automatisation, IA :<br />j'analyse le besoin avant
        de choisir l'outil
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-5">
        <a class="btn btn-lg" href="#vous-etes">Discuter de votre projet</a>
        <a class="btn btn-outline btn-lg" href="/about">À propos</a>
      </div>
    </div>
    <Flow />
  </section>

  <!-- VOUS ÊTES (bento) -->
  <section class="py-16x" id="vous-etes">
    <div class="container-site">
      <div class="mb-10x"><h2>Vous êtes…</h2></div>
      <div
        class="grid auto-rows-[minmax(180px,auto)] grid-cols-4 gap-4 max-[900px]:grid-cols-2 max-[680px]:grid-cols-1"
      >
        <article
          class="relative col-span-2 row-span-2 flex flex-col rounded-card border border-line bg-surface-raise p-8 max-[900px]:row-span-1 max-[680px]:col-span-1"
        >
          <svg
            class="size-9.5 flex-none fill-none stroke-current stroke-[1.7]"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><rect x="4" y="3" width="10" height="18"></rect><rect
              x="14"
              y="9"
              width="6"
              height="12"></rect><line x1="7" y1="7" x2="11" y2="7"></line><line
              x1="7"
              y1="11"
              x2="11"
              y2="11"></line><line x1="7" y1="15" x2="11" y2="15"></line></svg
          >
          <div class="mt-auto pt-8">
            <h3 class="text-[30px] leading-[1.08]">Agence créative</h3>
            <p class="mt-2.5 max-w-[34ch] text-base font-medium text-pretty">
              Vous concevez, j'exécute. Sous votre marque, en marque blanche, je suis comme une
              extension de votre équipe.
            </p>
            {
              SHOW_EN_SAVOIR_PLUS && (
                <a class="link mt-5.5 inline-block text-sm" href="/about">
                  En savoir plus →
                </a>
              )
            }
          </div>
        </article>
        <article
          class="relative col-span-2 flex flex-col rounded-card border border-line bg-surface-raise p-8 max-[900px]:col-span-1"
        >
          <svg
            class="size-9.5 flex-none fill-none stroke-current stroke-[1.7]"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><path d="M12 20h9"></path><path
              d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path></svg
          >
          <div class="mt-auto pt-6">
            <h3 class="text-[21px] leading-[1.08]">Directeur·rice artistique</h3>
            <p class="mt-2.5 text-[15px] font-medium text-pretty">
              Votre design livré exactement comme pensé, au pixel près.
            </p>
            {
              SHOW_EN_SAVOIR_PLUS && (
                <a class="link mt-5 inline-block text-sm" href="/about">
                  En savoir plus →
                </a>
              )
            }
          </div>
        </article>
        <article
          class="relative flex flex-col rounded-card border border-line bg-surface-raise p-8"
        >
          <svg
            class="size-9.5 flex-none fill-none stroke-current stroke-[1.7]"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="21 12 21 7 16 7"
            ></polyline></svg
          >
          <div class="mt-auto pt-6">
            <h3 class="text-[21px] leading-[1.08]">PME ou scale up</h3>
            <p class="mt-2.5 text-[15px] font-medium text-pretty">
              Votre site est un canal d'acquisition. Traitons-le comme tel.
            </p>
            {
              SHOW_EN_SAVOIR_PLUS && (
                <a class="link mt-5 inline-block text-sm" href="/about">
                  En savoir plus →
                </a>
              )
            }
          </div>
        </article>
        <article
          class="relative flex flex-col rounded-card border border-line bg-surface-raise p-8"
        >
          <svg
            class="size-9.5 flex-none fill-none stroke-current stroke-[1.7]"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><path d="M3 9h18l-1.4-5H4.4L3 9z"></path><path d="M5 9v11h14V9"></path><path
              d="M9 20v-6h6v6"></path></svg
          >
          <div class="mt-auto pt-6">
            <h3 class="text-[21px] leading-[1.08]">TPE ou solopreneur</h3>
            <p class="mt-2.5 text-[15px] font-medium text-pretty">
              Votre présence en ligne pro, livrée vite, prix fixe, zéro souci.
            </p>
            {
              SHOW_EN_SAVOIR_PLUS && (
                <a class="link mt-5 inline-block text-sm" href="/about">
                  En savoir plus →
                </a>
              )
            }
          </div>
        </article>
        <article
          class="relative col-span-4 flex flex-row flex-wrap items-center gap-6.5 rounded-card border border-line bg-surface-raise p-8 max-[900px]:col-span-1 max-[900px]:flex-col max-[900px]:items-start"
        >
          <svg
            class="size-8.5 flex-none fill-none stroke-current stroke-[1.7]"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><path d="M12 20s-7-4.5-9-9a4 4 0 0 1 9-2 4 4 0 0 1 9 2c-2 4.5-9 9-9 9z"></path></svg
          >
          <div class="min-w-0 flex-[1_1_340px]">
            <h3 class="text-[19px] leading-[1.08]">Coopérative, association, intérêt général ?</h3>
            <p class="mt-2 max-w-[74ch] text-[15px] font-medium text-pretty">
              Je mets mes compétences au service de l'économie sociale et solidaire : offres et
              tarifs adaptés pour les coopératives, les associations et les structures reconnues
              d'intérêt général. La qualité d'un studio, pensée pour vos moyens.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {
    SHOW_PROJETS && (
      <section class="py-16x" id="projets">
        <div class="container-site">
          <div class="mb-10x flex flex-wrap items-center justify-between gap-6">
            <h2>Projets récents.</h2>
            <a class="link" href="#">
              Voir tous les projets →
            </a>
          </div>
          <div class="grid grid-cols-12 gap-8 max-[900px]:grid-cols-1">
            {cases.map((c) => (
              <article class:list={[caseColSpan(c.span), "max-[900px]:col-span-1"]}>
                <Browser url={c.url} shot={c.shot} alt={c.title} label={c.tag} />
                <div class="mt-4">
                  <span class="label mb-1.5 block">{c.num}</span>
                  <h3 class="text-[17px] leading-tight">{c.title}</h3>
                  <a class="link mt-2 inline-block text-sm" href="#">
                    Lire l'étude →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- TÉMOIGNAGES (mur cappé + fondu) -->
  <section class="py-16x">
    <div class="container-site">
      <div class="mb-10x text-center">
        <h2 class="text-[clamp(32px,4.4vw,64px)] leading-[1.02] tracking-[-0.035em]">
          Ils en parlent mieux que moi.
        </h2>
      </div>
      <div class="flex items-start gap-6 max-[680px]:flex-col">
        {
          columns.map((col) => (
            <div class="flex h-310 min-w-0 flex-1 flex-col gap-6 overflow-hidden mask-[linear-gradient(to_bottom,#000_calc(100%-230px),transparent)] [-webkit-mask-image:linear-gradient(to_bottom,#000_calc(100%-230px),transparent)] max-[900px]:h-270 max-[900px]:flex-[1_1_45%] max-[680px]:h-auto max-[680px]:w-full max-[680px]:flex-[1_1_auto] max-[680px]:overflow-visible max-[680px]:mask-none max-[680px]:[-webkit-mask-image:none]">
              {col.map((t) => (
                <figure class="flex flex-col gap-7 rounded-card border border-line bg-surface p-7">
                  <blockquote class="text-base leading-[1.55] font-medium text-pretty">
                    « {t.quote} »
                  </blockquote>
                  <figcaption class="mt-auto flex items-center gap-3.5">
                    <Avatar src={t.photo} alt={t.name} initials={initials(t.name)} size={48} />
                    <div>
                      <b class="block text-[15px] leading-[1.2] font-bold tracking-[-0.005em]">
                        {t.name}
                      </b>
                      <small class="mt-1 block font-mono text-xs leading-[1.4] font-medium text-mute">
                        {t.role}
                      </small>
                    </div>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    SHOW_METHODE && (
      <section class="py-16x">
        <div class="container-site">
          <div class="mb-10x">
            <h2>Du brief à la mise en production</h2>
          </div>
          <div class="flex items-stretch max-[1100px]:flex-col">
            {steps.map((s, i) => (
              <>
                <div class="flex min-w-0 flex-1 flex-col rounded-card border border-line bg-surface p-7">
                  <div class="font-display text-[72px] leading-[0.9] font-bold tracking-[-0.04em]">
                    {s.n}
                  </div>
                  <h3 class="mt-3 text-xl leading-[1.15] tracking-[-0.01em]">{s.title}</h3>
                  <p class="mt-2 max-w-[32ch] text-sm font-medium text-mute">{s.text}</p>
                </div>
                {i < steps.length - 1 && (
                  <div
                    class="flex flex-none items-center justify-center px-4.5 text-[28px] leading-none font-bold text-ink max-[1100px]:rotate-90 max-[1100px]:px-0 max-[1100px]:py-3.5"
                    aria-hidden="true"
                  >
                    →
                  </div>
                )}
              </>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- STATS -->
  <section class="py-16x">
    <div class="container-site">
      <div class="mb-10x">
        <span class="label mb-3 block">chiffres · depuis 2018</span>
        <h2>J'accompagne agences, créatifs et entreprises sur leurs projets web depuis 2018</h2>
        <p class="mt-3 max-w-[60ch] text-lg leading-normal font-medium">
          De la landing one-shot à l'application sur-mesure, en passant par la refonte de site et
          l'automatisation, je m'occupe de toute la partie technique
        </p>
      </div>
      <div class="grid grid-cols-4 max-[1100px]:grid-cols-1 max-[1100px]:gap-6">
        {
          stats.map((s) => (
            <div class="border-r border-line pr-6 not-first:pl-6 last:border-r-0 max-[1100px]:border-r-0 max-[1100px]:border-b max-[1100px]:py-5 max-[1100px]:pr-0 max-[1100px]:not-first:pl-0 max-[1100px]:last:border-b-0">
              <div class="font-display text-[64px] leading-[0.95] font-bold tracking-[-0.04em]">
                {s.n}
                <small class="text-[0.4em] font-semibold text-mute">{s.small}</small>
              </div>
              <div class="mt-2 font-mono text-[13px] font-bold tracking-[0.04em] uppercase">
                {s.k}
              </div>
              <div class="mt-1 max-w-[24ch] text-xs leading-[1.4] text-mute">{s.h}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ABOUT COURT -->
  <section class="py-16x">
    <div
      class="container-site grid grid-cols-[1fr_440px] items-center gap-20 max-[1100px]:grid-cols-1 max-[1100px]:gap-6"
    >
      <div class="flex flex-col items-start gap-6">
        <h3 class="max-w-[14ch] text-[clamp(40px,5vw,72px)] leading-[0.98] tracking-[-0.035em]">
          Je m'appelle Ludo,<br />j'ai créé coolbeans.
        </h3>
        <p class="max-w-[46ch] text-[19px] leading-[1.55] font-medium text-pretty">
          Développeur web freelance, avec plus de 10 ans en agence et en indépendant : direction
          de projet, design, développement.
        </p>
        <a class="link" href="/about">Lire la version longue →</a>
      </div>
      <figure
        class="relative aspect-4/5 overflow-hidden rounded-card border border-line bg-surface-subtle max-[1100px]:aspect-16/11"
      >
        <img
          src="/img/ludovic-home.jpg"
          alt="ludovic bourgoin, fondateur de coolbeans"
          class="absolute inset-0 h-full w-full object-cover object-[center_32%]"
        />
      </figure>
    </div>
  </section>

  <CtaBand
    title="On cadre votre projet en 30 minutes ?"
    text="Un échange sans engagement : on cadre votre besoin, je vous dis franchement si je suis la bonne personne, et vous repartez avec un devis chiffré sous 48 h."
    ctaLabel="Discuter du projet"
  />

  <Footer />
</BaseLayout>
