---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GridBackdrop from "../../components/GridBackdrop.astro";
import Banner from "../../components/ui/Banner.astro";
import Tooltip from "../../components/ui/Tooltip.astro";
import CadrageIntro from "../../components/cadrage/CadrageIntro.astro";
import LivrableApercu from "../../components/livrable/LivrableApercu.astro";
import LivrableVideo from "../../components/livrable/LivrableVideo.astro";
import LivrableParcours from "../../components/livrable/LivrableParcours.astro";
import LivrableMessage from "../../components/livrable/LivrableMessage.astro";
import LivrableSuite from "../../components/livrable/LivrableSuite.astro";
import LivrableReponse from "../../components/livrable/LivrableReponse.astro";
import DevisFooter from "../../components/devis/DevisFooter.astro";
import DocumentTopbar from "../../components/devis/DocumentTopbar.astro";
import { dateLongue, riche } from "../../lib/devis";

/* Un livrable peut avoir plusieurs versions : après des retours, la V2 se
   déclare par `versionDe` et partage l'URL de la V1, comme au devis. Le lien
   envoyé au client ne bouge jamais ; les versions précédentes restent
   lisibles sous des onglets. */
export async function getStaticPaths() {
  /* Les brouillons ne sortent pas du build. Ils restent lisibles en
     développement local, le temps de la relecture. */
  const toutes = await getCollection("livrable");
  const entries = import.meta.env.DEV ? toutes : toutes.filter((e) => !e.data.brouillon);
  const racines = entries.filter((e) => !e.data.versionDe);
  return racines.map((racine) => {
    const versions = [racine, ...entries.filter((e) => e.data.versionDe === racine.id)].sort(
      (a, b) => a.data.version - b.data.version,
    );
    return { params: { slug: racine.id }, props: { versions } };
  });
}

const { versions } = Astro.props;
const actif = versions.length - 1;
const courante = versions[actif].data;

const dateCourte = (d: Date) =>
  d.toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout
  title={`Livrable ${courante.titre} · Coolbeans`}
  description={`Livrable : ${courante.objet}`}
  noindex
>
  <DocumentTopbar />

  <!-- EN-TÊTE -->
  <header class="relative overflow-hidden bg-surface-subtle">
    <GridBackdrop />
    <div class="container-site relative pt-24x pb-16x text-center">
      <p class="label">Livrable</p>
      {
        versions.map((v, i) => (
          <div data-livrable-entete={i} hidden={i !== actif}>
            <h1 class="mx-auto mt-5 max-w-[18ch]">{v.data.titre}</h1>
            <p class="mx-auto mt-6 max-w-[62ch] text-xl leading-[1.45] font-medium text-balance">
              {v.data.objet}
            </p>
            <p class="mt-5 font-mono text-[12px] tracking-wide text-mute uppercase">
              Version {v.data.version} du {dateLongue(v.data.date)}
            </p>
            <a
              href={v.data.site.url}
              target="_blank"
              rel="noopener"
              class="btn btn-lg mt-8 inline-flex"
            >
              {v.data.site.label}
            </a>
          </div>
        ))
      }

      {
        versions.length > 1 && (
          <div class="mt-8 flex flex-wrap justify-center gap-2" role="tablist">
            {versions.map((v, i) => (
              <button
                type="button"
                role="tab"
                aria-pressed={i === actif}
                data-livrable-onglet={i}
                data-livrable-slug={v.id}
                class:list={[
                  "rounded-full px-3 py-1 text-[13px] font-semibold transition-colors duration-150 ease-in-out",
                  i === actif
                    ? "bg-ink text-surface"
                    : "text-mute hover:bg-surface-raise hover:text-ink",
                ]}
              >
                V{v.data.version} · {dateCourte(v.data.date)}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <!-- CORPS -->
  <div class="container-site">
    {
      versions.map((v, i) => (
        <div data-livrable-pane={i} hidden={i !== actif} class="mx-auto max-w-[880px] py-16x">
          {v.data.apercu && (
            <LivrableApercu
              bureau={v.data.apercu.bureau}
              mobile={v.data.apercu.mobile}
              url={v.data.apercu.url ?? v.data.site.url}
              titre={v.data.apercu.titre}
              legende={v.data.apercu.legende}
            />
          )}

          {v.data.video && (
            <div class:list={[v.data.apercu && "border-t border-line"]}>
              <LivrableVideo
                url={v.data.video.url}
                embed={v.data.video.embed}
                duree={v.data.video.duree}
                legende={v.data.video.legende}
              />
            </div>
          )}

          <div class:list={[(v.data.apercu || v.data.video) && "border-t border-line"]}>
            <CadrageIntro sections={v.data.sections} />
          </div>

          {v.data.parcours.length > 0 && (
            <LivrableParcours
              titre={v.data.parcoursTitre}
              etapes={v.data.parcours}
              replie={v.data.parcoursReplie}
            />
          )}

          {v.data.message && (
            <LivrableMessage
              titre={v.data.message.titre}
              objet={v.data.message.objet}
              corps={v.data.message.corps}
              note={v.data.message.note}
            />
          )}

          <LivrableSuite
            aVerifier={v.data.aVerifier}
            aVerifierTitre={v.data.aVerifierTitre}
            suite={v.data.suite}
            suiteTitre={v.data.suiteTitre}
            contact={v.data.contact}
          />

          {v.data.notes.length > 0 && (
            <div class="grid grid-cols-[180px_1fr] gap-10 border-t border-line pt-10 max-[700px]:grid-cols-1 max-[700px]:gap-4">
              <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">
                NB
              </p>
              <div class="flex max-w-[58ch] flex-col gap-3">
                {v.data.notes.map((note) => (
                  <Banner tone={note.tone}>
                    <Fragment set:html={riche(note.texte)} />
                    {note.tooltip && <Tooltip texte={note.tooltip} />}
                  </Banner>
                ))}
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>

  {
    courante.formulaire && (
      <LivrableReponse slug={versions[actif].id} tutoiement={courante.tutoiement} />
    )
  }

  <DevisFooter />
</BaseLayout>

<script>
  /* Onglets de versions, même mécanique que le devis : on bascule la
     visibilité, on ne recharge pas. Le slug du formulaire suit la version
     affichée, pour que la réponse s'étiquette avec la bonne version. */
  const onglets = document.querySelectorAll<HTMLButtonElement>("[data-livrable-onglet]");
  const form = document.querySelector<HTMLFormElement>("#livrable-form");

  onglets.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cible = btn.dataset.livrableOnglet;
      onglets.forEach((b) => {
        const actif = b.dataset.livrableOnglet === cible;
        b.setAttribute("aria-pressed", String(actif));
        b.classList.toggle("bg-ink", actif);
        b.classList.toggle("text-surface", actif);
        b.classList.toggle("text-mute", !actif);
        b.classList.toggle("hover:bg-surface-raise", !actif);
        b.classList.toggle("hover:text-ink", !actif);
      });
      document
        .querySelectorAll<HTMLElement>("[data-livrable-pane], [data-livrable-entete]")
        .forEach((el) => {
          el.hidden = (el.dataset.livrablePane ?? el.dataset.livrableEntete) !== cible;
        });
      if (form && btn.dataset.livrableSlug) form.dataset.slug = btn.dataset.livrableSlug;
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>
