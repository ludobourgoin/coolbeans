---
// « la doc » — rendu d'une page de doc de passation, derrière Clerk.
// /docs/<client>            → première page du client (order le plus bas)
// /docs/<client>/<slug>     → page correspondante (slug = id sans préfixe numérique)
//
// Rendu à la demande (pas de prerender) : une page prérendue contournerait le
// middleware Clerk. L'authentification est garantie par src/middleware.ts ;
// ici on ne vérifie que le droit d'accès au projet.
export const prerender = false;

import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import DocLayout from "../../../layouts/DocLayout.astro";
import Meta from "../../../components/doc/Meta.astro";
import { findWorkspaceByDoc } from "../../../lib/portail/workspaces";
import { WORKSPACE_COOKIE } from "../../../lib/portail/current-workspace";
import { getPortalContext, overrideCurrentWorkspace } from "../../../lib/portail/context";
import { isAdmin } from "../../../lib/portail/metadata";

type Doc = CollectionEntry<"docs">;
const slugOf = (e: Doc) => e.id.split("/").pop()!.replace(/^\d+-/, "");
const hrefOf = (e: Doc) => `/docs/${e.data.client}/${slugOf(e)}`;

// `client` (ligne 32) est le client courant du portail : le paramètre d'URL
// prend donc le nom `clientParam` pour éviter la collision.
const { client: clientParam, slug } = Astro.params;

// Droit d'accès : on voit la doc de son client courant. Pour un admin, le
// client courant est celui qu'il a choisi — ou celui que l'URL impose, voir
// juste en dessous — donc l'accès reste total sans clause d'exception.
//
// _template n'appartient à aucun client : il reste réservé aux admins par un
// test de rôle explicite.
const { meta, client } = await getPortalContext(Astro);
const isAdminUser = isAdmin(meta);

// L'URL gagne sur le sélecteur : un admin qui ouvre /docs/amusoire alors que
// son contexte est Coolbeans voit la page ET bascule dessus. Sans ça, le
// sélecteur afficherait un client pendant que l'écran en montre un autre.
// Une requête GET pose donc un cookie : ce n'est pas pur, mais il s'agit d'une
// préférence d'affichage, sans effet sur les données.
let effectif = client;
if (isAdminUser && clientParam && client?.doc !== clientParam) {
  const proprietaire = await findWorkspaceByDoc(clientParam);
  if (proprietaire) {
    Astro.cookies.set(WORKSPACE_COOKIE, proprietaire.slug, {
      path: "/",
      httpOnly: true,
      secure: true,
      sameSite: "lax",
      maxAge: 60 * 60 * 24 * 365,
    });
    overrideCurrentWorkspace(Astro, proprietaire);
    effectif = proprietaire;
  }
}

const allowed = clientParam === "_template" ? isAdminUser : effectif?.doc === clientParam;
if (!allowed) return Astro.redirect("/espace");

const entries = (await getCollection("docs", (e) => e.data.client === clientParam)).sort(
  (a, b) => a.data.order - b.data.order
);
if (entries.length === 0) return new Response(null, { status: 404 });

const entry = slug ? entries.find((e) => slugOf(e) === slug) : entries[0];
if (!entry) return new Response(null, { status: 404 });

const { Content, headings } = await render(entry);

const nav = entries.map((e) => ({
  title: e.data.title,
  href: hrefOf(e),
  active: e.id === entry.id,
}));
const idx = entries.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? { title: entries[idx - 1].data.title, href: hrefOf(entries[idx - 1]) } : null;
const next =
  idx < entries.length - 1
    ? { title: entries[idx + 1].data.title, href: hrefOf(entries[idx + 1]) }
    : null;

// Index de recherche client-side : titres + sections H2 + texte brut de chaque page.
const searchIndex = [];
for (const e of entries) {
  const { headings: hs } = await render(e);
  searchIndex.push({
    title: e.data.title,
    href: hrefOf(e),
    sections: hs.filter((h) => h.depth === 2).map((h) => ({ title: h.text, anchor: h.slug })),
    text: (e.body ?? "").toLowerCase(),
  });
}
---

<DocLayout
  title={entry.data.title}
  client={entry.data.client}
  nav={nav}
  headings={headings}
  prev={prev}
  next={next}
  searchIndex={searchIndex}
  pleineLargeur={entry.data.pleineLargeur}
>
  <h1>{entry.data.title}</h1>
  <Meta status={entry.data.status} updated={entry.data.updated} />
  <Content />
</DocLayout>
