---
// Ancienne adresse d'un ticket, encore présente dans les mails de réponse
// envoyés avant le 2026-09-29. 301 vers la même demande sous /demandes.
export const prerender = false;
import { portalHref } from "../../../lib/portail/nav";
const { id } = Astro.params;
return Astro.redirect(portalHref(`/demandes/${id ?? ""}`, Astro.url.hostname), 301);
