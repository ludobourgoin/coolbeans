---
// Page-souche « Monitoring » (section Mon site, spec sidebar 2026-08-14).
// Entrée `wip` du registre : invisible côté client tant que COO-15 (monitors
// UptimeRobot + clé read-only) n'est pas livré.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import EmptyState from "../../components/portail/EmptyState.astro";
import { missingKeysFor } from "../../lib/portail/workspaces";
import { getPortalContext } from "../../lib/portail/context";
import { isAdmin } from "../../lib/portail/metadata";

const { meta, client } = await getPortalContext(Astro);
const missingKeys = missingKeysFor("site", client);

Astro.response.headers.set("Cache-Control", "no-store");
---

<EspaceLayout title="Monitoring">
  <h1>Monitoring</h1>
  <p class="sub">Disponibilité et dernière vérification de votre site.</p>

  <EmptyState title="Bientôt disponible" missingKeys={missingKeys} isAdmin={isAdmin(meta)}>
    Le statut de votre site en production arrivera ici : disponible ou non, uptime sur 7, 30 et 90
    jours, et l'heure de la dernière vérification.
  </EmptyState>
</EspaceLayout>
