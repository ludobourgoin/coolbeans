---
// Hub Ressources (COO-37) : cards de liens statiques par catégorie, mise en
// page façon boîte à outils du site public (/tools), adaptée à l'idiome du
// portail (.cards/.card de doc.css).
//
// Seul module à ne dépendre d'aucun mapping publicMetadata : son contenu est
// commun à tous les clients. Les liens vivent dans src/data/ressources.ts,
// gérés par Coolbeans — aucune édition côté client.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import { ressourceCategories } from "../../data/ressources";

Astro.response.headers.set("Cache-Control", "no-store");
---

<EspaceLayout title="Ressources">
  <h1>Ressources</h1>
  <p class="sub">
    Les outils gratuits (ou presque) que nous recommandons pour gérer votre site au quotidien :
    images, vidéos, emails, mesure d'audience.
  </p>

  <nav class="res-anchors" aria-label="Catégories">
    {ressourceCategories.map((cat) => <a href={`#${cat.id}`}>{cat.title}</a>)}
  </nav>

  {
    ressourceCategories.map((cat) => (
      <section class="res-section" id={cat.id}>
        <h2>{cat.title}</h2>
        <div class="cards">
          {cat.cards.map((r) => (
            <a class="card" href={r.href} target="_blank" rel="noopener">
              <div class="k">{r.domain}</div>
              <div class="t">{r.name}</div>
              <div class="d">{r.desc}</div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</EspaceLayout>
