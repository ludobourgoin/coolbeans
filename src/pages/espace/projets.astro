---
// Page-souche du module « Projets » (tâche S0.7).
//
// Le shell de navigation se livre en S0 avec ses cinq entrées : chacune doit
// mener quelque part. Le module lui-même arrive en Sprint S1.
//
// L'encart de diagnostic n'est visible que des admins et sert dès maintenant :
// le runbook d'onboarding demande de vérifier les empty states de chaque
// module après avoir posé le publicMetadata d'un nouveau client.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import EmptyState from "../../components/portail/EmptyState.astro";
import { isAdmin, missingKeysFor } from "../../lib/portail/metadata";
import { getPortalMeta } from "../../lib/portail/context";

const meta = await getPortalMeta(Astro.locals);
const missingKeys = missingKeysFor("projets", meta);

Astro.response.headers.set("Cache-Control", "no-store");
---

<EspaceLayout title="Projets">
  <h1>Projets</h1>
  <p class="sub">Le module arrive au sprint S1.</p>

  <EmptyState title="Bientôt disponible" missingKeys={missingKeys} isAdmin={isAdmin(meta)}>
    Le suivi de vos projets arrivera ici : l'avancement de chaque chantier, colonne par colonne, et ce qui attend votre validation.
  </EmptyState>
</EspaceLayout>
