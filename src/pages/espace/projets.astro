---
// Page-souche du module « Projets ».
//
// Retour à l'état pré-S1 : le rendu du snapshot Asana livré au sprint S1 a été
// retiré (l'outil de gestion de projet est passé à Linear). Le module sera
// refait sur Linear dans un chantier séparé, une fois Linear paramétré.
//
// Le shell de navigation compte cinq entrées et chacune doit mener quelque
// part : la page reste, avec son empty state.
//
// L'encart de diagnostic n'est visible que des admins et sert dès maintenant :
// le runbook d'onboarding demande de vérifier les empty states de chaque
// module après avoir posé le publicMetadata d'un nouveau client.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import EmptyState from "../../components/portail/EmptyState.astro";
import { missingKeysFor } from "../../lib/portail/workspaces";
import { getPortalContext } from "../../lib/portail/context";
import { isAdmin } from "../../lib/portail/metadata";

const { meta, client } = await getPortalContext(Astro);
const missingKeys = missingKeysFor("projets", client);

Astro.response.headers.set("Cache-Control", "no-store");
---

<EspaceLayout title="Projets">
  <h1>Projets</h1>
  <p class="sub">Le module est en cours de refonte.</p>

  <EmptyState title="Bientôt disponible" missingKeys={missingKeys} isAdmin={isAdmin(meta)}>
    Le suivi de vos projets arrivera ici : l'avancement de chaque chantier, colonne par colonne, et ce qui attend votre validation.
  </EmptyState>
</EspaceLayout>
