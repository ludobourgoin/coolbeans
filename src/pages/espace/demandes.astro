---
// Demandes, ex-Messagerie (spec 2026-08-15-messagerie-portail-design.md §6,
// revue le 2026-09-29) : le formulaire de nouvelle demande s'affiche d'emblée,
// la liste des fils suit, façon boîte de réception. Un message = un sujet, la
// phrase pédagogique est le seul texte au-dessus du formulaire.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import EmptyState from "../../components/portail/EmptyState.astro";
import MessagerieBoard from "../../components/portail/MessagerieBoard.astro";
import NouvelleDemande from "../../components/portail/NouvelleDemande.astro";
import Collapse from "../../components/ui/Collapse.astro";
import { env } from "cloudflare:workers";
import { missingKeysFor, moduleCoupe } from "../../lib/portail/workspaces";
import { comptesDuWorkspace } from "../../lib/portail/comptes";
import { getPortalContext } from "../../lib/portail/context";
import { fetchIssueStateTypes } from "../../lib/portail/linear";
import { isAdmin } from "../../lib/portail/metadata";
import { statutFromStateType } from "../../lib/portail/messagerie/regles";
import { apercusDesTickets, ticketsDuClient } from "../../lib/portail/messagerie/store";

const { meta, client, user } = await getPortalContext(Astro);
const admin = isAdmin(meta);
const missingKeys = missingKeysFor("support", client);
// La nav masque déjà l'entrée quand la messagerie est coupée, mais l'URL reste
// atteignable à la main : la page doit donc tenir seule. Coupée, elle n'affiche
// aucun diagnostic admin — il n'y a rien à corriger, c'est un choix.
const coupe = moduleCoupe("support", client);
const indisponible = coupe || missingKeys.length > 0;
Astro.response.headers.set("Cache-Control", "no-store");

// Admin dans l'espace d'un client : le ticket peut partir au nom du client,
// sans liste de comptes à choisir (décision du 2026-09-29). Le compte retenu
// est le contact principal de la fiche (`prenom` du registre), sinon le
// premier compte de l'espace. L'admin lui-même, s'il est membre, est écarté.
// L'appartenance vient de la table `teamMember` depuis la bascule Better Auth.
let auNomDe: { client: string; compteId: string; destinataire: string } | undefined;
let clientSansCompte: string | undefined;
if (admin && client && !client.perso) {
  const comptes = (await comptesDuWorkspace(env.PORTAL_DB, client.slug)).filter(
    (c) => c.id !== user?.id,
  );
  const principal = client.prenom?.toLowerCase();
  const cible = comptes.find((c) => principal && c.prenom.toLowerCase() === principal) ?? comptes[0];
  if (cible) {
    auNomDe = {
      client: client.nom,
      compteId: cible.id,
      destinataire: cible.nom ? `${cible.nom} (${cible.email})` : cible.email,
    };
  } else {
    clientSansCompte = client.nom;
  }
}

let tickets: Awaited<ReturnType<typeof ticketsDuClient>> = [];
let apercus = new Map<string, Awaited<ReturnType<typeof apercusDesTickets>>[number]>();
let statuts = new Map<string, string>();
if (!indisponible && client) {
  tickets = await ticketsDuClient(env.PORTAL_DB, client.slug);
  apercus = new Map(
    (await apercusDesTickets(env.PORTAL_DB, client.slug)).map((a) => [a.ticket_id, a]),
  );
  const uuids = tickets.map((t) => t.linear_issue_uuid).filter((u): u is string => Boolean(u));
  try {
    if (env.LINEAR_API_KEY) statuts = await fetchIssueStateTypes(env.LINEAR_API_KEY, uuids);
  } catch (err) {
    console.error("messagerie: statuts Linear indisponibles, board sans statuts", err);
  }
}
const lignes = tickets.map((t) => ({
  ...t,
  statut: statutFromStateType(t.linear_issue_uuid ? statuts.get(t.linear_issue_uuid) : undefined),
  apercu: apercus.get(t.id),
}));
---

<EspaceLayout title="Demandes">
  <h1>Demandes</h1>
  <p class="sub">
    Un message = un sujet. Trois sujets&nbsp;? Trois demandes séparées : on vous répondra plus
    vite.
  </p>

  {
    indisponible ? (
      <EmptyState
        title="Bientôt disponible"
        missingKeys={coupe ? [] : missingKeys}
        isAdmin={isAdmin(meta)}
      >
        Vos demandes arriveront ici. En attendant, un email à ludo@coolbeans.cc fait tout aussi bien
        l'affaire.
      </EmptyState>
    ) : (
      <div class="mt-8x grid gap-10x">
        <NouvelleDemande auNomDe={auNomDe} clientSansCompte={clientSansCompte} />
        <section class="grid gap-4" aria-labelledby="vos-demandes">
          <h2 id="vos-demandes" class="flex items-baseline gap-2 text-lg font-semibold tracking-[-0.02em]">
            Vos demandes
            {lignes.length > 0 && (
              <span class="text-[14px] font-normal text-mute">{lignes.length}</span>
            )}
          </h2>
          <MessagerieBoard tickets={lignes} />
        </section>
      </div>
    )
  }

  {/* FAQ reprise de feu /espace/support (COO-32) — contenu par défaut, à affiner au fil de l'eau. */}
  <section class="mt-16x max-w-[640px]">
    <h2 class="mb-6x text-lg font-semibold tracking-[-0.02em]">Questions fréquentes</h2>
    <Collapse question="Comment bien formuler ma demande ?">
      Un message = un sujet. Si vous avez deux choses à signaler, envoyez deux demandes
      séparées : chacune suit son propre fil, rien ne se perd en route. Plus la description est
      concrète (la page concernée, ce que vous attendiez, ce qui s'est passé), plus la réponse
      est rapide.
    </Collapse>
    <Collapse question="Sous quel délai aurai-je une réponse ?">
      En général sous un jour ouvré. Si votre site est hors ligne ou qu'un paiement est
      bloqué, dites-le dans l'urgence de votre demande : ces urgences passent devant tout le
      reste.
    </Collapse>
    <Collapse question="Puis-je toujours passer par email ?">
      Bien sûr. Un message à
      <a class="link" href="mailto:ludo@coolbeans.cc">ludo@coolbeans.cc</a> fonctionne
      toujours. Une demande faite ici a simplement l'avantage d'arriver directement dans mon outil
      de suivi, avec un accusé de réception immédiat.
    </Collapse>
  </section>
</EspaceLayout>
