---
// Module Support (COO-28) : le formulaire crée un ticket dans la team Linear
// du client via /api/support, la FAQ répond aux questions d'usage avant
// qu'elles ne deviennent des tickets.
//
// Sans `linearTeamId` sur la fiche du client, l'empty state prend la place du
// formulaire — message accueillant côté client, diagnostic de mapping côté
// admin, comme sur les autres modules.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import EmptyState from "../../components/portail/EmptyState.astro";
import SupportForm from "../../components/portail/SupportForm.astro";
import Collapse from "../../components/ui/Collapse.astro";
import { missingKeysFor } from "../../lib/portail/clients";
import { getPortalContext } from "../../lib/portail/context";
import { isAdmin } from "../../lib/portail/metadata";

const { meta, client } = await getPortalContext(Astro);
const missingKeys = missingKeysFor("support", client);

Astro.response.headers.set("Cache-Control", "no-store");
---

<EspaceLayout title="Support">
  <h1>Support</h1>
  <p class="sub">
    Une question, un pépin sur votre site&nbsp;? Décrivez, votre demande part directement
    dans mon outil de suivi.
  </p>

  {
    missingKeys.length > 0 ? (
      <EmptyState title="Bientôt disponible" missingKeys={missingKeys} isAdmin={isAdmin(meta)}>
        Le formulaire de demande arrive ici. En attendant, un email à ludo@coolbeans.cc fait
        tout aussi bien l'affaire.
      </EmptyState>
    ) : (
      <SupportForm />
    )
  }

  {/* FAQ pré-remplie (COO-32) — contenu par défaut, à affiner au fil de l'eau. */}
  <section class="mt-16x max-w-[640px]">
    <h2 class="mb-6x text-lg font-semibold tracking-[-0.02em]">Questions fréquentes</h2>
    <Collapse question="Comment bien formuler ma demande ?">
      Une demande = un sujet. Si vous avez deux choses à signaler, envoyez deux demandes :
      chacune suit son propre fil, rien ne se perd en route. Plus la description est
      concrète — la page concernée, ce que vous attendiez, ce qui s'est passé — plus la
      réponse est rapide.
    </Collapse>
    <Collapse question="Sous quel délai aurai-je une réponse ?">
      En général sous un jour ouvré. Si votre site est hors ligne ou qu'un paiement est
      bloqué, dites-le dans l'objet : ces urgences passent devant tout le reste.
    </Collapse>
    <Collapse question="Puis-je toujours passer par email ?">
      Bien sûr. Un message à
      <a class="link" href="mailto:ludo@coolbeans.cc">ludo@coolbeans.cc</a> fonctionne
      toujours — le formulaire a simplement l'avantage d'arriver directement dans mon outil
      de suivi, avec un accusé de réception immédiat.
    </Collapse>
  </section>
</EspaceLayout>
