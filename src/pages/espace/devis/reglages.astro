---
export const prerender = false;

import EspaceLayout from "../../../layouts/EspaceLayout.astro";
import ReglagesEditor from "../../../components/chiffrage/ReglagesEditor";
import { getReglages } from "../../../lib/chiffrage/store";
import { getPortalContext } from "../../../lib/portail/context";
import { isAdmin } from "../../../lib/portail/metadata";

const { meta } = await getPortalContext(Astro);
if (!isAdmin(meta)) return Astro.redirect("/espace");

const reglages = await getReglages();
---

<EspaceLayout title="Réglages des devis">
  <p class="label">Pipeline commercial</p>
  <h1>Réglages</h1>
  <p class="sub">
    Source de vérité des prix, lue par la skill devis : TJM, coefficients et textes de
    base. Modifier un réglage ne change pas les devis déjà écrits.
    <a class="link" href="/espace/devis">← Tous les devis</a>
  </p>
  <ReglagesEditor client:load initial={reglages} />
</EspaceLayout>
