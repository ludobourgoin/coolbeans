---
export const prerender = false;

import EspaceLayout from "../../../layouts/EspaceLayout.astro";
import { getCollection } from "astro:content";
import { env } from "cloudflare:workers";
import DevisBoard from "../../../components/portail/DevisBoard.astro";
import { nomClient, type LigneDevis } from "../../../lib/devis/cockpit";
import { getPortalContext } from "../../../lib/portail/context";
import { isAdmin } from "../../../lib/portail/metadata";
import { listerReponses, type ReponseDevis } from "../../../lib/devis/reponses";
import {
  fetchEtatsAffaires,
  numeroAffaire,
  type EtatAffaire,
} from "../../../lib/portail/linear-crm";
import { dateLongue, montantAffiche, montantTri } from "../../../lib/devis";

const { meta } = await getPortalContext(Astro);
if (!isAdmin(meta)) return Astro.redirect("/espace");

const devis = (await getCollection("devis")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/* Gardé : si la migration devis_reponses n'est pas encore appliquée sur cet
   environnement, le cockpit s'affiche sans les réponses plutôt que de tomber
   en 500. */
let reponses: ReponseDevis[] = [];
try {
  reponses = await listerReponses();
} catch (err) {
  console.error("espace/devis: lecture des réponses D1 impossible", err);
}
/* listerReponses rend la dernière réponse de chaque slug. */
const parSlug = new Map(reponses.map((r) => [r.slug, r]));

/* Statut = état de l'affaire dans le pipeline CRM, et rien d'autre (décision
   du 2026-09-01). Une seule requête pour tous les devis affichés ; en cas de
   panne, la colonne vaut « — » partout et le tableau s'affiche quand même —
   même posture que la lecture D1 ci-dessus. */
const numeros = [
  ...new Set(
    devis.map((d) => numeroAffaire(d.data.linear?.affaire)).filter((n): n is number => n !== null),
  ),
];
let affaires = new Map<number, EtatAffaire>();
let crmIndisponible = false;
try {
  const apiKey = env.LINEAR_API_KEY;
  if (!apiKey) throw new Error("LINEAR_API_KEY absent de cet environnement");
  affaires = await fetchEtatsAffaires(apiKey, numeros);
} catch (err) {
  crmIndisponible = true;
  console.error("espace/devis: lecture du pipeline CRM impossible", err);
}

/* Nom lisible du client : le registre des workspaces quand il le connaît, le
   segment du slug remis en forme sinon. La plupart des clients de devis ne
   sont pas (encore) des workspaces du portail — un prospect n'en a pas. */
const clients = await getCollection("clients");
const nomsClients = new Map(clients.map((c) => [c.id, c.data.nom]));

/* D1 stocke datetime('now') en UTC « YYYY-MM-DD HH:MM:SS » : reconstituer une
   Date correcte avant de formater comme le reste de la page. */
const dateReponse = (createdAt: string) =>
  dateLongue(new Date(createdAt.replace(" ", "T") + "Z"));

const lignes: LigneDevis[] = devis.map((d) => {
  const reponse = parSlug.get(d.id);
  const affaire = affaires.get(numeroAffaire(d.data.linear?.affaire) ?? -1);
  return {
    slug: d.id,
    client: nomClient(d.id, nomsClients),
    titre: d.data.titre,
    objet: d.data.objet,
    montant: montantAffiche(d.data),
    montantTri: montantTri(d.data),
    date: d.data.date,
    dateLisible: dateLongue(d.data.date),
    envoi: d.data.envoi,
    envoiLisible: d.data.envoi ? dateLongue(d.data.envoi.date) : undefined,
    affaire,
    reponse,
    reponseLisible: reponse ? dateReponse(reponse.createdAt) : undefined,
    /* Absolue : sur my.coolbeans.cc le worker réécrit tout chemin relatif en
       /espace/<chemin>, et /espace/devis/<slug> n'existe pas. La page
       publique vit sur coolbeans.cc. */
    urlPublique: `https://coolbeans.cc/devis/${d.id}`,
    urlProjet: d.data.linear?.projet?.startsWith("http") ? d.data.linear.projet : undefined,
    /* L'URL de l'affaire vient de Linear quand on a pu la joindre : le YAML
       porte parfois l'identifiant court (« CRM-9 »), qui n'est pas un lien. */
    urlAffaire: affaire?.url ?? (d.data.linear?.affaire?.startsWith("http")
      ? d.data.linear.affaire
      : undefined),
  };
});

const sansAffaire = lignes.filter((l) => !l.affaire && !crmIndisponible).length;
---

<EspaceLayout title="Devis">
  <p class="label">Pipeline commercial</p>
  <h1>Devis</h1>
  <p class="sub">
    Le devis naît dans Linear (projet Proposal) et s'écrit via la skill devis — cette page ne fait
    que suivre. Le statut est celui de l'affaire dans la team CRM.
    <a class="link" href="/espace/devis/reglages">Réglages</a>
  </p>

  {crmIndisponible && (
    <p class="mt-6 rounded-card border border-warning/40 bg-warning/5 p-4 text-[13px] text-warning">
      Pipeline Linear injoignable : la colonne Statut est vide pour tous les devis. Le reste du
      tableau reste à jour.
    </p>
  )}

  {!crmIndisponible && sansAffaire > 0 && (
    <p class="mt-6 text-[13px] text-mute">
      {sansAffaire === 1
        ? "1 devis n'est rattaché à aucune affaire CRM et n'a donc pas de statut."
        : `${sansAffaire} devis ne sont rattachés à aucune affaire CRM et n'ont donc pas de statut.`}
    </p>
  )}

  <div class="mt-6">
    <DevisBoard lignes={lignes} crmIndisponible={crmIndisponible} />
  </div>
</EspaceLayout>
