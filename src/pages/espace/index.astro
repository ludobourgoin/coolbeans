---
// Accueil de l'espace client : une carte par module accessible.
// La grille reprend les entrées de la nav — la home est la même carte que le
// shell, en plus large. Le bloc A2HS dismissible s'y ajoutera en S3.5.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import { getPortalContext } from "../../lib/portail/context";
import { portalHref } from "../../lib/portail/nav";

const { user, meta, client } = await getPortalContext(Astro);
const admin = meta.role === "admin";
const prenom = user?.firstName ?? "";
const at = (path: string) => portalHref(path, Astro.url.hostname);

Astro.response.headers.set("Cache-Control", "no-store");
---

<EspaceLayout title="Espace client">
  <h1>Bonjour{prenom ? ` ${prenom}` : ""}.</h1>
  <p class="sub">Votre espace Coolbeans : documentation et services liés à votre projet.</p>

  <div class="cards">
    <a class="card" href={at("/projets")}>
      <div class="k">Projets</div>
      <div class="t">Où en sont vos chantiers</div>
      <div class="d">L'avancement colonne par colonne, et ce qui attend votre validation.</div>
    </a>
    <a class="card" href={at("/site")}>
      <div class="k">Mon site</div>
      <div class="t">La santé de votre site</div>
      <div class="d">Disponibilité, dernière vérification, statistiques d'audience.</div>
    </a>
    {
      client?.doc && (
        <a class="card" href={`/docs/${client.doc}`}>
          <div class="k">Doc</div>
          <div class="t">{client.nom} — passation & référence</div>
          <div class="d">Le document de vérité du projet : édition, leads, features, support.</div>
        </a>
      )
    }
    <a class="card" href={at("/ressources")}>
      <div class="k">Ressources</div>
      <div class="t">Guides et outils</div>
      <div class="d">Installer le portail sur votre téléphone, outils recommandés, FAQ.</div>
    </a>
    <a class="card" href={at("/support")}>
      <div class="k">Support</div>
      <div class="t">Demander quelque chose</div>
      <div class="d">Une demande, un sujet. Elle rejoint vos projets après validation.</div>
    </a>
    {
      admin && (
        <a class="card" href={at("/chiffrages")}>
          <div class="k">Interne</div>
          <div class="t">Chiffrages</div>
          <div class="d">Pilotage tarifaire : configurateur, devis publiés, historique.</div>
        </a>
      )
    }
    {
      admin && (
        <a class="card" href="/docs/_template">
          <div class="k">Doc · interne</div>
          <div class="t">Gabarit du standard</div>
          <div class="d">Le squelette vierge « la doc », visible des admins seulement.</div>
        </a>
      )
    }
  </div>
</EspaceLayout>
