---
// Cible de l'entrée « Mode d'emploi » quand l'utilisateur n'a aucun slug de
// doc (tâche S0.7). Un utilisateur correctement onboardé n'atterrit jamais
// ici : la nav pointe directement sur /docs/{slug}.
//
// Cette page existe pour que l'entrée ne soit ni un lien mort (/docs n'est pas
// une route) ni une entrée qui disparaît de la nav — auquel cas l'oubli de
// mapping ne se verrait nulle part.
export const prerender = false;

import EspaceLayout from "../../layouts/EspaceLayout.astro";
import EmptyState from "../../components/portail/EmptyState.astro";
import { missingKeysFor } from "../../lib/portail/workspaces";
import { getPortalContext } from "../../lib/portail/context";
import { isAdmin } from "../../lib/portail/metadata";

const { meta, client } = await getPortalContext(Astro);

// Posé avant la redirection : celle-ci dépend de l'utilisateur et ne doit pas
// être mise en cache par un intermédiaire.
Astro.response.headers.set("Cache-Control", "no-store");

// Le cas normal : le client courant a une doc, on y emmène.
if (client?.doc) {
  return Astro.redirect(`/docs/${client.doc}`, 302);
}
---

<EspaceLayout title="Mode d'emploi">
  <h1>Mode d'emploi</h1>
  <p class="sub">Le mode d'emploi du site.</p>

  <EmptyState
    title="Aucun mode d'emploi associé à cet espace"
    missingKeys={missingKeysFor("doc", client)}
    isAdmin={isAdmin(meta)}
  >
    Le mode d'emploi s'ouvre à la livraison du projet. S'il devrait être là,
    écrivez à ludo@coolbeans.cc.
  </EmptyState>
</EspaceLayout>
