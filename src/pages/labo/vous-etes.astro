---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Artefact from "../../components/segments/Artefact.astro";
import GridBackdrop from "../../components/GridBackdrop.astro";

// Page de comparaison, pas une page du site. Le bento contrasté est retenu :
// il s'agit maintenant de trancher les visuels et le traitement de la carte
// association. À supprimer avant le prochain merge staging vers main.

type Segment = {
  id: "agence" | "da" | "pme" | "tpe" | "ess";
  titre: string;
  texte: string;
};

const segments: Segment[] = [
  {
    id: "agence",
    titre: "Agence créative",
    texte:
      "Je me cale sur votre façon de travailler. En marque blanche, ou présent à vos réunions client comme un membre de votre équipe : vous choisissez. Je m'occupe de la partie technique à partir des maquettes.",
  },
  {
    id: "da",
    titre: "DA ou designer freelance",
    texte:
      "On travaille en binôme : vous la créa, moi la technique. Ni code, ni intégration, ni hébergement, ni web perfs, ni mises à jour à gérer de votre côté.",
  },
  {
    id: "pme",
    titre: "PME ou scale up",
    texte:
      "Votre site est un canal d'acquisition. On regarde ce qui bloque avant de redessiner quoi que ce soit.",
  },
  {
    id: "tpe",
    titre: "TPE ou solopreneur",
    texte:
      "Un site propre, en ligne en quelques jours. Vous me présentez votre activité, je m'occupe du reste.",
  },
  {
    id: "ess",
    titre: "Coopérative, association, intérêt général",
    texte:
      "Dites-le-moi au premier échange, j'adapte mes offres et mes tarifs à vos moyens. Le travail, lui, se passe comme avec n'importe quel autre client : même exigence, même suivi.",
  },
];

const parId = (id: Segment["id"]) => segments.find((s) => s.id === id)!;

const artefacts = [
  { id: "agence", objet: "Un badge visiteur vierge", dit: "la marque blanche, prise au mot" },
  { id: "da", objet: "Une maquette cotée", dit: "ce qu'un DA livre, et que personne ne respecte" },
  { id: "pme", objet: "Un entonnoir", dit: "ce qui entre, ce qui reste" },
  { id: "tpe", objet: "Un tampon daté", dit: "le délai, sans l'écrire" },
  { id: "ess", objet: "Une jauge de collecte", dit: "l'objet que ces structures manipulent" },
];

const CARTE = "carte-segment rounded-card transition-colors duration-200 ease-brand";
---

<BaseLayout
  title="Labo : bento « Vous êtes… »"
  description="Visuels et traitement de la carte association pour la section Vous êtes de l'accueil."
  noindex={true}
>
  <Nav />

  <header class="border-b border-line bg-surface-subtle py-14">
    <div class="container-site">
      <h1 class="max-w-[24ch] text-[clamp(32px,4vw,52px)] leading-[1.02] tracking-[-0.03em]">
        Bento « Vous êtes… »
      </h1>
      <p class="mt-5 max-w-[66ch] text-[17px] leading-[1.5] font-medium text-mute">
        Chaque carte porte maintenant un objet de son métier plutôt qu'un picto. Survolez une carte
        : l'objet se met à fonctionner. Plus bas, trois façons de démarquer la carte association.
      </p>
      <dl class="mt-8 grid grid-cols-5 gap-5 max-[900px]:grid-cols-2">
        {
          artefacts.map((a) => (
            <div class="border-l border-line-strong pl-4">
              <dt class="text-[15px] font-semibold">{a.objet}</dt>
              <dd class="mt-1 text-[14px] leading-[1.4] text-mute">{a.dit}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  {/* ------------------------------------------------------------- le bento */}
  <section class="border-b border-line py-16x">
    <div class="container-site">
      <h2 class="mb-8 text-[clamp(28px,3vw,40px)] tracking-[-0.03em]">Vous êtes…</h2>

      <div class="grid grid-cols-4 gap-3 max-[900px]:grid-cols-2 max-[680px]:grid-cols-1">
        {/* agence : la seule carte en encre pleine, elle ouvre la grille */}
        <article
          class:list={[
            CARTE,
            "col-span-2 row-span-2 flex flex-col bg-ink p-9 text-surface max-[900px]:row-span-1 max-[680px]:col-span-1",
          ]}
        >
          <div class="flex flex-1 items-center justify-center py-10">
            <Artefact type="agence" class="w-48 opacity-90" />
          </div>
          <div>
            <h3 class="text-[clamp(30px,3.2vw,42px)] leading-[0.98] tracking-[-0.03em]">
              {parId("agence").titre}
            </h3>
            <p class="mt-4 max-w-[38ch] text-[16px] leading-[1.5] font-medium text-pretty">
              {parId("agence").texte}
            </p>
          </div>
        </article>

        {/* da : texte à gauche, maquette cotée à droite */}
        <article
          class:list={[
            CARTE,
            "col-span-2 grid grid-cols-[1fr_auto] items-center gap-7 border border-line-strong p-8 max-[900px]:col-span-1 max-[520px]:grid-cols-1",
          ]}
        >
          <div>
            <h3 class="text-[24px] leading-[1.04] tracking-[-0.02em]">{parId("da").titre}</h3>
            <p class="mt-3 text-[15px] leading-[1.5] font-medium text-pretty text-mute">
              {parId("da").texte}
            </p>
          </div>
          <Artefact type="da" class="w-52 flex-none text-ink max-[520px]:w-44" />
        </article>

        {/* pme et tpe : objet en haut, texte en bas */}
        <article class:list={[CARTE, "flex flex-col border border-line-strong p-8"]}>
          <div class="flex flex-1 items-center py-4">
            <Artefact type="pme" class="w-44 text-ink" />
          </div>
          <div class="pt-6">
            <h3 class="text-[20px] leading-[1.06] tracking-[-0.02em]">{parId("pme").titre}</h3>
            <p class="mt-3 text-[15px] leading-[1.5] font-medium text-pretty text-mute">
              {parId("pme").texte}
            </p>
          </div>
        </article>

        <article class:list={[CARTE, "flex flex-col border border-line-strong p-8"]}>
          <div class="flex flex-1 items-center py-4">
            <Artefact type="tpe" class="w-40 text-ink" />
          </div>
          <div class="pt-6">
            <h3 class="text-[20px] leading-[1.06] tracking-[-0.02em]">{parId("tpe").titre}</h3>
            <p class="mt-3 text-[15px] leading-[1.5] font-medium text-pretty text-mute">
              {parId("tpe").texte}
            </p>
          </div>
        </article>
      </div>

      {/* la bande association : gris soutenu, le traitement retenu */}
      <article
        class:list={[
          CARTE,
          "mt-3 grid grid-cols-[1fr_auto] items-center gap-10 bg-surface-raise p-8 max-[820px]:grid-cols-1 max-[820px]:gap-7",
        ]}
      >
        <div>
          <h3 class="text-[20px] leading-[1.06] tracking-[-0.02em]">{parId("ess").titre}</h3>
          <p class="mt-2 max-w-[78ch] text-[15px] leading-[1.5] font-medium text-pretty text-mute">
            {parId("ess").texte}
          </p>
        </div>
        <Artefact type="ess" class="w-55 flex-none text-ink max-[820px]:w-full" />
      </article>
    </div>
  </section>

  {/* ------------------------------------------- les trois cartes associations */}
  <section class="py-16x">
    <div class="container-site">
      <div class="mb-10x max-w-[70ch]">
        <h2 class="text-[26px] tracking-[-0.02em]">La carte association</h2>
        <p class="mt-3 text-[15px] leading-[1.5] font-medium text-mute">
          Le gris de la version d'origine était trop proche du blanc pour se distinguer. Trois
          façons de la démarquer sans en faire une deuxième carte noire, qui volerait la vedette à
          la carte agence.
        </p>
      </div>

      <div class="flex flex-col gap-8">
        {/* 1 : le trait, pas la valeur */}
        <div>
          <p class="mb-3 text-[15px] font-semibold">1. Bordure encre sur fond blanc</p>
          <article
            class:list={[
              CARTE,
              "grid grid-cols-[1fr_auto] items-center gap-10 border-[1.5px] border-ink bg-surface p-8 max-[820px]:grid-cols-1 max-[820px]:gap-7",
            ]}
          >
            <div>
              <h3 class="text-[20px] leading-[1.06] tracking-[-0.02em]">{parId("ess").titre}</h3>
              <p
                class="mt-2 max-w-[78ch] text-[15px] leading-[1.5] font-medium text-pretty text-mute"
              >
                {parId("ess").texte}
              </p>
            </div>
            <Artefact type="ess" class="w-55 flex-none text-ink max-[820px]:w-full" />
          </article>
        </div>

        {/* 2 : le motif de grille maison */}
        <div>
          <p class="mb-3 text-[15px] font-semibold">
            2. Fond tramé, le motif de grille déjà présent dans le hero
          </p>
          <article
            class:list={[
              CARTE,
              "relative isolate grid grid-cols-[1fr_auto] items-center gap-10 overflow-hidden border border-line-strong bg-surface p-8 max-[820px]:grid-cols-1 max-[820px]:gap-7",
            ]}
          >
            <GridBackdrop />
            <div class="relative">
              <h3 class="text-[20px] leading-[1.06] tracking-[-0.02em]">{parId("ess").titre}</h3>
              <p
                class="mt-2 max-w-[78ch] text-[15px] leading-[1.5] font-medium text-pretty text-mute"
              >
                {parId("ess").texte}
              </p>
            </div>
            <Artefact type="ess" class="relative w-55 flex-none text-ink max-[820px]:w-full" />
          </article>
        </div>

        {/* 3 : le gris du survol, soutenu */}
        <div>
          <p class="mb-3 text-[15px] font-semibold">3. Gris soutenu, le correctif minimal</p>
          <article
            class:list={[
              CARTE,
              "grid grid-cols-[1fr_auto] items-center gap-10 bg-surface-raise p-8 max-[820px]:grid-cols-1 max-[820px]:gap-7",
            ]}
          >
            <div>
              <h3 class="text-[20px] leading-[1.06] tracking-[-0.02em]">{parId("ess").titre}</h3>
              <p
                class="mt-2 max-w-[78ch] text-[15px] leading-[1.5] font-medium text-pretty text-mute"
              >
                {parId("ess").texte}
              </p>
            </div>
            <Artefact type="ess" class="w-55 flex-none text-ink max-[820px]:w-full" />
          </article>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
