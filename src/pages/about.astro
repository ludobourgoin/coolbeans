---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import GridBackdrop from "../components/GridBackdrop.astro";
import { proofPrimary, proofSecondary } from "../data/logos";
---

<BaseLayout
  title="À propos — Coolbeans, studio web par Ludovic Bourgoin"
  description="Développement, stratégie et performance : l'approche de Ludovic Bourgoin pour des sites qui convertissent et tiennent dans le temps. Studio basé à Sète."
>
  <Nav />

  <!-- HERO -->
  <section class="relative overflow-hidden bg-surface-subtle">
    <GridBackdrop />
    <div class="container-site relative pt-24x pb-14 text-center">
      <h1 class="mx-auto max-w-[20ch]">Développement, stratégie, performance.</h1>
      <p class="mx-auto mt-8 max-w-[60ch] text-xl leading-[1.45] font-medium">
        Une approche technique et stratégique pour des sites qui <b class="font-bold"
          >convertissent</b
        >, des intégrations qui <b class="font-bold">tiennent dans le temps</b>, et un partenaire
        qui <b class="font-bold">reste après la livraison</b>.
      </p>
      <div class="mt-11 flex flex-wrap justify-center gap-5">
        <a class="btn" href="/contact">Discuter de votre projet</a>
        <a class="btn btn-outline" href="/tools">La boîte à outils</a>
      </div>
    </div>
  </section>

  <!-- PROOF · stack -->
  <section class="bg-surface-subtle">
    <div class="container-site flex flex-col gap-7 py-10">
      <LogoMarquee logos={proofPrimary} reverse />
      <LogoMarquee logos={proofSecondary} />
    </div>
  </section>

  <!-- INTRO Ludovic -->
  <section class="bg-surface-subtle">
    <div
      class="container-site grid grid-cols-[1.1fr_1fr] items-start gap-20 py-24x max-[1100px]:grid-cols-1 max-[1100px]:gap-8"
    >
      <div>
        <h2 class="mb-7">Je suis Ludovic Bourgoin,<br />j'ai créé coolbeans.</h2>
        <p class="mb-4 max-w-[50ch] text-lg leading-[1.55]">
          Hello, je suis <b class="font-bold">développeur web freelance</b>, basé à Sète.
        </p>
        <p class="mb-4 max-w-[54ch] leading-[1.6]">
          Diplômé d'un double master en <b class="font-bold">marketing stratégique</b> et
          <b class="font-bold">communication digitale</b>, j'ai bifurqué après une formation
          intensive au développement web. J'y ai trouvé mon terrain de jeu idéal : un endroit où la <b
            class="font-bold">créativité visuelle</b
          >, la <b class="font-bold">rigueur technique</b> et les
          <b class="font-bold">enjeux business</b> se rencontrent.
        </p>
        <p class="mb-4 max-w-[54ch] leading-[1.6]">
          Cette complémentarité me permet aujourd'hui de concevoir des sites et des applications :
        </p>
        <ul class="my-6 flex list-none flex-col gap-3.5">
          <li class="grid grid-cols-[22px_1fr] items-start gap-3.5">
            <span class="mt-[0.18em] flex w-5.5 justify-center text-ink"
              ><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="block size-5"
                ><path
                  d="M12 2.5 21.5 12 12 21.5 2.5 12Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"></path></svg
              ></span
            >
            <span class="max-w-[40ch] text-balance"
              >À la fois <b class="font-bold">techniques et stratégiques</b>, conçus pour servir vos
              vrais objectifs</span
            >
          </li>
          <li class="grid grid-cols-[22px_1fr] items-start gap-3.5">
            <span class="mt-[0.18em] flex w-5.5 justify-center text-ink"
              ><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="block size-5"
                ><path
                  d="M12 20.5V5M5.5 11.5 12 5l6.5 6.5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                  stroke-linecap="round"></path></svg
              ></span
            >
            <span class="max-w-[40ch] text-balance"
              ><b class="font-bold">Rapides, fiables et évolutifs</b>, sur une stack choisie pour
              vos besoins</span
            >
          </li>
          <li class="grid grid-cols-[22px_1fr] items-start gap-3.5">
            <span class="mt-[0.18em] flex w-5.5 justify-center text-ink"
              ><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="block size-5"
                ><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"
                ></circle><circle cx="12" cy="12" r="2.6" fill="currentColor"></circle></svg
              ></span
            >
            <span class="max-w-[40ch] text-balance"
              ><b class="font-bold">Orientés résultats</b> : visibilité, conversion, croissance et autonomie</span
            >
          </li>
        </ul>
        <p class="mb-4 max-w-[54ch] leading-[1.6]">
          Je suis passionné par mon métier, j'adore le challenge et l'entrepreneuriat.
        </p>
        <div class="mt-7">
          <a
            class="link"
            href="https://linkedin.com/in/ludovicbourgoin"
            target="_blank"
            rel="noopener">LinkedIn ↗</a
          >
        </div>
      </div>
      <div class="relative aspect-4/5 overflow-hidden border border-line bg-surface-raise">
        <img
          src="/img/ludovic-about.jpg"
          alt="ludovic bourgoin, fondateur de coolbeans"
          class="absolute inset-0 size-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- APPROCHE · bénéfices -->
  <section class="py-24x">
    <div class="container-site">
      <div
        class="mb-14 grid grid-cols-[1.1fr_1fr] items-start gap-16 max-[1100px]:grid-cols-1 max-[1100px]:gap-8"
      >
        <h2>Un accompagnement stratégique, de l'architecture à la mise en ligne.</h2>
        <div>
          <p class="max-w-[50ch] leading-[1.6]">
            Au-delà du développement, <b class="font-bold"
              >je vous accompagne dans la réflexion stratégique de votre projet web</b
            >. Chaque choix technique est pensé pour maximiser vos résultats et votre autonomie
            future.
          </p>
          <p class="mt-3.5 max-w-[50ch] leading-[1.6]">
            Votre design devient réalité avec <b class="font-bold"
              >un site performant, évolutif et conforme à vos attentes</b
            >. Une intégration rigoureuse où chaque détail compte pour un résultat qui dure.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 max-[1100px]:grid-cols-1">
        <div
          class="grid grid-cols-[48px_1fr] items-start gap-5 border-r border-b border-line py-8 pr-8 max-[1100px]:border-r-0 max-[1100px]:pr-0"
        >
          <div
            class="label flex size-12 min-w-0 items-center justify-center border border-ink text-[13px] text-ink"
          >
            01
          </div>
          <div class="min-w-0">
            <h3 class="mb-2.5">Un expert technique orienté résultats</h3>
            <p class="max-w-[48ch] text-[15px] leading-[1.55]">
              Capable d'analyser vos enjeux, de challenger vos choix et de vous orienter vers la
              stack la plus adaptée à votre cas. Chaque décision technique a une justification pour
              votre projet.
            </p>
          </div>
        </div>
        <div
          class="grid grid-cols-[48px_1fr] items-start gap-5 border-b border-line py-8 pl-8 max-[1100px]:pl-0"
        >
          <div
            class="label flex size-12 min-w-0 items-center justify-center border border-ink text-[13px] text-ink"
          >
            02
          </div>
          <div class="min-w-0">
            <h3 class="mb-2.5">Une exigence de performance</h3>
            <p class="max-w-[48ch] text-[15px] leading-[1.55]">
              Architecture pensée pour la <b class="font-bold"
                >performance, l'évolutivité et l'impact mesurable</b
              > sur vos objectifs. SEO technique, accessibilité, performances web excellentes. Et des
              sites IA-ready : trouvés sur Google comme dans les réponses des IA.
            </p>
          </div>
        </div>
        <div
          class="grid grid-cols-[48px_1fr] items-start gap-5 border-r border-line py-8 pr-8 max-[1100px]:border-r-0 max-[1100px]:pr-0"
        >
          <div
            class="label flex size-12 min-w-0 items-center justify-center border border-ink text-[13px] text-ink"
          >
            03
          </div>
          <div class="min-w-0">
            <h3 class="mb-2.5">Un site aligné sur votre stratégie</h3>
            <p class="max-w-[48ch] text-[15px] leading-[1.55]">
              Conçu pour <b class="font-bold">convertir, fidéliser et soutenir votre croissance</b>.
              Tunnels de conversion mesurés, CMS qui sert vraiment l'équipe éditoriale, fondations
              qui supportent vos campagnes acquisition.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-[48px_1fr] items-start gap-5 py-8 pl-8 max-[1100px]:pl-0">
          <div
            class="label flex size-12 min-w-0 items-center justify-center border border-ink text-[13px] text-ink"
          >
            04
          </div>
          <div class="min-w-0">
            <h3 class="mb-2.5">Un partenariat dans la durée</h3>
            <p class="max-w-[48ch] text-[15px] leading-[1.55]">
              Vous possédez vos comptes dès le premier jour : le code, le contenu et l'hébergement
              sont à vous. Je garde un accès de gestion que vous pouvez révoquer quand vous voulez,
              et je m'occupe de la maintenance tant que vous le souhaitez.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRIGGER -->
  <section>
    <div
      class="container-site grid grid-cols-2 items-center gap-20 py-24x max-[1100px]:grid-cols-1 max-[1100px]:gap-8"
    >
      <div class="relative aspect-4/3 border border-line bg-surface-raise">
        <img
          class="absolute inset-0 size-full object-cover object-[center_38%]"
          src="/img/trigger-team.jpg"
          alt="l'équipe de l'agence trigger à toulouse"
        />
        <img
          class="absolute -top-7 left-15.5 z-2 size-37.5 rotate-[-8deg] drop-shadow-[0_6px_18px_rgba(0,0,0,0.28)] max-[1100px]:-top-5.5 max-[1100px]:left-12.5 max-[1100px]:size-29.5"
          src="/img/trigger-logo.webp"
          alt="logo trigger"
        />
      </div>
      <div>
        <h2 class="mb-6 max-w-[20ch]">Je fais aussi partie de l'agence Trigger à Toulouse.</h2>
        <p class="mb-6 max-w-[50ch] leading-[1.6]">
          Membre de l'agence <b class="font-bold">Trigger</b>, j'interviens notamment sur la{" "}
          <b class="font-bold">création de landing pages</b> pour les clients de l'agence.
        </p>
        <a class="btn btn-ghost" href="https://trigger.fr" target="_blank" rel="noopener"
          >Accéder à Trigger ↗</a
        >
      </div>
    </div>
  </section>

  <CtaBand
    title="Un projet web en tête ?"
    text="Une idée à développer, une maquette à intégrer, un besoin à clarifier ? Voyons si je suis la bonne personne pour votre projet."
    ctaLabel="Discuter de votre projet"
    secondaryLabel="Voir la boîte à outils"
    secondaryHref="/tools"
  />

  <Footer />
</BaseLayout>
