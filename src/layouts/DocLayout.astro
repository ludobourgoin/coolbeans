---
// « la doc » — délègue la coquille 3 colonnes à PortalLayout (COO-80) : la
// sidebar globale liste déjà les pages du client (section Documentation) et
// la colonne d'ancres se construit côté client. Ne restent ici que le titre,
// l'index de recherche et le pied de page précédent/suivant.
//
// `nav` et `headings` restent acceptés pour ne pas casser la route qui les
// calcule encore, mais la coquille n'en a plus besoin.
import PortalLayout from "./PortalLayout.astro";

interface NavItem {
  title: string;
  href: string;
  active: boolean;
}
interface PrevNext {
  title: string;
  href: string;
}
interface SearchEntry {
  title: string;
  href: string;
  sections: { title: string; anchor: string }[];
  text: string;
}
interface Props {
  title: string;
  client: string;
  nav?: NavItem[];
  headings?: { depth: number; slug: string; text: string }[];
  prev: PrevNext | null;
  next: PrevNext | null;
  searchIndex: SearchEntry[];
}
const { title, client, prev, next, searchIndex } = Astro.props;
const clientLabel = client.charAt(0).toUpperCase() + client.slice(1);
---

<PortalLayout
  title={`${title} · la doc — ${clientLabel}`}
  description={`Documentation de passation ${clientLabel}`}
  mainClass="doc-main"
  searchIndex={searchIndex}
>
  <slot />
  <footer class="doc-pagefoot">
    <div class="pf-nav">
      {
        prev ? (
          <a class="pf-card" href={prev.href}>
            <span class="lab">← Précédent</span>
            <span class="ttl">{prev.title}</span>
          </a>
        ) : (
          <span class="pf-card empty" />
        )
      }
      {
        next ? (
          <a class="pf-card next" href={next.href}>
            <span class="lab">Suivant →</span>
            <span class="ttl">{next.title}</span>
          </a>
        ) : (
          <span class="pf-card empty" />
        )
      }
    </div>
  </footer>
</PortalLayout>
