---
// Espace client Coolbeans — délègue toute la coquille (topbar, sidebar,
// colonne d'ancres) à PortalLayout (COO-80). Ne reste ici que le suffixe de
// titre et la classe de contenu.
import PortalLayout from "./PortalLayout.astro";

interface Props {
  title: string;
  /** Pour les pages de l'espace bâties sur un tableau large (cockpit devis,
      monitoring, clients) : libère la max-width du bloc contenu. */
  pleineLargeur?: boolean;
}
const { title, pleineLargeur = false } = Astro.props;
---

<PortalLayout
  title={`${title} · Coolbeans`}
  description="Espace client Coolbeans"
  mainClass="espace-main"
  pleineLargeur={pleineLargeur}
>
  <slot />
</PortalLayout>
