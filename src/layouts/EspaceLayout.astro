---
// Espace client Coolbeans : topbar commune (PortalNav) au-dessus des pages
// protégées. La doc a son propre layout (DocLayout) avec la même topbar.
//
// Le layout lit lui-même le publicMetadata : la nav dépend du rôle (entrées
// admin) et des slugs de doc, et aucune page ne doit avoir à le repasser.
import BaseLayout from "./BaseLayout.astro";
import PortalNav from "../components/portail/PortalNav.astro";
import { readPortalMetadata, type PortalMetadata } from "../lib/portail/metadata";
import "../styles/doc.css";

interface Props {
  title: string;
}
const { title } = Astro.props;

const user = await Astro.locals.currentUser();
const meta: PortalMetadata = readPortalMetadata(user?.publicMetadata);
---

<BaseLayout title={`${title} · Coolbeans`} description="Espace client Coolbeans" noindex>
  <div class="doc-root">
    <PortalNav meta={meta} />
    <main class="espace-main">
      <slot />
    </main>
  </div>
</BaseLayout>
