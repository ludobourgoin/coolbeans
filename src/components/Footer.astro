---
const year = 2026;

// contenu conservé du footer précédent, réorganisé en colonnes.
// Les libellés reprennent ceux de Nav.astro : « Boîte à outils » et « Se
// connecter », pas « Tools » ni « Espace client ». Deux noms pour la même page
// font douter qu'il s'agisse de la même page.
const exploreLinks = [
  { href: "/", label: "Accueil" },
  { href: "/about", label: "À propos" },
  { href: "/tools", label: "Boîte à outils" },
  { href: "/connexion", label: "Se connecter" },
];
---

{
  /* theme-invert : le footer porte le thème opposé à celui de la page (sombre
     en clair, clair en sombre). La bascule est entièrement dans les tokens,
     voir la couche sémantique de global.css, d'où des utilitaires inchangés
     ici. Seules exceptions plus bas : les deux wordmarks, dont les variantes
     `dark:` suivent la classe .dark de <html> et pas les tokens, donc croisées
     à la main. */
}
<footer class="theme-invert border-t border-line bg-surface-raise">
  <div
    class="container-site grid grid-cols-1 gap-10 py-16 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-12 lg:grid-cols-[1fr_auto_1.5fr] lg:gap-x-20 lg:gap-y-10"
  >
    <div class="sm:col-span-2 lg:col-span-1">
      <a href="/" aria-label="coolbeans, accueil" class="inline-flex items-center leading-0">
        <img
          class="hidden h-5.5 w-auto dark:block"
          src="/img/coolbeans-wordmark.svg"
          alt="coolbeans"
          height="22"
        />
        <img
          class="block h-5.5 w-auto dark:hidden"
          src="/img/coolbeans-wordmark-white.svg"
          alt="coolbeans"
          height="22"
        />
      </a>
      <p class="mt-4 max-w-[42ch] text-sm leading-[1.65] text-mute">
        Studio web indépendant, basé à Sète.<br />
        Design, développement, maintenance.
      </p>
    </div>

    <div class="flex gap-10 sm:col-span-2 lg:col-span-1">
      <nav aria-label="explorer">
        <h4 class="text-sm font-medium text-ink">Explorer</h4>
        <ul class="mt-4 flex flex-col gap-3">
          {
            exploreLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-mute transition-colors duration-150 ease-in-out hover:text-ink"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="contact">
        <h4 class="text-sm font-medium text-ink">Contact</h4>
        <ul class="mt-4 flex flex-col gap-3">
          <li>
            <a
              href="/contact"
              class="text-sm text-mute transition-colors duration-150 ease-in-out hover:text-ink"
            >
              Discuter d'un projet
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/ludovicbourgoin"
              target="_blank"
              rel="noopener"
              class="text-sm text-mute transition-colors duration-150 ease-in-out hover:text-ink"
            >
              LinkedIn ↗
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="sm:col-span-2 lg:col-span-1 lg:justify-self-end">
      <h4 class="text-sm font-medium text-ink">Newsletter</h4>
      <p class="mt-4 max-w-[36ch] text-sm text-mute">
        Conseils et recommandations sur le web design, la perf web et l'IA. Une fois par mois,
        désinscription en un clic.
      </p>
      <form
        id="footer-newsletter-form"
        method="post"
        action="/api/newsletter"
        class="mt-4 flex w-full max-w-88 items-center gap-2 rounded-full border border-line bg-surface py-1 pr-1 pl-4 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-(--focus)"
      >
        <label for="footer-newsletter-email" class="sr-only">adresse e-mail</label>
        <input
          id="footer-newsletter-email"
          type="email"
          name="email"
          autocomplete="email"
          required
          placeholder="vous@exemple.com"
          class="field h-8 min-w-0 flex-1 border-0 bg-transparent px-0 text-sm focus:shadow-none"
        />
        {
          /* Champ piège. `hidden` plutôt qu'une classe visuelle : il ne doit
             être ni vu, ni lu par un lecteur d'écran, ni atteint au clavier.
             tabindex="-1" et autocomplete="off" évitent qu'un gestionnaire de
             mots de passe le remplisse à la place d'un robot. */
        }
        <input
          type="text"
          name="website"
          hidden
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <button type="submit" class="btn btn-sm shrink-0 rounded-full px-4">S'abonner</button>
      </form>
      {
        /* Retour d'état. aria-live pour que le résultat soit annoncé : la
           personne qui vient de valider au clavier ne voit pas le message
           apparaître sous le champ. */
      }
      <p
        id="footer-newsletter-message"
        role="status"
        aria-live="polite"
        class="mt-3 max-w-[36ch] text-sm text-mute empty:mt-0"
      >
      </p>
    </div>
  </div>

  <div class="container-site flex items-center justify-between gap-4 pt-14 pb-10">
    <p class="text-sm text-mute">
      © {year} Coolbeans, Ludovic Bourgoin ·{" "}
      <a
        href="/mentions-legales"
        class="text-mute transition-colors duration-150 ease-in-out hover:text-ink"
      >
        Mentions légales
      </a>
    </p>
    <a
      href="https://linkedin.com/in/ludovicbourgoin"
      target="_blank"
      rel="noopener"
      aria-label="linkedin"
      class="text-mute transition-colors duration-150 ease-in-out hover:text-ink"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM8.34 18.34H5.67V9.75h2.67v8.59zM7 8.6a1.55 1.55 0 1 1 0-3.1 1.55 1.55 0 0 1 0 3.1zM18.34 18.34h-2.67v-4.2c0-1-.02-2.29-1.4-2.29-1.4 0-1.61 1.09-1.61 2.22v4.27H10V9.75h2.56v1.17h.04c.36-.68 1.23-1.4 2.53-1.4 2.7 0 3.21 1.78 3.21 4.09v4.73z"
        ></path>
      </svg>
    </a>
  </div>
</footer>

<script is:inline>
  (function () {
    var form = document.getElementById("footer-newsletter-form");
    var message = document.getElementById("footer-newsletter-message");
    if (!form || !message) return;

    var bouton = form.querySelector('button[type="submit"]');
    var champ = form.querySelector('input[name="email"]');
    var piege = form.querySelector('input[name="website"]');

    form.addEventListener("submit", function (e) {
      // Le <form> garde method et action : sans JS il poste quand même, et
      // l'endpoint répond du JSON plutôt que rien. Avec JS, on reste en place.
      e.preventDefault();
      if (bouton.disabled) return;

      bouton.disabled = true;
      message.textContent = "";

      fetch("/api/newsletter", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email: champ.value, website: piege ? piege.value : "" }),
      })
        .then(function (r) {
          return r.json().then(function (corps) {
            return { ok: r.ok, corps: corps };
          });
        })
        .then(function (res) {
          if (res.ok) {
            form.hidden = true;
            message.textContent = "C'est noté, tu es abonné.";
          } else {
            message.textContent = res.corps.error || "Inscription impossible pour le moment.";
            bouton.disabled = false;
          }
        })
        .catch(function () {
          message.textContent = "Inscription impossible pour le moment.";
          bouton.disabled = false;
        });
    });
  })();
</script>
