---
import type { CollectionEntry } from "astro:content";
import Banner from "../../ui/Banner.astro";
import Tooltip from "../../ui/Tooltip.astro";
import CadrageIntro from "../../cadrage/CadrageIntro.astro";
import TemoignageCasClient from "../../temoignage/TemoignageCasClient.astro";
import TemoignageFormulaire from "../../temoignage/TemoignageFormulaire.astro";
import DevisFooter from "../../devis/DevisFooter.astro";
import DocumentReponses from "../../devis/DocumentReponses.astro";
import DocumentEntete from "../DocumentEntete.astro";
import DocumentVolet from "../DocumentVolet.astro";
import BandeauAcces from "../BandeauAcces.astro";
import { riche, ancreSection } from "../../../lib/devis";
import { ligneDate, titreEntete } from "../../../lib/documents/entete";
import { sectionsTemoignage } from "../../../lib/documents/sections";
import { tutoiementDe } from "../../../lib/documents/pronom-contenu";
import type { Bandeau } from "../../../lib/documents/acces";
import type { Pastille } from "../../../lib/documents/frise";

interface Props {
  versions: CollectionEntry<"temoignage">[];
  pastilles: Pastille[];
  contexte: "public" | "projet";
  /** Préfixe des id sur la page projet. Vide ailleurs. */
  prefixe?: string;
  /** Id de la version à ouvrir, lu dans ?version=. Inconnu ou absent : la dernière. */
  versionActive?: string;
  /** Par id d'entrée : ce que le client ne voit pas. Portail et admin seulement. */
  bandeaux?: Record<string, Bandeau>;
}
const { versions, pastilles, contexte, prefixe = "", versionActive, bandeaux = {} } = Astro.props;
const entry = versions[0];
const d = entry.data;
const tutoiement = await tutoiementDe("temoignage", entry.id);
---

{bandeaux[versions[0].id] && <BandeauAcces raison={bandeaux[versions[0].id]} />}

<DocumentEntete
  etape={d.etape}
  titre={titreEntete(d)}
  frise={pastilles}
  onglets={[]}
  actif={0}
  contexte={contexte}
  prefixe={prefixe}
/>

<DocumentVolet
  index={0}
  actif={0}
  total={1}
  titre={d.titre}
  objet={d.objet}
  date={ligneDate({ date: d.date, version: 1 }, false, "Document")}
  sections={sectionsTemoignage(d)}
  prefixe={prefixe}
>
  <div class="container-site">
    <div class="mx-auto max-w-[880px] py-16x">
      <CadrageIntro sections={d.intro} />

      {d.casClient && (
        <TemoignageCasClient
          titre={d.casClient.titre}
          texte={d.casClient.texte}
          slug={d.casClient.slug}
          label={d.casClient.label}
          fauxTexte={d.casClient.fauxTexte}
          tutoiement={tutoiement}
          ancre={ancreSection(d.casClient.titre)}
        />
      )}

      {d.notes.length > 0 && (
        <div class="mt-16x grid grid-cols-[180px_1fr] gap-10 border-t border-line pt-10 max-[700px]:grid-cols-1 max-[700px]:gap-4">
          <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">NB</p>
          <div class="flex max-w-[58ch] flex-col gap-3">
            {d.notes.map((note) => (
              <Banner tone={note.tone}>
                <Fragment set:html={riche(note.texte)} />
                {note.tooltip && <Tooltip texte={note.tooltip} />}
              </Banner>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</DocumentVolet>

<DocumentReponses
  server:defer
  type="temoignage"
  versions={[{ slug: entry.id, version: 1 }]}
  tutoiement={tutoiement}
  prefixe={prefixe}
/>

{
  /* Formulaire coupé une fois le témoignage reçu : la page devient une
     trace, et rien n'invite à répondre deux fois. Même mécanique que le
     livrable validé. */
  d.formulaire && (
    <TemoignageFormulaire
      slug={entry.id}
      questions={d.questions}
      tutoiement={tutoiement}
      photo={d.photo}
    />
  )
}

<DevisFooter />
