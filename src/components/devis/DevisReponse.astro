---
// Formulaire de réponse au devis (valider / question) des devis YAML
// ([slug].astro). La réponse part en D1 puis en notification mail.
import Choicebox from "../ui/Choicebox.astro";

interface Props {
  slug: string; // identifiant envoyé dans l'email via /api/devis-reponse
  /* Devis en construction (budget.enAttente) : il n'y a pas de montant, donc
     rien à valider. Proposer « je valide cette proposition » sur un document
     sans prix ferait signer un engagement vide — le formulaire se replie sur
     la seule réponse qui ait du sens, et les champs de facturation avec. */
  enAttente?: boolean;
}
const { slug, enAttente = false } = Astro.props;
---

<!-- RÉPONSE -->
<section class="border-t border-line bg-surface-subtle">
  <div class="container-site py-24x">
    <!-- Même grille que le corps du devis (DevisCorps : bloc 880, colonne de
         libellés 180, gouttière 40) : sans elle, le formulaire se centrait sur
         l'axe de la page quand le corps du devis, lui, est décalé de 110 px à
         droite par sa colonne de libellés. L'œil lisait une rupture de 100 px
         au passage d'un bloc à l'autre. -->
    <div
      class="mx-auto grid max-w-[880px] grid-cols-[180px_1fr] gap-10 max-[700px]:grid-cols-1 max-[700px]:gap-4"
    >
      <!-- Colonne de libellés laissée vide : elle ne sert ici qu'à caler le
           formulaire sur la grille du corps du devis. -->
      <div aria-hidden="true"></div>
      <div>
        <h2>Répondre à cette proposition</h2>
        <p class="mt-4 max-w-[44ch] leading-[1.6] text-mute">
          {
            enAttente
              ? "Réponses, remarques, questions : tout arrive directement dans ma boîte mail."
              : "Validez la proposition ou posez vos questions, je reviens vers vous rapidement."
          }
        </p>
      <form id="devis-form" class="card mt-10 grid gap-6" data-slug={slug}>
        {
          enAttente ? (
            <input type="hidden" name="reponse" value="question" />
          ) : (
            <Choicebox
              name="reponse"
              options={[
                {
                  value: "validation",
                  title: "Je valide cette proposition",
                  hint: "Le projet démarre à réception de l'acompte.",
                  checked: true,
                },
                {
                  value: "question",
                  title: "J'ai une question ou une remarque",
                  hint: "Précisez-la dans le message ci-dessous.",
                },
              ]}
            />
          )
        }
        <p class="text-[13px] text-mute">Les champs marqués d'une étoile sont obligatoires.</p>
        <div class="grid grid-cols-2 gap-4 max-[640px]:grid-cols-1">
          <div class="grid gap-2">
            <label class="label field-label" for="devis-prenom">
              Prénom <span class="text-ink" aria-hidden="true">*</span>
            </label>
            <input
              class="field"
              type="text"
              id="devis-prenom"
              name="prenom"
              autocomplete="given-name"
              placeholder="Votre prénom"
              required
            />
          </div>
          <div class="grid gap-2">
            <label class="label field-label" for="devis-nom">
              Nom <span class="text-ink" aria-hidden="true">*</span>
            </label>
            <input
              class="field"
              type="text"
              id="devis-nom"
              name="nom"
              autocomplete="family-name"
              placeholder="Votre nom"
              required
            />
          </div>
        </div>
        <div class="grid gap-2">
          <label class="label field-label" for="devis-email">
            Email <span class="text-ink" aria-hidden="true">*</span>
          </label>
          <input
            class="field"
            type="email"
            id="devis-email"
            name="email"
            autocomplete="email"
            placeholder="vous@entreprise.com"
            required
          />
        </div>
        <div data-facturation-fields hidden class="grid gap-4 border-t border-line pt-6">
          <p class="text-[13px] leading-[1.6] text-mute">
            Informations nécessaires pour éditer la facture d'acompte. Raison sociale et
            SIREN uniquement si vous répondez pour une société, laissez-les vides sinon.
          </p>
          <div class="grid grid-cols-2 gap-4 max-[640px]:grid-cols-1">
            <div class="grid gap-2">
              <label class="label field-label" for="devis-raison-sociale">Raison sociale</label>
              <input
                class="field"
                type="text"
                id="devis-raison-sociale"
                name="raisonSociale"
                autocomplete="organization"
                placeholder="Nom de la société"
              />
            </div>
            <div class="grid gap-2">
              <label class="label field-label" for="devis-siren">Numéro SIREN</label>
              <input
                class="field"
                type="text"
                id="devis-siren"
                name="siren"
                inputmode="numeric"
                placeholder="123456789"
              />
            </div>
          </div>
          <div class="grid gap-2">
            <label class="label field-label" for="devis-adresse">
              Adresse de facturation <span class="text-ink" aria-hidden="true">*</span>
            </label>
            <input
              class="field"
              type="text"
              id="devis-adresse"
              name="adresse"
              autocomplete="street-address"
              placeholder="Numéro, rue, code postal, ville"
            />
          </div>
          <div class="grid gap-2">
            <label class="label field-label" for="devis-tva">Numéro de TVA intracommunautaire</label>
            <input
              class="field"
              type="text"
              id="devis-tva"
              name="tva"
              placeholder="FR12345678900 (si applicable, hors France)"
            />
          </div>
        </div>
        <div class="grid gap-2">
          <label class="label field-label" for="devis-message">Message</label>
          <textarea
            class="field h-auto min-h-[120px] py-3"
            id="devis-message"
            name="message"
            placeholder="Une question, une remarque, un ajustement souhaité…"></textarea>
        </div>
        <div class="grid gap-2 border-t border-line pt-6">
          <label
            class="flex cursor-pointer items-start gap-3 text-[13px] leading-[1.6] text-mute"
            for="devis-consentement"
          >
            <input
              class="mt-0.75 size-4 shrink-0 accent-ink"
              type="checkbox"
              id="devis-consentement"
              name="consentement"
              required
            />
            <span>
              J'accepte que Coolbeans conserve ces informations pour traiter ma demande et
              assurer le suivi de notre collaboration.
              <span class="text-ink" aria-hidden="true">*</span>
            </span>
          </label>
          <p class="pl-7 text-[13px] leading-[1.6] text-mute">
            Elles ne sont ni revendues ni transmises à des tiers, et peuvent être supprimées
            sur simple demande à <a class="link" href="mailto:ludo@coolbeans.cc">ludo@coolbeans.cc</a>.
          </p>
        </div>
        <button class="btn btn-lg" type="submit">Envoyer ma réponse</button>
        <p
          data-devis-form-status
          role="status"
          class="hidden text-center text-[13px] font-medium"
        />
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#devis-form");
  const status = form?.querySelector<HTMLParagraphElement>("[data-devis-form-status]");
  const facturationFields = form?.querySelector<HTMLElement>("[data-facturation-fields]");

  const syncFacturationFields = () => {
    if (!form || !facturationFields) return;
    const reponse = new FormData(form).get("reponse");
    facturationFields.hidden = reponse !== "validation";
  };
  form?.querySelectorAll<HTMLInputElement>('input[name="reponse"]').forEach((input) => {
    input.addEventListener("change", syncFacturationFields);
  });
  syncFacturationFields();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!status || !submitBtn) return;

    const fd = new FormData(form);
    const payload = {
      slug: form.dataset.slug,
      reponse: fd.get("reponse"),
      prenom: fd.get("prenom"),
      nom: fd.get("nom"),
      email: fd.get("email"),
      message: fd.get("message"),
      raisonSociale: fd.get("raisonSociale"),
      siren: fd.get("siren"),
      adresse: fd.get("adresse"),
      tva: fd.get("tva"),
      consentement: fd.get("consentement") === "on",
    };

    // Raison sociale et SIREN restent facultatifs : un particulier n'en a pas.
    // Seule l'adresse est indispensable pour éditer la facture d'acompte.
    if (payload.reponse === "validation" && !String(payload.adresse ?? "").trim()) {
      status.hidden = false;
      status.textContent =
        "Merci de renseigner l'adresse de facturation pour éditer la facture d'acompte.";
      status.className = "text-center text-[13px] font-medium text-error";
      return;
    }

    submitBtn.disabled = true;
    status.hidden = false;
    status.textContent = "Envoi en cours…";
    status.className = "text-center text-[13px] font-medium text-mute";

    try {
      const res = await fetch("/api/devis-reponse", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error();
      status.textContent = "Message envoyé, vous recevez une confirmation par email à l'instant.";
      status.className = "text-center text-[13px] font-medium text-success";
      form.reset();
      syncFacturationFields(); // reset() remet la case "validation" : réaffiche la facturation
    } catch {
      /* Filet de sécurité : un envoi qui échoue ne doit jamais laisser le
         client sans issue, sinon la réponse est perdue et personne ne le sait
         (ni lui, ni moi). On lui rend sa saisie sous forme de courriel
         pré-rempli, qui ne dépend d'aucun de nos services. */
      const corps = [
        `Réponse au devis : ${payload.slug ?? ""}`,
        payload.reponse === "validation"
          ? "Je valide cette proposition."
          : "J'ai une question ou une remarque.",
        "",
        `Prénom : ${payload.prenom ?? ""}`,
        `Nom : ${payload.nom ?? ""}`,
        `Email : ${payload.email ?? ""}`,
        payload.raisonSociale ? `Raison sociale : ${payload.raisonSociale}` : "",
        payload.siren ? `SIREN : ${payload.siren}` : "",
        payload.adresse ? `Adresse de facturation : ${payload.adresse}` : "",
        payload.tva ? `TVA intracommunautaire : ${payload.tva}` : "",
        "",
        String(payload.message ?? "").trim() || "(pas de message)",
      ]
        .filter((ligne) => ligne !== "")
        .join("\n");
      const lien =
        "mailto:ludo@coolbeans.cc" +
        `?subject=${encodeURIComponent(`Réponse au devis ${payload.slug ?? ""}`)}` +
        `&body=${encodeURIComponent(corps)}`;

      status.innerHTML =
        "L'envoi automatique n'a pas abouti. Vos réponses ne sont pas perdues : " +
        `<a class="link" href="${lien}">envoyez-les-moi par e-mail</a>, ` +
        "le message est déjà prêt.";
      status.className = "text-center text-[13px] font-medium text-error";
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
