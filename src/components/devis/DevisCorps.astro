---
import Banner from "../ui/Banner.astro";
import Tooltip from "../ui/Tooltip.astro";
import {
  riche,
  eur,
  ancreSection,
  totaux,
  ownerLabel,
  listeItem,
  OWNER_DOT,
  OWNER_BADGE,
  type DevisData,
} from "../../lib/devis";

interface Props {
  d: DevisData;
  /* Renseigné uniquement quand le devis a plusieurs versions : elles
     coexistent dans le DOM et leurs ancres doivent rester distinctes. */
  version?: number;
}
const { d, version } = Astro.props;

const ancre = (titre: string) => ancreSection(titre, version);
---

<!-- BLOC STICKY : nav de sections. Colle au sommet du viewport, la page
     devis n'a pas de Nav Coolbeans au-dessus. -->
<div
  data-sticky-devis-nav
  class="sticky top-0 z-40 -mx-[calc((100vw-100%)/2)] border-b border-line bg-surface/95 backdrop-blur-sm"
>
  <nav class="overflow-x-auto" aria-label="Sections du devis">
    <ul class="mx-auto flex w-max max-w-260 gap-6 px-6 py-3.5 whitespace-nowrap">
      {
        d.sections.map((section) => (
          <li>
            <a
              href={`#${ancre(section.titre)}`}
              data-section-link
              aria-current="false"
              class="rounded-control px-2 py-1 font-mono text-[12px] font-semibold tracking-wide text-mute uppercase transition-colors duration-150 ease-in-out hover:bg-surface-raise hover:text-ink aria-current:bg-ink aria-current:text-surface"
            >
              {section.titre}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<div class="mx-auto max-w-[880px] py-16x">
  {
    d.sections.map((section, index) => (
      <section
        id={ancre(section.titre)}
        class:list={[
          "grid scroll-mt-16.5 grid-cols-[180px_1fr] gap-10 py-10 max-[700px]:grid-cols-1 max-[700px]:gap-4",
          index > 0 && "border-t border-line",
        ]}
      >
        <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">
          {section.titre}
        </p>
        <div>
          {section.texte && (
            <p
              class:list={[
                "max-w-[58ch] leading-[1.6]",
                (section.liste || section.budget || section.planning || section.diagram) && "mb-5",
              ]}
              set:html={riche(section.texte)}
            />
          )}

          {section.liste && (
            <ul class="flex list-none flex-col gap-3">
              {section.liste.map((brut) => {
                const item = listeItem(brut);
                return (
                  <li class="flex items-start gap-3.5">
                    <span class="mt-[0.55em] block size-1.5 flex-none bg-ink" aria-hidden="true" />
                    <span class="max-w-[58ch]">
                      <Fragment set:html={riche(item.texte)} />
                      {item.tooltip && <Tooltip texte={item.tooltip} />}
                    </span>
                  </li>
                );
              })}
            </ul>
          )}

          {section.diagram && (
            <a
              href={section.diagram.image}
              target="_blank"
              rel="noopener"
              class:list={[
                "group block overflow-hidden rounded-card border border-line bg-surface-subtle",
                section.liste && "mt-5",
              ]}
            >
              <img
                src={section.diagram.image}
                alt={section.diagram.alt}
                class="w-full transition-transform duration-300 ease-brand group-hover:scale-[1.01]"
                loading="lazy"
              />
              <span class="flex items-center gap-1.5 border-t border-line px-4 py-2.5 font-mono text-[12px] text-mute">
                Cliquer pour voir en plein format ↗
              </span>
            </a>
          )}

          {section.budget &&
            (() => {
              const b = section.budget;
              const { total, paliers, totalFinal, mention } = totaux(b);
              /* Les options ne sont cochables que sur un devis chiffré : sous
                 `enAttente` aucune ligne n'a de prix, une case ne ferait donc
                 rien bouger et promettrait un arbitrage qui n'existe pas. */
              const cochable = !b.enAttente;
              const premiereOption = b.lignes.findIndex((l) => l.optionnel);
              return (
                <div
                  data-devis-budget
                  data-remises={JSON.stringify(paliers.map((p) => p.pct))}
                  data-mention={mention}
                >
                  {b.lignes.map((ligne, i) => {
                    const aCase = cochable && ligne.optionnel;
                    const classes =
                      "flex items-baseline justify-between gap-4 border-b border-line py-3 text-[15px] max-[700px]:text-[16px]";
                    /* Libellé et prix sont identiques dans les deux branches ;
                       seul l'emballage change — un <label> cliquable autour de
                       la case, ou la ligne nue du socle. */
                    const contenu = (
                      <>
                        <span class="flex items-baseline gap-3">
                          {aCase && (
                            <input
                              type="checkbox"
                              data-devis-option
                              value={i}
                              checked={ligne.defaut}
                              class="mt-[0.2em] size-4 flex-none accent-ink"
                            />
                          )}
                          <span>
                            <Fragment set:html={riche(ligne.label)} />
                            {ligne.tooltip && <Tooltip texte={ligne.tooltip} />}
                          </span>
                        </span>
                        {ligne.prix !== undefined ? (
                          <span class="font-mono whitespace-nowrap tabular-nums">
                            {aCase && "+ "}
                            {eur.format(ligne.prix)} {mention}
                          </span>
                        ) : (
                          /* Sur un devis en construction, une ligne sans prix
                           reste à chiffrer ; ailleurs, c'est qu'elle est
                           comprise dans le total. Le même vide ne veut pas
                           dire la même chose dans les deux cas. */
                          <span class="font-mono text-[13px] whitespace-nowrap text-mute">
                            {b.enAttente ? "À chiffrer" : "Inclus"}
                          </span>
                        )}
                      </>
                    );
                    return (
                      <>
                        {aCase && premiereOption === i && (
                          /* Frontière entre le socle et le reste : sans elle,
                             une case au milieu d'une liste se lit comme un
                             défaut d'affichage plutôt que comme un choix. */
                          <p class="pt-7 pb-1 font-mono text-[12px] font-semibold tracking-wide text-mute uppercase">
                            À composer selon votre budget
                          </p>
                        )}
                        {aCase ? (
                          <label
                            data-devis-ligne
                            data-prix={ligne.prix ?? 0}
                            class={`${classes} cursor-pointer transition-colors duration-150 ease-in-out hover:bg-surface-subtle`}
                          >
                            {contenu}
                          </label>
                        ) : (
                          <div data-devis-ligne data-prix={ligne.prix ?? 0} class={classes}>
                            {contenu}
                          </div>
                        )}
                      </>
                    );
                  })}
                  {b.enAttente ? (
                    <div class="pt-5">
                      <Banner tone="info">
                        Montant <b class="font-bold">en attente de validation du périmètre</b>.
                        Cette proposition est un premier jet : elle fixe la structure, pas encore le
                        prix. Le chiffrage arrive une fois le périmètre arrêté ensemble.
                      </Banner>
                    </div>
                  ) : paliers.length > 0 ? (
                    <>
                      <div class="flex items-baseline justify-between gap-4 border-b border-line py-3 text-[15px] font-medium max-[700px]:text-[16px]">
                        <span>Total</span>
                        <span data-devis-total class="font-mono whitespace-nowrap tabular-nums">
                          {eur.format(total)} {mention}
                        </span>
                      </div>
                      {paliers.map((palier) => (
                        <div class="flex items-baseline justify-between gap-4 border-b border-line py-3 text-[15px] text-mute max-[700px]:text-[16px]">
                          <span>
                            {palier.label} (−{palier.pct}&nbsp;%)
                          </span>
                          <span data-devis-remise class="font-mono whitespace-nowrap tabular-nums">
                            −{eur.format(palier.montant)}
                          </span>
                        </div>
                      ))}
                      <div class="flex items-baseline justify-between gap-4 py-4">
                        <span class="text-[17px] font-bold">Total après remise</span>
                        <span
                          data-devis-total-final
                          class="font-mono text-[20px] font-bold whitespace-nowrap tabular-nums"
                        >
                          {eur.format(totalFinal)} {mention}
                        </span>
                      </div>
                    </>
                  ) : (
                    <div class="flex items-baseline justify-between gap-4 py-4">
                      <span class="text-[17px] font-bold">Total</span>
                      <span
                        data-devis-total-final
                        class="font-mono text-[20px] font-bold whitespace-nowrap tabular-nums"
                      >
                        {eur.format(total)} {mention}
                      </span>
                    </div>
                  )}
                  {b.reglement && (
                    /* mt-6 : sans marge, les conditions se collaient au total
                       (ou au bandeau d'attente) et se lisaient comme sa suite. */
                    <p class="mt-6 text-[13px] text-mute">
                      Conditions de règlement : <Fragment set:html={riche(b.reglement)} />
                    </p>
                  )}
                </div>
              );
            })()}

          {section.planning &&
            (() => {
              const groupe = ancre(section.titre);
              const { options } = section.planning;
              return (
                <div>
                  {options.length > 1 && (
                    <div class="mb-5 flex flex-wrap gap-2" role="tablist">
                      {options.map((option, i) => (
                        <button
                          type="button"
                          role="tab"
                          aria-pressed={i === 0}
                          data-planning-group={groupe}
                          data-planning-option={`${groupe}-${i}`}
                          class:list={[
                            "rounded-full px-3 py-1 text-[13px] font-semibold transition-colors duration-150 ease-in-out",
                            i === 0
                              ? "bg-ink text-surface"
                              : "text-mute hover:bg-surface-raise hover:text-ink",
                          ]}
                        >
                          {option.label}
                        </button>
                      ))}
                    </div>
                  )}
                  {options.map((option, i) => (
                    <div data-planning-pane={`${groupe}-${i}`} hidden={i !== 0}>
                      {option.indicatif && (
                        <div class="mb-5">
                          <Banner tone="info">
                            Calendrier donné <b class="font-bold">à titre indicatif</b>, pour se
                            projeter. Les dates se fixent une fois le périmètre arrêté et la date de
                            démarrage choisie.
                          </Banner>
                        </div>
                      )}
                      {option.texte && (
                        <p class="mb-5 max-w-[58ch] leading-[1.6]" set:html={riche(option.texte)} />
                      )}
                      <div>
                        {option.jalons.map((jalon) => (
                          <div
                            data-devis-jalon
                            class="grid grid-cols-[150px_1fr_auto] items-baseline gap-x-4 border-b border-line py-2.5 text-[15px] max-[700px]:grid-cols-[90px_1fr]"
                          >
                            <span class="font-mono text-[13px] font-bold text-ink">
                              {jalon.date}
                            </span>
                            <span set:html={riche(jalon.label)} />
                            {jalon.owner && (
                              <span
                                class:list={[
                                  "inline-flex w-fit items-center gap-1.5 rounded-control px-2 py-0.5 font-mono text-[11px] font-bold tracking-wide whitespace-nowrap uppercase max-[700px]:col-span-2 max-[700px]:mt-1 max-[700px]:justify-self-start",
                                  OWNER_BADGE[jalon.owner],
                                ]}
                              >
                                <span
                                  class:list={[
                                    "block size-1.5 rounded-full",
                                    OWNER_DOT[jalon.owner],
                                  ]}
                                  aria-hidden="true"
                                />
                                {ownerLabel(d, jalon.owner)}
                              </span>
                            )}
                          </div>
                        ))}
                      </div>
                      {option.note && (
                        <p class="mt-4 text-[13px] text-mute" set:html={riche(option.note)} />
                      )}
                    </div>
                  ))}
                </div>
              );
            })()}

          {section.note && (
            <p
              class="mt-6 max-w-[58ch] text-[14px] leading-[1.6] text-mute"
              set:html={riche(section.note)}
            />
          )}
        </div>
      </section>
    ))
  }

  {
    d.notes.length > 0 && (
      <div
        data-devis-notes
        class="grid grid-cols-[180px_1fr] gap-10 border-t border-line pt-10 max-[700px]:grid-cols-1 max-[700px]:gap-4"
      >
        <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">NB</p>
        <div class="flex max-w-[58ch] flex-col gap-3">
          {d.notes.map((note) => (
            <Banner tone={note.tone}>
              <Fragment set:html={riche(note.texte)} />
              {note.tooltip && <Tooltip texte={note.tooltip} />}
            </Banner>
          ))}
        </div>
      </div>
    )
  }
</div>

<script>
  /* scrollspy de la nav de section : surligne le lien qui correspond à la
     section actuellement sous le bloc sticky, pour toujours savoir où on se
     situe dans le devis. */
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-section-link]");
  const stickyBars = document.querySelectorAll<HTMLElement>("[data-sticky-devis-nav]");

  const setActive = (id: string) => {
    links.forEach((link) => {
      link.setAttribute("aria-current", link.getAttribute("href") === `#${id}` ? "true" : "false");
    });
  };

  const stickyOffset = () => {
    const visible = [...stickyBars].find((bar) => bar.offsetParent !== null);
    return visible?.offsetHeight ?? 0;
  };

  if (sections.length && links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (!visible.length) return;
        const top = visible.reduce((a, b) =>
          a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
        );
        setActive(top.target.id);
      },
      { rootMargin: `-${stickyOffset()}px 0px -70% 0px`, threshold: 0 },
    );
    sections.forEach((section) => observer.observe(section));
  }

  /* sélecteur local d'options de planning (ex. démarrage immédiat vs
     démarrage différé), scopé par groupe pour gérer plusieurs plannings sur
     la même page. */
  document.querySelectorAll<HTMLButtonElement>("[data-planning-option]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.planningOption;
      const groupe = btn.dataset.planningGroup;
      document
        .querySelectorAll<HTMLButtonElement>(`[data-planning-group="${groupe}"]`)
        .forEach((b) => {
          const active = b.dataset.planningOption === target;
          b.setAttribute("aria-pressed", String(active));
          b.classList.toggle("bg-ink", active);
          b.classList.toggle("text-surface", active);
          b.classList.toggle("text-mute", !active);
          b.classList.toggle("hover:bg-surface-raise", !active);
          b.classList.toggle("hover:text-ink", !active);
        });
      document.querySelectorAll<HTMLElement>("[data-planning-pane]").forEach((pane) => {
        if (pane.dataset.planningPane?.startsWith(`${groupe}-`)) {
          pane.hidden = pane.dataset.planningPane !== target;
        }
      });
    });
  });

  /* Budget composable : le client coche ses options, les totaux suivent.
     Le rendu Astro a déjà écrit les montants de la sélection par défaut, donc
     une page sans JavaScript reste juste — elle n'est pas modifiable, c'est
     tout. Ce qui compte : ce total est un confort de lecture, jamais une
     source de vérité. Le montant qui engage est recalculé côté serveur à la
     soumission, depuis le YAML, à partir des seuls index cochés. */
  /* Miroir de `eur` dans lib/devis.ts : rien après la virgule sur un compte
     rond, deux décimales sinon. Si l'un des deux change, l'autre aussi. */
  const eurRond = new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR",
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  });
  const eurCentimes = new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR",
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  const eur = {
    format: (n: number) => (Number.isInteger(n) ? eurRond : eurCentimes).format(n),
  };

  document.querySelectorAll<HTMLElement>("[data-devis-budget]").forEach((bloc) => {
    const cases = bloc.querySelectorAll<HTMLInputElement>("[data-devis-option]");
    if (!cases.length) return;

    const mention = bloc.dataset.mention ?? "";
    const pourcentages: number[] = JSON.parse(bloc.dataset.remises || "[]");
    const suffixe = (montant: number) => `${eur.format(montant)}${mention ? ` ${mention}` : ""}`;

    const recalculer = () => {
      let total = 0;
      bloc.querySelectorAll<HTMLElement>("[data-devis-ligne]").forEach((ligne) => {
        const coche = ligne.querySelector<HTMLInputElement>("[data-devis-option]");
        if (coche && !coche.checked) return;
        total += Number(ligne.dataset.prix ?? 0);
      });

      /* Même cascade que `totaux()` côté serveur : chaque remise mord sur ce
         que la précédente a laissé. Les deux calculs doivent rester d'accord,
         sans quoi le client lit un montant et en valide un autre. */
      let restant = total;
      const montants = pourcentages.map((pct) => {
        const montant = (restant * pct) / 100;
        restant -= montant;
        return montant;
      });

      const brut = bloc.querySelector<HTMLElement>("[data-devis-total]");
      if (brut) brut.textContent = suffixe(total);
      bloc.querySelectorAll<HTMLElement>("[data-devis-remise]").forEach((el, i) => {
        el.textContent = `−${eur.format(montants[i] ?? 0)}`;
      });
      const final = bloc.querySelector<HTMLElement>("[data-devis-total-final]");
      if (final) final.textContent = suffixe(restant);
    };

    cases.forEach((c) => c.addEventListener("change", recalculer));
    recalculer();
  });
</script>
