---
interface Props {
  title: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  text,
  ctaLabel = "discuter de votre projet",
  ctaHref = "#",
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="bg-surface-subtle py-24x max-[1100px]:py-16x">
  <div class="container-site text-center">
    <h2 class="mx-auto max-w-[20ch] text-[clamp(40px,5vw,72px)] leading-none tracking-[-0.035em]">
      {title}
    </h2>
    {
      text && (
        <p class="mx-auto mt-6 max-w-[58ch] text-lg leading-normal font-medium text-balance">
          {text}
        </p>
      )
    }
    <div class="mt-10 flex flex-wrap justify-center gap-5">
      <a class="btn btn-lg" href={ctaHref}>{ctaLabel}</a>
      {
        secondaryLabel && (
          <a class="btn btn-ghost btn-lg" href={secondaryHref ?? "#"}>
            {secondaryLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
