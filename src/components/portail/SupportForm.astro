---
// Formulaire de demande support (COO-29).
//
// Même mécanique que DevisReponse.astro, réduite à deux champs : soumission
// fetch vers /api/support, états idle / envoi / succès / erreur dans un
// paragraphe de statut. La session Clerk est garantie par le middleware
// (/espace est protégé), l'API redemande la sienne de toute façon.
//
// `demo` sert à la Bibliothèque de design-system.astro : il fige un état
// visuel et neutralise la soumission — la page est prérendue, sans session,
// un vrai POST n'aurait aucun sens.

interface Props {
  /** Page design-system uniquement : état figé, soumission neutralisée. */
  demo?: "repos" | "succes" | "erreur";
}
const { demo } = Astro.props;

// Miroirs exacts des messages posés par le script : la Bibliothèque doit
// montrer ce que l'utilisateur verra, pas une approximation.
const STATUS_DEMO = {
  succes:
    "Demande envoyée. Vous recevez un accusé de réception par email, je reviens vers vous rapidement.",
  erreur: "Envoi impossible, réessayez dans un instant ou écrivez-moi à ludo@coolbeans.cc.",
};
const statusDemo = demo === "succes" || demo === "erreur" ? STATUS_DEMO[demo] : "";

// La Bibliothèque pose plusieurs instances sur la même page : les `id` des
// champs doivent rester uniques pour que chaque label pointe le sien.
const uid = demo ?? "live";
---

{/*
  Pas la classe `card` : `.doc-root .card` (doc.css) la bat en spécificité et
  lui ajoute un survol de carte-lien. Composée en utilitaires, mêmes tokens —
  même piège que documenté dans EmptyState.astro.
*/}
<form
  data-support-form
  data-demo={demo ? "" : undefined}
  class="grid max-w-[640px] gap-6 rounded-card border border-line bg-surface p-6x"
>
  <div class="grid gap-2">
    <label class="label" for={`support-objet-${uid}`}>
      Objet <span class="text-ink" aria-hidden="true">*</span>
    </label>
    <input
      class="field"
      type="text"
      id={`support-objet-${uid}`}
      name="objet"
      maxlength="200"
      placeholder="Ex. : le formulaire de contact ne part plus"
      required
    />
  </div>
  <div class="grid gap-2">
    <label class="label" for={`support-description-${uid}`}>
      Description <span class="text-ink" aria-hidden="true">*</span>
    </label>
    <textarea
      class="field h-auto min-h-[160px] py-3"
      id={`support-description-${uid}`}
      name="description"
      maxlength="5000"
      placeholder="Ce qui se passe, sur quelle page, depuis quand… tout détail aide à répondre vite."
      required></textarea>
  </div>
  <div class="flex items-center gap-4">
    <button class="btn" type="submit">Envoyer la demande</button>
  </div>
  <p
    data-support-status
    role="status"
    hidden={!statusDemo}
    class:list={[
      "text-[13px] font-medium",
      demo === "succes" && "text-success",
      demo === "erreur" && "text-error",
    ]}
  >
    {statusDemo}
  </p>
</form>

<script>
  // Le sélecteur est une classe de données, pas un id : design-system.astro
  // pose plusieurs instances du formulaire sur la même page.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-support-form]")) {
    if (form.hasAttribute("data-demo")) {
      form.addEventListener("submit", (event) => event.preventDefault());
      continue;
    }

    const status = form.querySelector<HTMLParagraphElement>("[data-support-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    // Classes en toutes lettres : Tailwind ne génère que ce qu'il lit tel quel.
    const setStatus = (texte: string, tone: "text-mute" | "text-success" | "text-error") => {
      if (!status) return;
      status.hidden = false;
      status.textContent = texte;
      status.className = `text-[13px] font-medium ${tone}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitBtn) return;

      const fd = new FormData(form);
      submitBtn.disabled = true;
      setStatus("Envoi en cours…", "text-mute");

      try {
        const res = await fetch("/api/support", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ objet: fd.get("objet"), description: fd.get("description") }),
        });
        if (!res.ok) {
          // L'API renvoie des messages actionnables (quota atteint,
          // module non raccordé…) : on les affiche tels quels.
          const body = (await res.json().catch(() => null)) as { error?: string } | null;
          throw new Error(body?.error ?? "");
        }
        setStatus(
          "Demande envoyée. Vous recevez un accusé de réception par email, je reviens vers vous rapidement.",
          "text-success",
        );
        form.reset();
      } catch (err) {
        const message = err instanceof Error && err.message ? err.message : "";
        setStatus(
          message || "Envoi impossible, réessayez dans un instant ou écrivez-moi à ludo@coolbeans.cc.",
          "text-error",
        );
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>
