---
/* Le bloc « Devis et factures » d'une page projet : un lien par PDF du
   dossier R2 du projet, ouvert dans un nouvel onglet. Sans pièce, pas de
   bloc. Entre Avancement et les onglets d'étape, à la même largeur. */
import type { PieceAffichee } from "../../../lib/pieces/pieces-r2";

interface Props {
  pieces: PieceAffichee[];
}

const { pieces } = Astro.props;
---

{
  pieces.length > 0 && (
    <section class="container-site print:hidden" aria-labelledby="pieces-titre">
      <div class="mx-auto max-w-[880px] border-b border-line pt-10 pb-8">
        <h2 id="pieces-titre" class="text-[1.25rem]/[1.3] tracking-[-0.01em]">
          Devis et factures
        </h2>
        <ul class="mt-4 divide-y divide-line">
          {pieces.map((p) => (
            <li class="py-3 text-[15px]">
              <a href={p.href} target="_blank" rel="noopener" class="font-medium text-ink">
                {p.libelle}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
