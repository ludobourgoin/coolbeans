---
/* Le bloc « Heures du pack » d'une page projet (décision de Ludo du
   2026-10-02) : il remplace le bloc Avancement sur un pack d'heures. La
   jauge verte compte les heures restantes, et chaque demande montre son
   chiffrage et son statut, tels que Ludo les tient dans Linear.

   Sans total connu (proposition pas encore validée), pas de jauge : le bloc
   le dit au lieu d'afficher un solde faux. */
import { libelleDemande, type HeuresPack, type StatutDemande } from "../../../lib/portail/avancement-linear";
import { dateCourte } from "../../../lib/documents/entete";

interface Props {
  heures: HeuresPack | null;
  /** Lien vers la page Demandes du portail. */
  lienDemandes: string;
}

const { heures, lienDemandes } = Astro.props;
const date = (iso: string) => dateCourte(new Date(`${iso}T12:00:00Z`));
const PASTILLE: Record<StatutDemande, string> = {
  "a-chiffrer": "bg-surface-raise text-mute",
  chiffree: "bg-warning/10 text-warning",
  acceptee: "bg-surface-raise text-ink",
  "en-cours": "bg-info/10 text-info",
  faite: "bg-success/10 text-success",
  "non-retenue": "bg-surface-raise text-mute",
};
const ouvertes = heures?.demandes.filter((d) => d.statut !== "faite" && d.statut !== "non-retenue") ?? [];
const closes = heures?.demandes.filter((d) => d.statut === "faite" || d.statut === "non-retenue") ?? [];
const part =
  heures && heures.total && heures.restantes !== null
    ? Math.round((Math.max(0, heures.restantes) / heures.total) * 100)
    : 0;
---

{
  heures && (
    <section class="container-site print:hidden" aria-labelledby="heures-titre">
      <div class="mx-auto max-w-[880px] border-b border-line pt-10 pb-8">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="heures-titre" class="text-[1.25rem]/[1.3] tracking-[-0.01em]">
            Heures du pack
          </h2>
          <p class="font-mono text-[12px] tracking-[0.04em] text-mute uppercase">
            {heures.total === null
              ? "Pack en attente de validation"
              : heures.restantes !== null && heures.restantes < 0
                ? `Dépassé de ${-heures.restantes} h`
                : `${heures.restantes} h restantes sur ${heures.total}`}
          </p>
        </div>
        {heures.total !== null && (
          <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-surface-raise" aria-hidden="true">
            <div class="h-full rounded-full bg-success" style={`width:${part}%`}></div>
          </div>
        )}

        {heures.demandes.length === 0 ? (
          <p class="mt-7 text-[15px] text-mute">
            Aucune demande pour l'instant. Chaque demande faite depuis <a href={lienDemandes}>Demandes</a> arrive
            ici, chiffrée avant d'être lancée.
          </p>
        ) : (
          <div class="mt-7">
            {(() => {
              const ligne = (d: HeuresPack["demandes"][number]) => (
                <li class="flex items-baseline justify-between gap-4 py-2.5 text-[15px]">
                  <span class:list={[(d.statut === "faite" || d.statut === "non-retenue") && "text-mute"]}>{d.titre}</span>
                  <span class="flex shrink-0 items-baseline gap-3">
                    {d.echeance && <span class="font-mono text-[12px] text-mute">{date(d.echeance)}</span>}
                    <span class="font-mono text-[12px] text-ink">{d.heures !== null ? `${d.heures} h` : "—"}</span>
                    <span class:list={["rounded-full px-2 py-0.5 text-[12px] font-semibold whitespace-nowrap", PASTILLE[d.statut]]}>
                      {libelleDemande(d.statut)}
                    </span>
                  </span>
                </li>
              );
              return (
                <>
                  {ouvertes.length > 0 && <ul class="divide-y divide-line">{ouvertes.map(ligne)}</ul>}
                  {closes.length > 0 && (
                    <details class="mt-2">
                      <summary class="cursor-pointer py-1.5 text-[13px] text-mute">
                        {closes.length} {closes.length > 1 ? "demandes closes" : "demande close"}
                      </summary>
                      <ul class="divide-y divide-line">{closes.map(ligne)}</ul>
                    </details>
                  )}
                </>
              );
            })()}
          </div>
        )}
      </div>
    </section>
  )
}
