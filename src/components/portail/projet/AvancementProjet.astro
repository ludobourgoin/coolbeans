---
/* Le bloc « Avancement » d'une page projet (décision de Ludo du 2026-10-01) :
   entre l'en-tête et les onglets d'étape, le client voit où en est le projet
   avant d'ouvrir un document. Les issues sont rangées par jalon, chacune avec
   son état traduit et son échéance. Les issues faites se replient sous leur
   jalon, pour que la liste n'éloigne pas les documents.

   Sans avancement (Linear muet) ou sans issue visible, le bloc ne s'affiche
   pas. */
import { libelleEtat, type Avancement, type TypeEtat } from "../../../lib/portail/avancement-linear";
import { dateCourte } from "../../../lib/documents/entete";

interface Props {
  avancement: Avancement | null;
}

const { avancement } = Astro.props;
const date = (iso: string) => dateCourte(new Date(`${iso}T12:00:00Z`));
const PASTILLE: Record<TypeEtat, string> = {
  backlog: "bg-surface-raise text-mute",
  unstarted: "bg-surface-raise text-ink",
  started: "bg-info/10 text-info",
  completed: "bg-success/10 text-success",
};
const part = avancement && avancement.total > 0 ? Math.round((avancement.faites / avancement.total) * 100) : 0;
---

{
  avancement && avancement.total > 0 && (
    <section class="w-full border-b border-line print:hidden" aria-labelledby="avancement-titre">
      <div class="px-6 py-8 md:px-10">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="avancement-titre" class="text-[1.25rem]/[1.3] tracking-[-0.01em]">
            Avancement
          </h2>
          <p class="font-mono text-[12px] tracking-[0.04em] text-mute uppercase">
            {avancement.faites} sur {avancement.total} faites
          </p>
        </div>
        <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-surface-raise" aria-hidden="true">
          <div class="h-full rounded-full bg-ink" style={`width:${part}%`}></div>
        </div>

        {avancement.groupes.map((g) => {
          const ouvertes = g.issues.filter((i) => i.etat !== "completed");
          const faites = g.issues.filter((i) => i.etat === "completed");
          const ligne = (i: (typeof g.issues)[number]) => (
            <li class="flex items-baseline justify-between gap-4 py-2.5 text-[15px]">
              <span class:list={[i.etat === "completed" && "text-mute"]}>{i.titre}</span>
              <span class="flex shrink-0 items-baseline gap-3">
                {i.echeance && <span class="font-mono text-[12px] text-mute">{date(i.echeance)}</span>}
                <span class:list={["rounded-full px-2 py-0.5 text-[12px] font-semibold", PASTILLE[i.etat]]}>
                  {libelleEtat(i.etat)}
                </span>
              </span>
            </li>
          );
          return (
            <div class="mt-7">
              <p class="label">
                {g.jalon ? g.jalon.nom : "Sans jalon"}
                {g.jalon?.date && <span class="text-mute"> · {date(g.jalon.date)}</span>}
              </p>
              {ouvertes.length > 0 && <ul class="mt-2 divide-y divide-line">{ouvertes.map(ligne)}</ul>}
              {faites.length > 0 && (
                <details class="mt-2">
                  <summary class="cursor-pointer py-1.5 text-[13px] text-mute">
                    {faites.length} {faites.length > 1 ? "faites" : "faite"}
                  </summary>
                  <ul class="divide-y divide-line">{faites.map(ligne)}</ul>
                </details>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )
}
