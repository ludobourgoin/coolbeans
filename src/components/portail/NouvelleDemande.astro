---
// Popup Nouvelle demande (spec 2026-08-15-messagerie-portail-design.md §6).
//
// Même mécanique que feu SupportForm.astro : soumission fetch, états idle /
// envoi / succès / erreur dans un role="status". Différences : multipart (pièces
// jointes possibles) et succès → location.reload() pour faire apparaître le
// ticket dans MessagerieBoard, plutôt qu'un simple message inline. Composant
// autonome (bouton + <dialog>) pour rester réutilisable tel quel par la Task 11
// (page ticket).
//
// Pas la classe `card` — mêmes tokens que SupportForm/EmptyState.
import { URGENCES } from "../../lib/portail/messagerie/regles";
---

<button type="button" class="btn" data-nouvelle-demande-ouvrir>
  Nouvelle demande
</button>

<dialog
  data-nouvelle-demande
  aria-labelledby="nd-titre"
  class="w-full max-w-[560px] rounded-card border border-line bg-surface p-0 text-ink backdrop:bg-overlay"
>
  <form data-nouvelle-demande-form enctype="multipart/form-data" class="grid gap-6 p-6x">
    <div class="flex items-start justify-between gap-4">
      <h2 id="nd-titre" class="text-lg font-semibold tracking-[-0.02em]">Nouvelle demande</h2>
      <button
        type="button"
        class="text-mute hover:text-ink"
        data-nouvelle-demande-fermer
        aria-label="Fermer"
      >
        ✕
      </button>
    </div>

    <p class="text-sm text-mute">
      Un message = un sujet. Trois sujets&nbsp;? Trois demandes séparées — on vous répondra plus
      vite.
    </p>

    <div class="grid gap-2">
      <label class="label field-label" for="nd-objet">
        Objet <span aria-hidden="true">*</span>
      </label>
      <input
        class="field"
        type="text"
        id="nd-objet"
        name="objet"
        maxlength="200"
        required
        placeholder="Ex. : le formulaire de contact ne part plus"
      />
    </div>

    <div class="grid gap-2">
      <label class="label field-label" for="nd-description">Description</label>
      <textarea
        class="field h-auto min-h-[140px] py-3"
        id="nd-description"
        name="description"
        maxlength="5000"
        placeholder="Ce qui se passe, sur quelle page, depuis quand… tout détail aide à répondre vite."
      ></textarea>
    </div>

    <div class="grid gap-2">
      <label class="label field-label" for="nd-urgence">Urgence</label>
      <select class="field" id="nd-urgence" name="urgence">
        <option value="">—</option>
        {URGENCES.map((u) => (
          <option value={u.value}>{u.label}</option>
        ))}
      </select>
    </div>

    <div class="grid gap-2">
      <label class="label field-label" for="nd-fichiers">Pièces jointes</label>
      <input
        class="field h-auto py-2"
        type="file"
        id="nd-fichiers"
        name="fichiers"
        multiple
        accept="image/*,.pdf,.zip"
      />
      <p class="text-[12px] text-mute">3 fichiers max, 10 Mo chacun.</p>
    </div>

    <div class="flex items-center gap-4">
      <button class="btn" type="submit">Envoyer la demande</button>
      <button class="btn btn-ghost" type="button" data-nouvelle-demande-fermer>Annuler</button>
    </div>

    <p data-nouvelle-demande-status role="status" hidden class="text-[13px] font-medium"></p>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-nouvelle-demande]");
  const ouvrir = document.querySelector<HTMLButtonElement>("[data-nouvelle-demande-ouvrir]");
  const form = document.querySelector<HTMLFormElement>("[data-nouvelle-demande-form]");

  if (dialog && ouvrir && form) {
    ouvrir.addEventListener("click", () => dialog.showModal());
    for (const btn of dialog.querySelectorAll<HTMLButtonElement>("[data-nouvelle-demande-fermer]")) {
      btn.addEventListener("click", () => dialog.close());
    }

    const status = form.querySelector<HTMLParagraphElement>("[data-nouvelle-demande-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const setStatus = (texte: string, tone: "text-mute" | "text-success" | "text-error") => {
      if (!status) return;
      status.hidden = false;
      status.textContent = texte;
      status.className = `text-[13px] font-medium ${tone}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitBtn) return;

      submitBtn.disabled = true;
      setStatus("Envoi en cours…", "text-mute");

      try {
        // Pas de header content-type manuel : multipart a besoin de la
        // boundary générée par le navigateur, qu'un header explicite écraserait.
        const res = await fetch("/api/messagerie/nouveau", {
          method: "POST",
          body: new FormData(form),
        });
        const body = (await res.json().catch(() => null)) as {
          ok?: boolean;
          ticketId?: string;
          error?: string;
        } | null;
        if (!res.ok || !body?.ok) throw new Error(body?.error ?? "");

        setStatus("Demande envoyée.", "text-success");
        // Recharge la page : le ticket tout juste créé apparaît dans le board.
        location.reload();
      } catch (err) {
        const message = err instanceof Error && err.message ? err.message : "";
        setStatus(
          message || "Envoi impossible, réessayez dans un instant ou écrivez-moi à ludo@coolbeans.cc.",
          "text-error",
        );
        submitBtn.disabled = false;
      }
    });
  }
</script>
