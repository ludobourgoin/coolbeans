---
/* Formulaire « Nouvelle demande », affiché directement en tête de la page
   Demandes (spec 2026-08-15-messagerie-portail-design.md §6, revu le
   2026-09-29 : plus de popup, un formulaire visible d'emblée).

   Un seul formulaire pour tout le monde. L'admin qui le remplit depuis
   l'espace d'un client écrit au nom de ce client, sans rien à cocher :
   l'endpoint choisit le contact principal de l'espace et n'envoie aucun mail
   (décision du 2026-09-29).

   Soumission multipart vers /api/messagerie/nouveau, inchangée : l'urgence et
   les pièces jointes gardent leurs `name`. Succès : rechargement, la demande
   apparaît dans la liste. */
import ChoixUrgence from "./ChoixUrgence.astro";
import PiecesJointes from "./PiecesJointes.astro";

---

<section class="grid gap-4" aria-labelledby="nd-titre" data-nouvelle-demande>
  <h2 id="nd-titre" class="text-lg font-semibold tracking-[-0.02em]">Nouvelle demande</h2>

  <form
    data-nouvelle-demande-form
    enctype="multipart/form-data"
    class="grid gap-6 rounded-card border border-line bg-surface p-6x"
  >
    <div class="grid gap-2">
      <label class="label field-label" for="nd-objet">
        Objet <span aria-hidden="true">*</span>
      </label>
      <input
        class="field"
        type="text"
        id="nd-objet"
        name="objet"
        maxlength="200"
        required
        placeholder="Ex. : le formulaire de contact ne part plus"
      />
    </div>

    <div class="grid gap-2">
      <label class="label field-label" for="nd-description">Description</label>
      <textarea
        class="field h-auto min-h-[140px] py-3"
        id="nd-description"
        name="description"
        maxlength="5000"
        placeholder="Ce qui se passe, sur quelle page, depuis quand… tout détail aide à répondre vite."
      ></textarea>
    </div>

    <div class="grid max-w-[320px] gap-2">
      <label class="label field-label" for="nd-urgence">Urgence</label>
      <ChoixUrgence id="nd-urgence" />
    </div>

    <div class="grid gap-2">
      <span class="label field-label">Pièces jointes</span>
      <PiecesJointes id="nd-fichiers" />
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button class="btn" type="submit">Envoyer la demande</button>
      <p data-nouvelle-demande-status role="status" hidden class="text-[13px] font-medium"></p>
    </div>
  </form>
</section>

<script>
  const racine = document.querySelector<HTMLElement>("[data-nouvelle-demande]");
  const form = racine?.querySelector<HTMLFormElement>("[data-nouvelle-demande-form]");

  if (racine && form) {
    const status = form.querySelector<HTMLParagraphElement>("[data-nouvelle-demande-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const setStatus = (texte: string, tone: "text-mute" | "text-success" | "text-error") => {
      if (!status) return;
      status.hidden = false;
      status.textContent = texte;
      status.className = `text-[13px] font-medium ${tone}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitBtn) return;

      submitBtn.disabled = true;
      setStatus("Envoi en cours…", "text-mute");

      try {
        // Pas de header content-type manuel : multipart a besoin de la
        // boundary générée par le navigateur, qu'un header explicite écraserait.
        const res = await fetch("/api/messagerie/nouveau", {
          method: "POST",
          body: new FormData(form),
        });
        const body = (await res.json().catch(() => null)) as {
          ok?: boolean;
          ticketId?: string;
          error?: string;
        } | null;
        if (!res.ok || !body?.ok) throw new Error(body?.error ?? "");

        setStatus("Demande envoyée.", "text-success");
        // Recharge la page : la demande tout juste créée apparaît dans la liste.
        location.reload();
      } catch (err) {
        const message = err instanceof Error && err.message ? err.message : "";
        setStatus(
          message || "Envoi impossible, réessayez dans un instant ou écrivez-moi à ludo@coolbeans.cc.",
          "text-error",
        );
        submitBtn.disabled = false;
      }
    });
  }
</script>
