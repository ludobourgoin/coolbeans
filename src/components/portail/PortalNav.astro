---
// Topbar du portail — refonte COO-80 (spec 2026-08-14-portail-sidebar-design.md).
//
// La navigation entre modules a quitté la topbar pour la sidebar, et le
// sélecteur de workspace l'y a suivie : il coiffe désormais la sidebar, au-
// dessus de la première section (retour Ludo 2026-08-18). Ici ne restent que
// la marque, la recherche ⌘K, le thème et le compte. Structure Geist stricte :
// la zone logo fait EXACTEMENT la largeur de la colonne sidebar (264px,
// --portal-col) avec une border-right continue — c'est ce qui aligne la topbar
// sur la grille en dessous.
//
// Hauteur figée à 56px (h-14) : doc.css cale dessus les colonnes collantes
// (`top: 56px`, `calc(100vh - 56px)`). La changer ici désaligne tout.
//
// Le menu compte insère « Messagerie » (ex-Support) entre « Gérer mon compte » et
// « Se déconnecter » (décision brainstorm 2026-08-14) via les custom menu
// items de @clerk/astro (UserButton.Action réordonne les items natifs).
import { UserButton } from "@clerk/astro/components";
import { portalHref } from "../../lib/portail/nav";
import SearchInput from "../ui/SearchInput.astro";
import Icon from "./Icon.astro";

interface Props {
  /** Le menu compte exige une session Clerk : la Bibliothèque passe false. */
  withAccount?: boolean;
  /** Prénom affiché dans la salutation. */
  prenom?: string;
}

const { withAccount = true, prenom = "" } = Astro.props;
const { hostname } = Astro.url;
const home = portalHref("/", hostname);
const support = portalHref("/messagerie", hostname);
---

<header class="sticky top-0 z-20 flex h-14 items-stretch border-b border-line bg-surface">
  {/* Zone marque : même largeur que la colonne sidebar, bordure continue. */}
  <div class="flex flex-none items-center px-4 md:px-6 lg:w-(--portal-col) lg:border-r lg:border-line">
    <a
      href={home}
      class="flex flex-none items-center gap-2 text-ink no-underline"
      aria-label="myCoolbeans — accueil"
    >
      {/* Lockup COO-14 : picto rond (blanc sur noir, inversé en sombre) puis
          « my » À GAUCHE du wordmark — le contraste Inter Tight regular vs
          wordmark bold fait la marque. Les fichiers -text-* sont recadrés sur
          les seules lettres (sans le picto {} embarqué), leur bas ≈ la
          baseline : le span reste en flux inline (pas flex) pour que la
          baseline du texte s'aligne d'elle-même dessus. Le corps de « my »
          (23px) reste un poil sous la x-height du wordmark en h-5. */}
      <img class="block size-7 dark:hidden" src="/img/coolbeans-mark-black.svg" alt="" width="28" height="28" />
      <img class="hidden size-7 dark:block" src="/img/coolbeans-mark-white.svg" alt="" width="28" height="28" />
      <span class="whitespace-nowrap leading-none">
        <span class="font-logo text-[23px] font-normal">my</span><img
          class="ml-0.5 inline-block h-5 w-auto align-baseline dark:hidden"
          src="/img/coolbeans-wordmark-text.svg"
          alt=""
          height="20"
        /><img
          class="ml-0.5 hidden h-5 w-auto align-baseline dark:inline-block"
          src="/img/coolbeans-wordmark-text-white.svg"
          alt=""
          height="20"
        />
      </span>
    </a>
  </div>

  <div class="flex min-w-0 flex-1 items-center gap-2 px-4 md:px-6">
    {/* Ouvre la sidebar en drawer sous 1024px (script dans PortalLayout). */}
    <button
      type="button"
      class="flex-none cursor-pointer rounded-control border border-line bg-surface p-2 text-ink lg:hidden"
      data-portal-menu
      aria-label="Ouvrir la navigation"
      aria-expanded="false"
    >
      <Icon name="menu" size={16} />
    </button>

    {/*
      La recherche ouvre la zone centrale, calée à gauche contre la bordure de
      la zone logo (retour Ludo 2026-08-17). Le champ est rendu partout ; le
      layout l'active quand un index de doc est présent, il reste inerte
      ailleurs.
    */}
    <div class="relative hidden w-80 flex-none lg:block">
      <SearchInput id="doc-q" placeholder="Rechercher dans la doc…" />
      <div id="doc-qres" hidden></div>
    </div>

    <div class="flex-1"></div>

    {/* Même bouton clair/sombre que le site (Nav.astro) : lune en clair,
        soleil en sombre. Seul le hook data-portal-theme diffère. */}
    <button
      class="btn btn-ghost btn-sm flex-none"
      data-portal-theme
      type="button"
      aria-label="basculer clair / sombre"
      title="basculer clair / sombre"
    >
      <svg
        class="dm-moon block h-4.5 w-4.5 dark:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
      >
      <svg
        class="dm-sun hidden h-4.5 w-4.5 dark:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="4.2"></circle><path
          d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"
        ></path></svg
      >
    </button>

    {
      withAccount && (
        <span class="flex flex-none items-center gap-2">
          {prenom && <span class="hidden text-sm text-mute md:inline">Hello, {prenom}</span>}
          <UserButton>
            <UserButton.MenuItems>
              <UserButton.Action label="manageAccount" />
              <UserButton.Link label="Messagerie" href={support}>
                <Icon slot="label-icon" name="help" size={14} />
              </UserButton.Link>
              <UserButton.Action label="signOut" />
            </UserButton.MenuItems>
          </UserButton>
        </span>
      )
    }
  </div>
</header>

<script>
  // Même clé localStorage que l'anti-flash de BaseLayout.
  document.querySelector("[data-portal-theme]")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  });
</script>
