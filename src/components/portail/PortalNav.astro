---
// Topbar du portail — refonte COO-80 (spec 2026-08-14-portail-sidebar-design.md).
//
// La navigation entre modules a quitté la topbar pour la sidebar, et le
// sélecteur de workspace l'y a suivie : il coiffe désormais la sidebar, au-
// dessus de la première section (retour Ludo 2026-08-18). Ici ne restent que
// la marque, la recherche ⌘K, le thème et le compte. Structure Geist stricte :
// la zone logo fait EXACTEMENT la largeur de la colonne sidebar (264px,
// --portal-col) avec une border-right continue — c'est ce qui aligne la topbar
// sur la grille en dessous.
//
// Hauteur figée à 56px (h-14) : doc.css cale dessus les colonnes collantes
// (`top: 56px`, `calc(100vh - 56px)`). La changer ici désaligne tout.
//
// Le menu compte garde l'ordre décidé au brainstorm 2026-08-14 — Messagerie
// puis Se déconnecter — mais il est désormais écrit à la main : le <UserButton />
// de Clerk est parti avec la bascule Better Auth. « Gérer mon compte », qui
// ouvrait une modale hébergée par Clerk, n'a pas d'équivalent et disparaît :
// mieux vaut pas d'entrée qu'une entrée morte.
import { portalHref } from "../../lib/portail/nav";
import SearchInput from "../ui/SearchInput.astro";
import ThemeSwitch from "../ui/ThemeSwitch.astro";
import Icon from "./Icon.astro";

interface Props {
  /** Le menu compte exige une session : la Bibliothèque passe false. */
  withAccount?: boolean;
  /** Prénom affiché dans la salutation. */
  prenom?: string;
  /** Adresse du compte connecté, rappelée en tête du menu. */
  email?: string;
}

const { withAccount = true, prenom = "", email = "" } = Astro.props;
/* Initiale de la pastille. Repli sur l'adresse quand le compte n'a pas de nom,
   puis sur « ? » : la pastille ne doit jamais se rendre vide, elle est la
   seule cible cliquable du menu. */
const initiale = (prenom || email || "?").trim().charAt(0).toUpperCase();
const { hostname } = Astro.url;
const home = portalHref("/", hostname);
const support = portalHref("/messagerie", hostname);
---

<header class="sticky top-0 z-20 flex h-14 items-stretch border-b border-line bg-surface">
  {/* Zone marque : même largeur que la colonne sidebar, bordure continue. */}
  <div class="flex flex-none items-center px-4 md:px-6 lg:w-(--portal-col) lg:border-r lg:border-line">
    <a
      href={home}
      class="flex flex-none items-center gap-2 text-ink no-underline"
      aria-label="myCoolbeans — accueil"
    >
      {/* Lockup COO-14 : picto rond (blanc sur noir, inversé en sombre) puis
          « my » À GAUCHE du wordmark — le contraste Inter Tight regular vs
          wordmark bold fait la marque. Les fichiers -text-* sont recadrés sur
          les seules lettres (sans le picto {} embarqué), leur bas ≈ la
          baseline : le span reste en flux inline (pas flex) pour que la
          baseline du texte s'aligne d'elle-même dessus. Le corps de « my »
          (23px) reste un poil sous la x-height du wordmark en h-5. */}
      <img class="block size-7 dark:hidden" src="/img/coolbeans-mark-black.svg" alt="" width="28" height="28" />
      <img class="hidden size-7 dark:block" src="/img/coolbeans-mark-white.svg" alt="" width="28" height="28" />
      <span class="whitespace-nowrap leading-none">
        <span class="font-logo text-[23px] font-normal">my</span><img
          class="ml-0.5 inline-block h-5 w-auto align-baseline dark:hidden"
          src="/img/coolbeans-wordmark-text.svg"
          alt=""
          height="20"
        /><img
          class="ml-0.5 hidden h-5 w-auto align-baseline dark:inline-block"
          src="/img/coolbeans-wordmark-text-white.svg"
          alt=""
          height="20"
        />
      </span>
    </a>
  </div>

  <div class="flex min-w-0 flex-1 items-center gap-2 px-4 md:px-6">
    {/* Ouvre la sidebar en drawer sous 1024px (script dans PortalLayout). */}
    <button
      type="button"
      class="flex-none cursor-pointer rounded-control border border-line bg-surface p-2 text-ink lg:hidden"
      data-portal-menu
      aria-label="Ouvrir la navigation"
      aria-expanded="false"
    >
      <Icon name="menu" size={16} />
    </button>

    {/*
      La recherche ouvre la zone centrale, calée à gauche contre la bordure de
      la zone logo (retour Ludo 2026-08-17). Le champ est rendu partout ; le
      layout l'active quand un index de doc est présent, il reste inerte
      ailleurs.
    */}
    <div class="relative hidden w-80 flex-none lg:block">
      <SearchInput id="doc-q" placeholder="Rechercher dans la doc…" />
      <div id="doc-qres" hidden></div>
    </div>

    <div class="flex-1"></div>

    {/* Exactement le même contrôle que le site vitrine : c'est le même
        composant, plus une copie du markup. */}
    <ThemeSwitch class="flex-none" />

    {
      withAccount && (
        <span class="flex flex-none items-center gap-2">
          {prenom && <span class="hidden text-sm text-mute md:inline">Hello, {prenom}</span>}
          {/* <details> plutôt qu'un bouton + état JS : l'ouverture/fermeture
              est native, donc le menu marche même si le script ci-dessous ne
              s'exécute pas — il n'ajoute que la fermeture au clic extérieur. */}
          <details class="relative" data-portal-compte>
            <summary
              class="flex size-8 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-surface text-[13px] font-bold text-ink select-none"
              aria-label="Menu du compte"
            >
              {initiale}
            </summary>
            <div
              class="absolute right-0 z-30 mt-2 w-60 rounded-control border border-line bg-surface p-1 shadow-lg"
              role="menu"
            >
              <p class="truncate px-3 py-2 text-[13px] text-mute" title={email}>
                {email || "Compte connecté"}
              </p>
              <div class="my-1 border-t border-line" />
              <a
                class="flex items-center gap-2 rounded-control px-3 py-2 text-[13px] text-mute no-underline hover:text-ink hover:underline"
                href={support}
                role="menuitem"
              >
                <Icon name="help" size={14} />
                Messagerie
              </a>
              {/* Un POST de formulaire natif serait plus robuste, mais
                  /api/auth/sign-out refuse le form-urlencoded (415, il n'accepte
                  que du JSON) : la déconnexion passe donc par fetch. Vérifié
                  contre le serveur, pas supposé. */}
              <button
                type="button"
                data-portal-deconnexion
                class="flex w-full cursor-pointer items-center gap-2 rounded-control px-3 py-2 text-left text-[13px] text-mute hover:text-ink hover:underline"
                role="menuitem"
              >
                <Icon name="lock" size={14} />
                Se déconnecter
              </button>
            </div>
          </details>
        </span>
      )
    }
  </div>
</header>

<script>
  // Déconnexion. Rechargement complet ensuite : toutes les pages du portail
  // sont rendues côté serveur, et le middleware doit revoir l'absence de
  // cookie. En cas d'échec réseau, on envoie quand même sur /connexion — la
  // session peut être morte côté serveur, laisser l'utilisateur sur une page
  // qu'il croit connectée serait pire.
  document
    .querySelector<HTMLButtonElement>("[data-portal-deconnexion]")
    ?.addEventListener("click", async (e) => {
      const bouton = e.currentTarget as HTMLButtonElement;
      bouton.disabled = true;
      try {
        await fetch("/api/auth/sign-out", {
          method: "POST",
          headers: { "content-type": "application/json" },
          credentials: "same-origin",
          body: "{}",
        });
      } finally {
        window.location.assign("/connexion");
      }
    });

  // Fermeture du menu compte au clic extérieur et à Échap : <details> ne le
  // fait pas tout seul, et un menu qui reste ouvert derrière la page suivante
  // donne l'impression que le clic n'a pas pris.
  const compte = document.querySelector<HTMLDetailsElement>("[data-portal-compte]");
  if (compte) {
    document.addEventListener("click", (e) => {
      if (compte.open && !compte.contains(e.target as Node)) compte.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && compte.open) compte.open = false;
    });
  }

  // La bascule de thème vit dans ThemeSwitch.astro, qui porte son propre
  // écouteur délégué et la même clé localStorage que l'anti-flash de
  // BaseLayout. Ne rien remettre ici.
</script>
