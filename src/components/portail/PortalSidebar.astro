---
// Sidebar gauche du portail — l'unique nav depuis la refonte COO-80
// (spec 2026-08-14-portail-sidebar-design.md).
//
// Titres de section : bold, non cliquables, icône Iconoir à gauche. Liens :
// text-mute, hover souligné sobre, page active en text-ink medium (sans fond,
// sans souligné permanent). Les entrées `wip` n'arrivent ici que pour un
// admin (le registre filtre côté client) : le badge peut donc s'afficher sans
// re-tester le rôle.
//
// La géométrie (264px, collante sous la topbar de 56px, border-right) vient
// de `.portal-left` dans doc.css — c'est elle qui aligne la colonne sur la
// zone logo de la topbar.
//
// Le sélecteur de workspace coiffe la colonne (retour Ludo 2026-08-18, il
// était en topbar) : il est au-dessus de la première section, pleine largeur
// utile de la colonne, séparé d'elle par le même 24px que l'inter-sections.
// Il n'est rendu que si on lui donne des workspaces — le layout ne les charge
// que pour un admin, aucune décision de droits ici.
import { isActive, type SidebarSection } from "../../lib/portail/nav";
import WorkspaceSwitcher from "./WorkspaceSwitcher.astro";
import Icon from "./Icon.astro";
import type { PortalWorkspace } from "../../lib/portail/workspaces";

interface Props {
  sections: SidebarSection[];
  /** Statut UptimeRobot du client courant — pas encore branché (COO-15). */
  uptimeStatus?: "up" | "degraded" | "down" | null;
  /** Workspaces proposés au sélecteur. Vide (défaut) = pas de sélecteur. */
  workspaces?: PortalWorkspace[];
  /** Workspace affiché, présélectionné dans le sélecteur. */
  current?: PortalWorkspace | null;
}

const { sections, uptimeStatus = null, workspaces = [], current = null } = Astro.props;
const { pathname } = Astro.url;

const DOT_CLASS: Record<string, string> = {
  up: "bg-success",
  degraded: "bg-warning",
  down: "bg-error",
};
const dotClass = (uptimeStatus && DOT_CLASS[uptimeStatus]) || "bg-line-strong";
---

<aside class="portal-left" aria-label="Navigation du portail">
  {
    workspaces.length > 0 && (
      <div class="mb-6x">
        <WorkspaceSwitcher clients={workspaces} current={current} />
      </div>
    )
  }

  <nav class="flex flex-col gap-6x">
    {
      sections.map((section) => (
        <div>
          <div class="flex items-center gap-2 px-2.5 text-sm font-bold tracking-[-0.01em] text-ink">
            <Icon name={section.icon} size={16} class="flex-none text-ink" />
            {section.label}
          </div>
          <ul class="mt-1.5 flex list-none flex-col p-0">
            {section.pages.map((page) => {
              const on = isActive(page, pathname);
              return (
                <li>
                  <a
                    href={page.href}
                    aria-current={on ? "page" : undefined}
                    class:list={[
                      "flex items-center gap-2 py-1.25 pl-8.5 pr-2 text-sm no-underline underline-offset-4",
                      on
                        ? "font-medium text-ink"
                        : "text-mute hover:text-ink hover:underline",
                    ]}
                  >
                    {page.label}
                    {page.dot && (
                      <span
                        class:list={["size-1.75 flex-none rounded-full", dotClass]}
                        aria-hidden="true"
                      />
                    )}
                    {page.wip && (
                      <span class="rounded-full border border-line px-1.5 font-mono text-[9px] uppercase tracking-[0.06em] text-mute">
                        wip
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
