---
/* Vidéo de présentation du livrable. Deux formes selon ce que l'outil de
   capture fournit :

   - `embed` : une URL de lecteur intégrable (iframe), affichée en 16/9 dans
     le corps du document ;
   - sinon `url` seule : une carte qui ouvre la vidéo dans un nouvel onglet.
     CleanShot Cloud, par exemple, donne un lien de partage mais pas de
     lecteur intégrable garanti.

   Placée sous l'en-tête, avant les sections : c'est le raccourci vers tout ce
   que la page détaille ensuite, et un client pressé s'arrête là. */
interface Props {
  url: string;
  embed?: string;
  duree?: string;
  legende?: string;
}
const { url, embed, duree, legende } = Astro.props;
---

<div class="grid grid-cols-[180px_1fr] gap-10 py-10 max-[700px]:grid-cols-1 max-[700px]:gap-4">
  <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">En vidéo</p>
  <div>
    {
      embed ? (
        <div class="max-w-full overflow-hidden rounded-lg border border-line">
          <div class="relative aspect-video">
            <iframe
              class="absolute inset-0 size-full"
              src={embed}
              title={legende ?? "Vidéo de présentation"}
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            />
          </div>
        </div>
      ) : (
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class="card flex items-center gap-5 no-underline transition-colors duration-150 hover:border-[var(--ds-gray-500)]"
        >
          <span
            aria-hidden="true"
            class="flex size-12 flex-none items-center justify-center rounded-full bg-ink text-surface"
          >
            <svg width="14" height="16" viewBox="0 0 14 16" fill="currentColor">
              <path d="M1 1.5v13l12-6.5z" />
            </svg>
          </span>
          <span>
            <span class="block font-semibold text-ink">
              Voir la présentation en vidéo{duree && ` (${duree})`}
            </span>
            {legende && <span class="mt-0.5 block text-[13px] text-mute">{legende}</span>}
          </span>
        </a>
      )
    }
    {embed && legende && <p class="mt-3 text-[13px] text-mute">{legende}</p>}
  </div>
</div>
