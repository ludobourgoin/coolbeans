---
/* Le parcours page par page : chaque entrée ouvre la page livrée dans un
   nouvel onglet et dit en une ligne ce qu'on y regarde. C'est la table des
   matières du site, pas un résumé de plus.

   La même liste sert aux relevés de liens externes : `groupe` la coupe en
   sous-ensembles (une édition, une catégorie), `favicon` pose la vignette du
   site pour le reconnaître sans lire l'URL, `statut` affiche l'état quand la
   liste se lit comme une checklist. Les trois restent optionnels, un parcours
   classique ne les déclare pas. */
import { riche, ancreSection } from "../../lib/devis";

interface Etape {
  page: string;
  url: string;
  texte?: string;
  groupe?: string;
  favicon?: string;
  statut?: "a-jour" | "a-corriger" | "hors-ligne";
}

interface Props {
  titre: string;
  etapes: Etape[];
  /* Replie chaque groupe derrière un dépliant. Opt-in, parce que tous les
     parcours ne s'y prêtent pas : un relevé de liens à corriger se lit comme
     une checklist et doit rester ouvert, tandis qu'une table des matières de
     site livré gagne à se refermer.

     Le `<details>` porte un groupe NOMMÉ. Tooltip s'affiche via `group-hover:`,
     que Tailwind compile en `.group:hover &` : ce sélecteur remonte à tout
     ancêtre portant `.group`, pas au plus proche. Un groupe anonyme ouvrirait
     toutes les infobulles contenues dès le survol. */
  replie?: boolean;
}
const { titre, etapes, replie = false } = Astro.props;

const STATUT: Record<NonNullable<Etape["statut"]>, { texte: string; couleur: string }> = {
  "a-jour": { texte: "À jour", couleur: "var(--success)" },
  "a-corriger": { texte: "À corriger", couleur: "var(--warning)" },
  "hors-ligne": { texte: "Hors ligne", couleur: "var(--error)" },
};

/* Les groupes se suivent dans l'ordre du YAML : pas de tri, l'ordre d'écriture
   est un choix éditorial. Les entrées sans groupe forment un premier bloc sans
   titre, ce qui laisse le parcours classique inchangé. */
const blocs: { nom?: string; etapes: Etape[] }[] = [];
for (const etape of etapes) {
  const dernier = blocs.at(-1);
  if (dernier && dernier.nom === etape.groupe) dernier.etapes.push(etape);
  else blocs.push({ nom: etape.groupe, etapes: [etape] });
}

/* Faute de favicon récupérable, l'initiale du nom de domaine tient le même
   rôle d'ancre visuelle et garde l'alignement de la colonne. */
const initiale = (url: string) => {
  try {
    return new URL(url).hostname
      .replace(/^www\./, "")
      .charAt(0)
      .toUpperCase();
  } catch {
    return "·";
  }
};
---

<section
  id={ancreSection(titre)}
  class="grid scroll-mt-16.5 grid-cols-[180px_1fr] gap-10 border-t border-line py-10 max-[700px]:grid-cols-1 max-[700px]:gap-4"
>
  <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">{titre}</p>
  <div class:list={["flex flex-col", replie ? "gap-0" : "gap-8"]}>
    {
      blocs.map((bloc) => {
        const liste = (
          <ol class="flex list-none flex-col divide-y divide-line">
            {bloc.etapes.map((etape) => (
              <li class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[240px_1fr] sm:gap-6">
                <div class="flex items-start gap-2.5 self-start">
                  {etape.favicon ? (
                    <img
                      src={etape.favicon}
                      alt=""
                      width="20"
                      height="20"
                      loading="lazy"
                      class="mt-0.5 size-5 shrink-0 rounded-[4px] object-contain"
                    />
                  ) : (
                    <span
                      aria-hidden="true"
                      class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-[4px] bg-surface-subtle font-mono text-[11px] font-bold text-mute"
                    >
                      {initiale(etape.url)}
                    </span>
                  )}
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <a class="link font-semibold" href={etape.url} target="_blank" rel="noopener">
                      {etape.page}
                    </a>
                    {etape.statut && (
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-line px-2 py-0.5 font-mono text-[11px] tracking-wide text-mute uppercase">
                        <span
                          class="size-1.5 rounded-full"
                          style={`background:${STATUT[etape.statut].couleur}`}
                        />
                        {STATUT[etape.statut].texte}
                      </span>
                    )}
                  </div>
                </div>
                {etape.texte && (
                  <p class="max-w-[58ch] leading-[1.6] text-mute" set:html={riche(etape.texte)} />
                )}
              </li>
            ))}
          </ol>
        );

        if (!bloc.nom) return <div>{liste}</div>;

        if (replie)
          return (
            <details class="group/parcours border-t border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-[17px] font-semibold text-ink [&::-webkit-details-marker]:hidden">
                <span>
                  {bloc.nom}
                  <span class="ml-2 text-[15px] font-normal text-mute">{bloc.etapes.length}</span>
                </span>
                <span
                  class="font-mono text-[15px] font-normal text-mute after:content-['+'] group-open/parcours:after:content-['−']"
                  aria-hidden="true"
                />
              </summary>
              <div class="pb-5">{liste}</div>
            </details>
          );

        return (
          <div>
            <p class="mb-3 text-[17px] font-semibold text-ink">
              {bloc.nom}
              <span class="ml-2 text-[15px] font-normal text-mute">{bloc.etapes.length}</span>
            </p>
            {liste}
          </div>
        );
      })
    }
  </div>
</section>
