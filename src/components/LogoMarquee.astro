---
import type { Logo } from "../data/logos";

interface Props {
  logos: Logo[];
  /** sens inverse (ligne 1, pour croiser la ligne 2) */
  reverse?: boolean;
}

const { logos, reverse = false } = Astro.props;
// dupliqué pour une boucle sans couture (translateX -50%)
const loop = [...logos, ...logos];
---

<div
  class="overflow-hidden"
  style="-webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);"
  aria-hidden="true"
>
  <ul
    class:list={[
      "marquee-track flex w-max list-none items-center gap-15 px-7.5 py-0 whitespace-nowrap motion-reduce:w-full motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:whitespace-normal",
      reverse && "[animation-direction:reverse] [animation-duration:66s]",
    ]}
  >
    {
      loop.map((l) => (
        <li class="inline-flex flex-none items-center gap-2.75">
          {/* `mono` et pas `invert` : Tailwind expose une utilitaire `.invert` globale
              qui s'appliquerait aussi en clair et blanchirait le picto. */}
          <img
            src={l.src}
            alt=""
            loading="lazy"
            class:list={[
              "block h-7.5 w-7.5 object-contain",
              l.mono && "dark:brightness-0 dark:invert",
            ]}
          />
          <span class="font-display text-[22px] font-bold tracking-[-0.02em] text-ink lowercase">
            {l.name}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .marquee-track {
    animation: marquee-scroll 58s linear infinite;
  }
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
