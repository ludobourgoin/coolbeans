---
import { flowBoxes } from "../data/flow";

const deliverables = [
  { label: "landing pages", svg: '<rect x="5" y="3" width="14" height="18"/><line x1="5" y1="8" x2="19" y2="8"/>' },
  { label: "e-commerce", svg: '<path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>' },
  { label: "applications web", svg: '<rect x="3" y="5" width="18" height="14"/><line x1="3" y1="9.5" x2="21" y2="9.5"/>' },
  { label: "animations & interactions", svg: '<path d="M2 12c2.5-6 4.5-6 7 0s4.5 6 7 0 4.5-6 6-3"/>' },
  { label: "intégration figma → code", svg: '<polyline points="8 7 3 12 8 17"/><polyline points="16 7 21 12 16 17"/>' },
  { label: "automatisations", svg: '<path d="M13 2 4 14h7l-1 8 10-13h-7l1-7z"/>' },
  { label: "refonte web", svg: '<polyline points="20 5 20 10 15 10"/><path d="M19 13a7 7 0 1 1-2-7l3 2"/>' },
  { label: "blogs & médias", svg: '<rect x="4" y="4" width="16" height="16"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>' },
];
---

<figure class="flow-wrap" aria-label="le flux coolbeans : de la boîte à outils aux livrables">
  <div class="flow-canvas" id="flow-canvas">
    <svg class="wires" viewBox="0 0 1280 440" aria-hidden="true">
      <path d="M424 77 C 505 77, 545 216, 596 216"></path>
      <path d="M516 173 C 560 173, 570 216, 596 216"></path>
      <path d="M452 267 C 538 267, 556 216, 596 216"></path>
      <path d="M425 362 C 510 362, 550 216, 596 216"></path>
      <path class="live" d="M684 216 C 756 216, 788 126, 836 126"></path>
      <path class="live" d="M684 216 C 756 216, 788 178, 836 178"></path>
      <path class="live" d="M684 216 C 756 216, 788 230, 836 230"></path>
      <path class="live" d="M684 216 C 756 216, 788 282, 836 282"></path>
      <circle class="tok" r="4"><animateMotion dur="2.4s" repeatCount="indefinite" path="M424 77 C 505 77, 545 216, 596 216"></animateMotion></circle>
      <circle class="tok" r="4"><animateMotion dur="2.4s" begin="-0.6s" repeatCount="indefinite" path="M516 173 C 560 173, 570 216, 596 216"></animateMotion></circle>
      <circle class="tok" r="4"><animateMotion dur="2.4s" begin="-1.2s" repeatCount="indefinite" path="M452 267 C 538 267, 556 216, 596 216"></animateMotion></circle>
      <circle class="tok" r="4"><animateMotion dur="2.4s" begin="-1.8s" repeatCount="indefinite" path="M425 362 C 510 362, 550 216, 596 216"></animateMotion></circle>
    </svg>

    {
      flowBoxes.map((box) => (
        <div class:list={["fbox", { float: box.float }]} style={`left:${box.left}px;top:${box.top}px`} aria-hidden="true">
          <div class="bl">{box.title}</div>
          <div class="row">
            {box.icons.map((ic) => (
              <span class="ic" data-tip={ic.tip}>
                <img src={ic.src} alt="" loading="lazy" />
              </span>
            ))}
          </div>
        </div>
      ))
    }

    <div class="fcore">
      <div class="mark">
        <img class="m-light" src="/img/coolbeans-mark-black.svg" alt="coolbeans" />
        <img class="m-dark" src="/img/coolbeans-mark-white.svg" alt="coolbeans" />
      </div>
      <div class="read">
        <p class="read-punch">vous briefez.<br />je fais le reste.</p>
        <p class="read-sub">design · dev · maintenance</p>
      </div>
    </div>

    <div class="fdeliv" aria-hidden="true">
      {
        deliverables.map((d) => (
          <div class="fpill">
            <svg viewBox="0 0 24 24" set:html={d.svg} />
            <span>{d.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</figure>

<style>
  .flow-wrap {
    flex: 0 0 auto;
    align-self: center;
    position: relative;
    width: min(calc(100% - 2 * var(--gutter)), var(--container));
    margin: 0 auto;
    overflow: visible;
    height: 440px;
  }
  .flow-canvas {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 440px;
    transform-origin: top left;
  }

  /* connecteurs */
  .wires {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 440px;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }
  .wires path {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 1.5;
  }
  .wires path.live {
    stroke: var(--ink);
    stroke-dasharray: 5 8;
    animation: wire-flow 1.05s linear infinite;
  }
  .wires circle.tok {
    fill: var(--ink);
  }
  @keyframes wire-flow {
    to {
      stroke-dashoffset: -26;
    }
  }

  /* boîtes catégories */
  .fbox {
    position: absolute;
    z-index: 2;
    background: var(--surface);
    border: 1.5px solid var(--ink);
  }
  .fbox .bl {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--ink);
    padding: 6px 9px;
    border-bottom: 1.5px solid var(--ink);
    white-space: nowrap;
  }
  .fbox .row {
    display: flex;
  }
  .fbox .ic {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-right: 1.5px solid var(--ink);
    position: relative;
  }
  .fbox .ic:last-child {
    border-right: none;
  }
  .fbox .ic img {
    width: 50%;
    height: 50%;
    object-fit: contain;
    display: block;
  }
  .fbox.float {
    border-style: dashed;
  }
  .fbox.float .bl {
    border-bottom-style: dashed;
  }
  .fbox.float .ic:not(:last-child) {
    border-right-style: dashed;
  }
  /* dark : les boîtes restent claires (logos lisibles), comme le wireframe */
  :global(.dark) .fbox {
    background: #f1efe9;
    border-color: #141414;
  }
  :global(.dark) .fbox .bl {
    color: #141414;
    border-bottom-color: #141414;
  }
  :global(.dark) .fbox .ic {
    border-right-color: #141414;
  }
  /* tooltip */
  .fbox .ic[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 9px);
    left: 50%;
    transform: translateX(-50%) translateY(-3px);
    background: var(--ink);
    color: var(--surface);
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    padding: 6px 11px;
    border-radius: 8px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
    z-index: 120;
  }
  .fbox .ic[data-tip]:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .fbox:hover {
    z-index: 90;
  }

  /* cœur */
  .fcore {
    position: absolute;
    left: 560px;
    top: 170px;
    width: 160px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .fcore .mark {
    width: 92px;
    height: 92px;
    position: relative;
    display: grid;
    place-items: center;
  }
  .fcore .mark::before {
    content: "";
    position: absolute;
    inset: -34%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--ink) 13%, transparent) 0%, transparent 70%);
    animation: core-pulse 3.4s var(--ease) infinite;
  }
  .fcore .mark img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .fcore .mark img.m-dark {
    display: none;
  }
  :global(.dark) .fcore .mark img.m-light {
    display: none;
  }
  :global(.dark) .fcore .mark img.m-dark {
    display: block;
  }
  .fcore .read {
    width: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    text-align: center;
  }
  .fcore .read-punch {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-transform: lowercase;
    color: var(--ink);
    margin: 0;
  }
  .fcore .read-sub {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 0;
  }
  @keyframes core-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.6;
    }
    50% {
      transform: scale(1.14);
      opacity: 1;
    }
  }

  /* livrables */
  .fdeliv {
    position: absolute;
    left: 840px;
    top: 104px;
    width: 436px;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 10px;
  }
  .fpill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 0 14px;
    height: 44px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    line-height: 1.1;
    white-space: nowrap;
  }
  :global(.dark) .fpill {
    background: #16140e;
  }
  .fpill svg {
    width: 17px;
    height: 17px;
    flex: none;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .wires path.live {
      animation: none;
    }
    .fcore .mark::before {
      animation: none;
    }
    .wires circle.tok {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const wrap = document.querySelector(".flow-wrap");
    const canvas = document.getElementById("flow-canvas");
    if (!wrap || !canvas) return;
    function fit() {
      const w = wrap.clientWidth;
      const s = Math.min(1, w / 1280);
      canvas.style.transform = "scale(" + s + ")";
      canvas.style.left = Math.max(0, (w - 1280 * s) / 2) + "px";
      wrap.style.height = 440 * s + "px";
    }
    if (window.ResizeObserver) new ResizeObserver(fit).observe(wrap);
    window.addEventListener("resize", fit);
    window.addEventListener("load", fit);
    fit();
  })();
</script>
