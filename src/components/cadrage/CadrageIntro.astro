---
/* Sections d'introduction du document de cadrage.

   Reprend au caractère près la grille de DevisCorps (bloc 880, colonne de
   libellés 180, gouttière 40, filet entre sections) : les deux documents
   doivent se lire comme deux membres de la même famille, et un lead qui a
   déjà reçu une proposition retrouve la même page.

   Ce qui n'est PAS repris, volontairement : la nav de sections collante. Elle
   n'aurait listé que l'intro, en ignorant le comparatif et le questionnaire
   qui sont l'essentiel de la page. Une nav qui ne mène qu'à un tiers du
   document désoriente au lieu d'orienter.

   Ni budget ni planning ici : un cadrage ne chiffre pas et n'engage pas de
   date. C'est le comparatif qui porte les ordres de grandeur, en les disant
   indicatifs. */
import Tooltip from "../ui/Tooltip.astro";
import { riche, listeItem, ancreSection } from "../../lib/devis";

interface Section {
  titre: string;
  texte?: string;
  liste?: (string | { texte: string; tooltip?: string })[];
  note?: string;
  video?: { id: string; titre?: string };
  /* Replie la liste derrière un dépliant, dont le libellé est cette chaîne.
     Opt-in : sans elle, la liste s'affiche comme avant, et les documents de
     cadrage ne changent pas d'un pixel.

     Le libellé porte le décompte (« Voir les quinze points »), parce qu'un
     dépliant anonyme ne dit pas ce qu'il cache et ne se clique donc pas. Le
     `texte` de la section reste visible au-dessus : c'est lui qui résume, le
     dépliant ne porte que la pièce justificative.

     Le `<details>` porte un groupe NOMMÉ, `group/replie`, et surtout pas
     `group` tout court. Tooltip s'affiche via `group-hover:`, que Tailwind
     compile en `.group:hover &` : ce sélecteur remonte à n'importe quel
     ancêtre portant `.group`, pas au plus proche. Un groupe anonyme ici
     ouvrait donc toutes les infobulles du dépliant dès qu'on survolait
     n'importe quel point de la section. Constaté sur le livrable Fylgo le
     2026-09-21. */
  replie?: string;
}

interface Props {
  sections: Section[];
}
const { sections } = Astro.props;
---

{
  sections.map((section, index) => {
    const puces = section.liste && (
      <ul class:list={["flex list-none flex-col gap-3", section.replie && "pt-1 pb-5"]}>
        {section.liste.map((brut) => {
          const item = listeItem(brut);
          return (
            <li class="flex items-start gap-3.5">
              <span class="mt-[0.55em] block size-1.5 flex-none bg-ink" aria-hidden="true" />
              <span class="max-w-[58ch]">
                <Fragment set:html={riche(item.texte)} />
                {item.tooltip && <Tooltip texte={item.tooltip} />}
              </span>
            </li>
          );
        })}
      </ul>
    );

    return (
    <section
      id={ancreSection(section.titre)}
      class:list={[
        "grid scroll-mt-16.5 grid-cols-[180px_1fr] gap-10 py-10 max-[700px]:grid-cols-1 max-[700px]:gap-4",
        index > 0 && "border-t border-line",
      ]}
    >
      <p class="pt-1 font-mono text-[15px] font-extrabold tracking-wide text-ink uppercase">
        {section.titre}
      </p>
      <div>
        {section.texte && (
          <p
            class:list={["max-w-[58ch] leading-[1.6]", section.liste && "mb-5"]}
            set:html={riche(section.texte)}
          />
        )}

        {section.liste &&
          (section.replie ? (
            <details class="group/replie max-w-[58ch] border-t border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-[15px] font-medium text-ink [&::-webkit-details-marker]:hidden">
                {section.replie}
                <span
                  class="font-mono text-mute after:content-['+'] group-open/replie:after:content-['−']"
                  aria-hidden="true"
                />
              </summary>
              {puces}
            </details>
          ) : (
            puces
          ))}

        {section.video && (
          <div class="mt-6 max-w-full overflow-hidden rounded-lg border border-line">
            <div class="relative aspect-video">
              <iframe
                class="absolute inset-0 size-full"
                src={`https://www.youtube-nocookie.com/embed/${section.video.id}`}
                title={section.video.titre ?? "Vidéo YouTube"}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          </div>
        )}

        {section.note && (
          <p
            class="mt-6 max-w-[58ch] text-[14px] leading-[1.6] text-mute"
            set:html={riche(section.note)}
          />
        )}
      </div>
    </section>
    );
  })
}
