---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// ordre du wireframe ; pages non construites → # pour l'instant
// masqué temporairement (urgence post-mise en prod) : Projets, Services, Blog, Ressources
const links = [
  { href: "/tools", label: "Boîte à outils" },
  { href: "/about", label: "À propos" },
];
const isActive = (href: string) => href !== "#" && path.startsWith(href);
---

<header
  id="site-nav"
  class="at-top sticky top-0 z-50 bg-surface shadow-[inset_0_-1px_0_var(--line),0_1px_16px_rgba(0,0,0,0.06)] transition-[background-color,box-shadow] duration-250 ease-brand [&.at-top]:bg-transparent [&.at-top]:shadow-none"
>
  <div
    class="container-site grid grid-cols-[minmax(max-content,1fr)_auto_minmax(max-content,1fr)] items-center gap-8 py-4 max-[980px]:grid-cols-[1fr_auto]"
  >
    <a class="inline-flex items-center leading-0" href="/" aria-label="coolbeans — accueil">
      <img
        class="block h-5.25 w-auto dark:hidden"
        src="/img/coolbeans-wordmark.svg"
        alt="coolbeans"
        height="21"
      />
      <img
        class="hidden h-5.25 w-auto dark:block"
        src="/img/coolbeans-wordmark-white.svg"
        alt="coolbeans"
        height="21"
      />
    </a>

    <nav
      class="flex flex-nowrap items-center justify-center gap-1 whitespace-nowrap max-[980px]:hidden"
      aria-label="navigation principale"
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "rounded-full px-3.5 py-2 text-sm leading-none font-medium text-mute transition-colors duration-150 ease-in-out hover:text-ink",
              { "font-semibold text-ink": isActive(l.href) },
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3.5 justify-self-end">
      <button
        id="theme-toggle"
        class="btn btn-ghost btn-sm"
        type="button"
        aria-label="basculer clair / sombre"
        title="basculer clair / sombre"
      >
        <svg
          class="dm-moon block h-4.5 w-4.5 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
        >
        <svg
          class="dm-sun hidden h-4.5 w-4.5 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4.2"></circle><path
            d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"
          ></path></svg
        >
      </button>
      <a class="btn btn-sm" href="/contact">Contact</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch (e) {}
    });

    const nav = document.getElementById("site-nav");
    if (nav) {
      let ticking = false;
      const update = () => {
        nav.classList.toggle("at-top", window.scrollY <= 4);
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        },
        { passive: true },
      );
      update();
    }

    const drop = document.querySelector(".drop");
    const trigger = document.getElementById("aud-trigger");
    if (drop && trigger) {
      const setOpen = (open) => {
        drop.setAttribute("data-open", String(open));
        trigger.setAttribute("aria-expanded", String(open));
      };
      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(drop.getAttribute("data-open") !== "true");
      });
      document.addEventListener("click", (e) => {
        if (!drop.contains(e.target)) setOpen(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    }
  })();
</script>
