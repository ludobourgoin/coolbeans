---
/* Marqueur ⓘ + bulle au survol/focus. Sert à alléger le devis : l'explication
   sort du fil principal sans disparaître. Texte brut uniquement.

   Le marqueur est un pastillage plein (fond + bordure soutenue) et non un
   cercle filaire : à 16 px, une bordure --line seule disparaît sur fond blanc.
   Alignement `align-middle` et non `align-baseline` : un disque calé sur la
   ligne de base déborde sous le texte et paraît tomber. */
interface Props { texte: string }
const { texte } = Astro.props;
---
<span class="group relative inline-block align-middle">
  <button
    type="button"
    aria-label={`Détail : ${texte}`}
    class="ml-1 inline-flex size-4 items-center justify-center rounded-full border border-line-strong bg-surface-raise font-mono text-[10px] leading-none font-bold text-mute transition-colors duration-150 hover:border-ink hover:bg-ink hover:text-surface focus-visible:border-ink focus-visible:bg-ink focus-visible:text-surface"
  >i</button>
  <span
    role="tooltip"
    class="pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-max max-w-[38ch] -translate-x-1/2 rounded-card border border-line-strong bg-surface px-3 py-2 text-[13px] leading-snug text-ink opacity-0 shadow-md transition-opacity duration-150 group-focus-within:opacity-100 group-hover:opacity-100"
  >{texte}</span>
</span>
